{
  "formatVersion": 1,
  "name": "kryon",
  "displayName": "Kryon",
  "description": "Dark steel + aged gold UI style, covering the window families (login, loader, ranking, shop, packs, welcome, chaos reset, character, player command, rewards launcher, jewel bank, clan war, arena, card recharge, hunting, retention, settings). Colors are #RRGGBB or #RRGGBBAA (CSS order, alpha last). Sizes are in dp.",
  "baseTheme": "modern",

  "primitives": {
    "ink": {
      "950": "#020405",
      "900": "#06090E",
      "850": "#080A0D",
      "800": "#0A0D11",
      "700": "#101115",
      "650": "#111318",
      "600": "#14171B",
      "550": "#13171C",
      "500": "#1F2326",
      "400": "#212024"
    },
    "gold": {
      "950": "#1D150C",
      "900": "#281E12",
      "850": "#3D2E19",
      "800": "#48351D",
      "750": "#4B3B21",
      "700": "#5B4C31",
      "650": "#625338",
      "600": "#69502B",
      "550": "#79613E",
      "500": "#8D6937",
      "450": "#A08349",
      "400": "#AF8B4C",
      "350": "#B38A47",
      "300": "#D0AD67",
      "250": "#D3AE66",
      "200": "#E5C582",
      "150": "#EFD398",
      "100": "#FFE4A8",
      "50": "#FFF0C4"
    },
    "parchment": {
      "700": "#6E6A60",
      "600": "#9E927A",
      "550": "#A9A08E",
      "500": "#B1A184",
      "450": "#C2BAA7",
      "400": "#C7AD79",
      "300": "#DBCFB4",
      "200": "#F5E5C4",
      "100": "#FFF7DE"
    },
    "accent": {
      "mint": "#62D6B5",
      "sky": "#60AAEB",
      "violet": "#9D4EDD",
      "ember": "#DE6026",
      "flame": "#ECAD4B",
      "blood": "#D64545",
      "jade": "#8CE6A0"
    }
  },

  "semantic": {
    "surface": {
      "deep": "#06090E",
      "backdrop": "#020406B8",
      "recessed": "#080A0D",
      "panel": "#14171B",
      "panelEnd": "#080A0D",
      "raised": "#212024",
      "raisedEnd": "#111318",
      "control": "#FFFFFF0E",
      "tooltip": "#080A0DF5",
      "inputTop": "#04060A",
      "inputBottom": "#13171C"
    },
    "text": {
      "primary": "#DBCFB4",
      "secondary": "#B1A184",
      "muted": "#9E927A",
      "warm": "#EFD398",
      "title": "#C7AD79",
      "onButton": "#FFE4A8",
      "value": "#F9D993",
      "link": "#D9B979",
      "disabled": "#5C5648"
    },
    "border": {
      "frame": "#8D6937",
      "panel": "#AF8B4C",
      "ring": "#5B4C31",
      "outer": "#101115",
      "inner": "#2E2920",
      "recessed": "#1E1C17",
      "idle": "#625338",
      "hover": "#E5C582",
      "focus": "#D3AE66",
      "selected": "#D3AE66",
      "corner": "#D0AD67",
      "divider": "#8D744B66",
      "title": "#B38A47"
    },
    "accent": {
      "chrome": "#8D744B",
      "chromeHover": "#E5C582",
      "primary": "#69502B",
      "primaryHover": "#8A6A38",
      "gold": "#D3AE66",
      "goldHover": "#FFE1A3"
    },
    "state": {
      "success": "#8CE6A0",
      "warning": "#ECAD4B",
      "danger": "#D64545",
      "rare": "#9D4EDD",
      "neutral": "#6E6A60"
    }
  },

  "typography": {
    "families": {
      "_comment": "Gelasio is metric-compatible with Georgia (the web's face) and bundled under OFL in handmade/fonts, so the web build gets the same serif as Windows.",
      "title": "Gelasio",
      "body": "Gelasio",
      "numeric": "Gelasio"
    },
    "fontFiles": {
      "KryonSerif": "fonts/Gelasio-Regular.ttf",
      "KryonSerifBold": "fonts/Gelasio-Bold.ttf"
    },
    "styles": {
      "windowTitle": { "family": "title", "size": 13, "letterSpacing": 2.4, "transform": "uppercase", "color": "text.warm", "shadow": "0 1 #000000" },
      "sectionTitle": { "family": "title", "size": 9, "letterSpacing": 1.6, "transform": "uppercase", "color": "text.title" },
      "kicker": { "family": "body", "size": 7, "letterSpacing": 1.4, "transform": "uppercase", "color": "accent.gold" },
      "body": { "family": "body", "size": 9, "color": "text.primary" },
      "small": { "family": "numeric", "size": 7.5, "color": "text.secondary" },
      "button": { "family": "title", "size": 9, "letterSpacing": 1.2, "transform": "uppercase", "color": "text.onButton", "shadow": "0 1 #000000" },
      "value": { "family": "title", "size": 11, "color": "text.value" }
    }
  },

  "radius": { "sm": 1, "md": 2, "round": 999 },

  "effects": {
    "windowRings": [
      { "kind": "outset", "spread": 3, "color": "#101115" },
      { "kind": "outset", "spread": 4, "color": "#5B4C31" },
      { "kind": "inset", "spread": 5, "color": "#080A0DB3" },
      { "kind": "inset", "spread": 6, "color": "#7F693B55" }
    ],
    "windowShadow": { "x": 0, "y": 16, "blur": 48, "color": "#000000BB" },
    "cornerOrnament": { "size": 18, "thickness": 2, "inset": 10, "color": "#D0AD67", "corners": ["top-left", "top-right"] },
    "topGlow": { "shape": "radial", "at": "50% 0%", "color": "#88704524", "reach": 0.55 },
    "brushedLines": { "angle": 135, "color": "#FFFFFF02", "period": 4 },
    "buttonHighlight": { "height": 3, "color": "#DBB87655" },
    "focusHalo": { "spread": 2, "color": "#C49A4D22" }
  },

  "gradients": {
    "panel": { "angle": 110, "stops": [["#14171B", 0], ["#080A0D", 100]] },
    "header": { "angle": 180, "stops": [["#212024", 0], ["#111318", 100]] },
    "input": { "angle": 180, "stops": [["#04060A", 0], ["#13171C", 100]] },
    "button": { "angle": 180, "stops": [["#69502B", 0], ["#3D2E19", 48], ["#281E12", 52], ["#48351D", 100]] },
    "buttonHover": { "angle": 180, "stops": [["#7E6034", 0], ["#4A381E", 48], ["#322515", 52], ["#5A4224", 100]] },
    "buttonSecondary": { "angle": 180, "stops": [["#302B24", 0], ["#161719", 100]] },
    "tabActive": { "angle": 180, "stops": [["#4B3B21", 0], ["#221D14", 100]] },
    "closeButton": { "angle": 180, "stops": [["#3C3024", 0], ["#141313", 100]] },
    "progressFill": { "angle": 0, "stops": [["#713810", 0], ["#D99A38", 45], ["#FFDC8C", 65], ["#B87523", 100]] },
    "cta": { "angle": 180, "stops": [["#FFE6A2", 0], ["#C9A24A", 100]] }
  },

  "components": {
    "window": {
      "background": "gradients.panel",
      "border": { "width": 1, "color": "border.panel" },
      "radius": "radius.sm",
      "rings": "effects.windowRings",
      "shadow": "effects.windowShadow",
      "ornaments": ["effects.cornerOrnament", "effects.topGlow", "effects.brushedLines"],
      "padding": [13, 17, 10]
    },
    "header": {
      "background": "gradients.header",
      "glow": "#A67B3430",
      "borderBottom": { "width": 1, "color": "#9C7C454F" },
      "text": "typography.styles.windowTitle",
      "align": "center"
    },
    "divider": { "height": 1, "color": "border.divider" },
    "closeButton": {
      "size": 16,
      "background": "gradients.closeButton",
      "border": { "width": 1, "color": "#8D7042" },
      "glyph": "×",
      "glyphColor": "#EBD4A0",
      "hover": { "border": "border.hover", "glyphColor": "#FFF0CC" }
    },
    "button": {
      "height": 25,
      "background": "gradients.button",
      "border": { "width": 1, "color": "border.title" },
      "rings": [
        { "kind": "inset", "spread": 2, "color": "#1D180ECC" },
        { "kind": "inset", "y": 3, "spread": 0, "color": "#DBB87655" }
      ],
      "shadow": { "x": 0, "y": 2, "blur": 6, "color": "#00000088" },
      "text": "typography.styles.button",
      "hover": { "background": "gradients.buttonHover", "border": "border.hover", "text": "#FFF0CC" },
      "pressed": { "invertGradient": true, "offsetY": 1 },
      "disabled": { "opacity": 0.5, "text": "text.disabled" }
    },
    "buttonSecondary": {
      "background": "gradients.buttonSecondary",
      "border": { "width": 1, "color": "#78613C" },
      "rings": [{ "kind": "inset", "spread": 2, "color": "#07090B80" }],
      "text": { "color": "#C8B99A" },
      "hover": { "border": "border.hover", "text": "#FFF0CC" }
    },
    "buttonCta": {
      "background": "gradients.cta",
      "border": { "width": 1, "color": "#FFEBB499" },
      "text": { "color": "#1A1206", "weight": "bold", "transform": "uppercase" },
      "shadow": { "x": 0, "y": 3, "blur": 10, "color": "#D6B45A73" }
    },
    "tab": {
      "height": 14,
      "background": "#06090E",
      "border": { "width": 1, "color": "#76613C66" },
      "text": { "color": "#A9A08E", "transform": "uppercase", "letterSpacing": 0.2 },
      "active": {
        "background": "gradients.tabActive",
        "border": "#BC9351",
        "rings": [{ "kind": "inset", "spread": 2, "color": "#171511" }],
        "text": "#FFE0A1",
        "underline": { "height": 2, "color": "#D99A43D9" }
      }
    },
    "input": {
      "height": 24,
      "background": "gradients.input",
      "border": { "width": 1, "color": "border.idle" },
      "innerShadow": { "x": 0, "y": 1, "blur": 4, "color": "#000000" },
      "text": { "color": "#F5E5C4", "size": 10 },
      "placeholder": "#FFF7DE6B",
      "iconColor": "#C2A467",
      "focus": { "border": "border.focus", "halo": "effects.focusHalo" },
      "selection": { "text": "#1B0E08", "background": "#F5CF8A" }
    },
    "row": {
      "height": 21,
      "divider": "#B4996420",
      "zebra": "#FFFFFF03",
      "hover": "#C49C3D0C",
      "text": { "color": "#C2BAA7" },
      "rank": { "first": "#F1CD76", "second": "#C7D4DE", "third": "#D1A27D", "other": "#978A71" }
    },
    "card": {
      "background": { "angle": 180, "stops": [["#292A25", 0], ["#111510", 100]] },
      "border": { "width": 2, "style": "ridge", "color": "#776141" },
      "rings": [{ "kind": "inset", "spread": 2, "color": "#080A08" }, { "kind": "inset", "y": -8, "blur": 16, "color": "#00000077" }],
      "hover": { "border": "#D1B476", "background": "#43351B" }
    },
    "badge": {
      "background": { "angle": 180, "stops": [["#F0D18A", 0], ["#C9A24A", 100]] },
      "text": { "color": "#1A1206", "weight": "bold", "size": 6.5 },
      "outlined": { "border": "#8C6A30", "text": "#F6D68F" }
    },
    "progressBar": {
      "height": 6,
      "track": "#020405",
      "border": { "width": 1, "color": "#9B7D42" },
      "fill": "gradients.progressFill",
      "glow": "#ED9C3B60"
    },
    "scrollbar": { "width": 5, "track": "#101317", "thumb": "#725937", "thumbHover": "#A08349" },
    "checkbox": { "size": 10, "background": "#06090E", "border": "border.idle", "checked": { "background": { "angle": 180, "stops": [["#D3AA4E", 0], ["#8F6922", 100]] }, "border": "border.focus" } },
    "tooltip": { "background": "surface.tooltip", "border": { "width": 1, "color": "border.frame" }, "text": "text.primary" },
    "slot": { "border": "#5B4C31", "filled": "#0A0A0A96", "selected": { "border": "border.selected", "wash": "#D3AE6619" } },
    "iconButton": {
      "size": 19,
      "radius": "radius.round",
      "background": [{ "shape": "radial", "at": "38% 28%", "color": "#FFE29C2E", "reach": 0.23 }, { "angle": 145, "stops": [["#1B130FE6", 0], ["#040404F0", 100]] }],
      "border": { "width": 2, "color": "#BB8246C7" },
      "glyph": "#F1D49A"
    },
    "loaderCard": {
      "background": [{ "shape": "radial", "at": "50% 0%", "color": "#97703724", "reach": 0.7 }, "gradients.panel"],
      "border": { "width": 1, "color": "#A08349" },
      "rings": [{ "kind": "outset", "spread": 3, "color": "#0A0D11" }, { "kind": "outset", "spread": 4, "color": "#695333" }]
    }
  },

  "variants": {
    "gold": {
      "use": "Default for every window (login, ranking, character, settings, command menus)",
      "panel": { "angle": 110, "stops": [["#14171B", 0], ["#080A0D", 100]] },
      "border": "#AF8B4C",
      "title": "#EFD398",
      "accent": "#D3AE66"
    },
    "ember": {
      "use": "Warm war/hunt windows (web: player command, character, clan war, hunting); suggested for PvP, duel, castle siege",
      "panel": { "angle": 160, "stops": [["#1B1009", 0], ["#060506", 100]] },
      "border": "#CA9446",
      "title": "#FFE9B8",
      "accent": "#D9963E",
      "glow": "#D9963E38"
    },
    "mint": {
      "use": "Shop / economy (web: shop); suggested for in-game shop, NPC shops, trade",
      "panel": { "angle": 155, "stops": [["#0E1514", 0], ["#060807", 100]] },
      "border": "#D9AA55B8",
      "title": "#FFF2D2",
      "accent": "#62D6B5"
    },
    "sky": {
      "use": "Packs / rewards (web: packs); suggested for event rewards, lucky coin, gift windows",
      "panel": { "angle": 180, "stops": [["#0D1626", 0], ["#050810", 100]] },
      "border": "#60AAEB80",
      "title": "#BFE4FF",
      "accent": "#60C4FF"
    },
    "arcane": {
      "use": "Special / magic (web: welcome, chaos reset, soul machine); suggested for chaos machine, master level, socket",
      "panel": { "angle": 180, "stops": [["#1A1028", 0], ["#09050F", 100]] },
      "border": "#F0BE4A94",
      "title": "#F0D18A",
      "accent": "#9D4EDD",
      "glow": "#FFC54A29"
    },
    "steel": {
      "use": "Vault / storage (web: jewel bank, card recharge, retention); suggested for warehouse, guild storage",
      "panel": { "angle": 180, "stops": [["#27303A", 0], ["#0B1017", 100]] },
      "border": "#B99448",
      "title": "#F5D78C",
      "accent": "#ECAD4B",
      "rings": [{ "kind": "outset", "spread": 4, "color": "#090C11" }, { "kind": "outset", "spread": 5, "color": "#534326" }]
    }
  },

  "clientTokens": {
    "_comment": "Values written to themes/kryon/tokens.ini for sven-n/MuMain (modern token names). Each entry points at a path in this file or is a literal.",
    "surface-deep": "semantic.surface.deep",
    "surface-backdrop": "semantic.surface.backdrop",
    "surface-recessed": "semantic.surface.recessed",
    "surface-panel": "semantic.surface.panel",
    "surface-raised": "semantic.surface.raised",
    "surface-control": "semantic.surface.control",
    "surface-tooltip": "semantic.surface.tooltip",
    "metal-dark": "primitives.ink.700",
    "metal-mid": "primitives.gold.700",
    "metal-edge": "primitives.gold.550",
    "metal-highlight": "primitives.gold.300",
    "metal-warm-edge": "#8D744B",
    "metal-outer": "primitives.ink.800",
    "metal-groove": "primitives.ink.550",
    "metal-rail": "primitives.ink.400",
    "metal-rail-dark": "primitives.ink.650",
    "metal-title-face": "primitives.gold.850",
    "metal-title-face-dark": "primitives.gold.950",
    "text-primary": "semantic.text.primary",
    "text-secondary": "semantic.text.secondary",
    "text-muted": "semantic.text.muted",
    "text-warm": "semantic.text.warm",
    "text-disabled": "semantic.text.disabled",
    "accent-steel": "semantic.accent.chrome",
    "accent-steel-hover": "semantic.accent.chromeHover",
    "accent-crimson": "semantic.accent.primary",
    "accent-crimson-hover": "semantic.accent.primaryHover",
    "accent-gold": "semantic.accent.gold",
    "accent-gold-hover": "semantic.accent.goldHover",
    "semantic-success": "semantic.state.success",
    "semantic-warning": "semantic.state.warning",
    "semantic-danger": "semantic.state.danger",
    "semantic-rare": "semantic.state.rare",
    "semantic-neutral": "semantic.state.neutral",
    "border-frame": "semantic.border.frame",
    "border-inner": "semantic.border.inner",
    "border-recessed": "semantic.border.recessed",
    "border-hover": "semantic.border.hover",
    "border-selected": "semantic.border.selected",
    "border-outer": "semantic.border.outer",
    "border-rail": "semantic.border.ring",
    "border-title": "semantic.border.title",
    "radius-sm": "radius.sm",
    "radius-md": "radius.md",
    "font-title": "typography.families.title",
    "font-body": "typography.families.body",
    "server-button": "semantic.accent.gold",
    "server-button-gray": "semantic.state.neutral",
    "server-button-orange": "semantic.state.warning",
    "server-button-silver": "#C7D4DE"
  },

  "handmadeShared": {
    "_comment": "handmade/shared/<file>: appended to each listed stylesheet of the base theme, before that stylesheet's own handmade overlay.",
    "inventory_frame.rcss": [
      "my_inventory.rcss", "inventory_extension.rcss", "storage.rcss", "storage_ext.rcss", "trade.rcss",
      "npc_shop.rcss", "my_shop.rcss", "purchase_shop.rcss", "mix_inventory.rcss", "lucky_item.rcss"
    ],
    "flat_card.rcss": {
      "battle_soccer_score.rcss": "#panel",
      "cursed_temple_enter.rcss": "#panel",
      "cursed_temple_result.rcss": "#panel",
      "doppelganger_frame.rcss": "#back",
      "duel_window.rcss": "#panel",
      "event_timer.rcss": "#back",
      "igs_buy_package.rcss": ".igs-dialog-frame",
      "igs_buy_select.rcss": ".igs-dialog-frame",
      "igs_send_gift.rcss": ".igs-dialog-frame",
      "in_game_shop.rcss": ".bg-back",
      "kanturu_enter.rcss": "#panel",
      "kanturu_info.rcss": "#back",
      "master_level.rcss": "#panel",
      "match_status.rcss": "#result_back",
      "message_box_view.rcss": "#back",
      "move_command.rcss": "#panel",
      "quick_command.rcss": "#panel",
      "reconnect_dialog.rcss": "#back",
      "window_menu.rcss": "#panel"
    }
  },

  "themeTokens": {
    "_comment": "This theme's own tokens (kryon-*), read by the handmade stylesheets in handmade/. Paths into this file or literals.",
    "kryon-card-top": "primitives.ink.600",
    "kryon-card-mid": "#0B0E12",
    "kryon-card-bottom": "primitives.ink.850",
    "kryon-card-glow": "effects.topGlow.color",
    "kryon-card-border": "semantic.border.panel",
    "kryon-ring-outer": "semantic.border.outer",
    "kryon-ring-gold": "semantic.border.ring",
    "kryon-ring-inner-dark": "#080A0DB3",
    "kryon-filete": "#7F693B55",
    "kryon-corner": "semantic.border.corner",
    "kryon-title": "semantic.text.title",
    "kryon-label": "semantic.text.muted",
    "kryon-divider": "semantic.border.divider",
    "kryon-well-top": "semantic.surface.inputTop",
    "kryon-well-bottom": "semantic.surface.inputBottom",
    "kryon-well-border": "semantic.border.idle",
    "kryon-well-focus": "semantic.border.focus",
    "kryon-well-halo": "effects.focusHalo.color",
    "kryon-field-text": "primitives.parchment.200",
    "kryon-btn-text": "semantic.text.onButton",
    "kryon-btn-text-hover": "#FFF0CC",
    "kryon-btn-border": "semantic.border.title",
    "kryon-btn-border-hover": "semantic.border.hover",
    "kryon-btn-1": "#69502B",
    "kryon-btn-2": "#3D2E19",
    "kryon-btn-3": "#281E12",
    "kryon-btn-4": "#48351D",
    "kryon-btn-hover-1": "#7E6034",
    "kryon-btn-hover-2": "#4A381E",
    "kryon-btn-hover-3": "#322515",
    "kryon-btn-hover-4": "#5A4224",
    "kryon-btn-ring": "#1D180ECC",
    "kryon-btn-shine": "#DBB87655",
    "kryon-tab-top": "#4A3925",
    "kryon-tab-bottom": "#221C13",
    "kryon-tab-border": "#937344",
    "kryon-tab-text": "#EDDAA8",
    "kryon-tab-idle": "primitives.ink.900",
    "kryon-tab-idle-border": "#76613C66",
    "kryon-tab-idle-text": "primitives.parchment.550",
    "kryon-row-hover": "#C49C3D14",
    "kryon-row-divider": "#B4996420",
    "kryon-gold-fill-top": "#D3AA4E",
    "kryon-gold-fill-bottom": "#8F6922",
    "kryon-scroll-track": "#101317",
    "kryon-scroll-thumb": "#725937",
    "kryon-scroll-thumb-hover": "primitives.gold.450"
  },

  "recolor": {
    "_comment": "How the generator retints the literal colors of the base theme's .rcss files so every window follows this palette. Hues in degrees, saturation/lightness 0..1.",
    "skipFiles": ["tooltip.rcss", "item_help.rcss"],
    "neutralMaxSaturation": 0.24,
    "surface": { "maxLightness": 0.2, "hue": 214, "saturation": 0.16, "lightnessScale": 1.0 },
    "metal": { "maxLightness": 0.62, "hue": 38, "saturation": 0.36, "lightnessScale": 1.22 },
    "text": { "hue": 40, "saturation": 0.4, "lightnessScale": 1.0 },
    "warm": { "minHue": 18, "maxHue": 62, "hue": 39, "saturationScale": 1.0 },
    "crimson": { "maxHueBelow": 16, "minHueAbove": 344, "maxLightness": 0.45, "hue": 36, "maxSaturation": 0.46, "lightnessScale": 1.25 }
  }
}
