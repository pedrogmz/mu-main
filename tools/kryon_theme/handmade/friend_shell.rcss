/* Kryon friends window: the tabs and buttons as the web's tabs, the list as a dark well with
   bronze row highlights. Layout stays modern's. */

.btn {
	color: token(kryon-tab-idle-text);
	background-color: token(kryon-tab-idle);
	decorator: none;
	border: 1dp token(kryon-tab-idle-border);
	border-radius: token(radius-sm)dp;
	box-shadow: none;
	letter-spacing: 0;
	text-transform: none;
}
.btn:hover {
	color: token(kryon-btn-text-hover);
	border-color: token(kryon-btn-border-hover);
	background-color: token(kryon-row-hover);
}
#tabs .btn.selected {
	color: token(kryon-tab-text);
	decorator: linear-gradient(180deg, token(kryon-tab-top) 0%, token(kryon-tab-bottom) 100%);
	border-color: token(kryon-tab-border);
	box-shadow: inset 0 -2dp 0 rgba(217, 154, 67, 217);
}
.headers {
	border-bottom: 1dp token(kryon-divider);
}
.headers .sorted {
	color: token(kryon-title);
}
.scroll-pane {
	background-color: token(kryon-well-top);
	border: 1dp token(kryon-well-border);
}
.row:hover {
	background-color: token(kryon-row-hover);
}
.row.selected {
	color: token(kryon-btn-text);
	background-color: rgba(211, 174, 102, 40);
}
.check {
	background-color: token(kryon-well-top);
	border: 1dp token(kryon-well-border);
}
.checked .check {
	background-color: token(kryon-gold-fill-bottom);
	border-color: token(kryon-well-focus);
}

/* Window buttons and resize corner: modern draws their symbols with :before { content }, which
   RmlUi does not have, so they were empty; Kryon gives them icons (handmade/icons). */
#window_controls button {
	background-color: token(kryon-tab-idle);
	border: 1dp token(kryon-tab-idle-border);
	border-radius: token(radius-sm)dp;
}
#window_controls button:hover {
	background-color: token(kryon-row-hover);
	border-color: token(kryon-btn-border-hover);
}
#btn_minimize { decorator: image(icons/minimize.tga contain); }
#btn_maximize { decorator: image(icons/maximize.tga contain); }
#btn_maximize.restore { decorator: image(icons/restore.tga contain); }
#btn_close { decorator: image(icons/close.tga contain); }
#btn_close:hover {
	border-color: #c0564e;
}
#resize {
	background-color: transparent;
	border-width: 0;
	decorator: image(icons/grip.tga contain);
}
