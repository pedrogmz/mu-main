/* Kryon HUD: modern's strip and layout with the Kryon materials -- a dark steel strip under a
   double gold line, the bars and slots as recessed wells with bronze edges, gold hotkey letters
   and a gold EXP bar. The bar colors (HP red, MP blue, AG, SD, poison green) are gameplay colors and
   stay modern's. The bands stay translucent: the potion and skill icons draw behind them. */

/* The strip */
#gauge_frame {
	border-top: 1dp token(kryon-card-border);
	box-shadow: 0 -2dp 0 0 token(kryon-ring-outer), 0 -3dp 0 0 token(kryon-ring-gold);
}
#gauge_fill_left,
#gauge_fill_right,
#item_band_fill,
#skill_band_fill {
	background-color: rgba(8, 10, 13, 170);
	decorator: linear-gradient(180deg, rgba(20, 23, 27, 190) 0%, rgba(6, 9, 14, 210) 100%);
}
#gauge_fill_left { border-radius: token(radius-md)dp 0 0 0; }
#gauge_fill_right { border-radius: 0 token(radius-md)dp 0 0; }

/* Slots and bars: wells with a bronze edge */
.slot-frame {
	border: 1dp rgba(141, 116, 75, 120);
	border-radius: token(radius-sm)dp;
}
.gauge-slot {
	background-color: rgba(4, 6, 9, 210);
	border-color: token(kryon-well-border);
	box-shadow: inset 0 1dp 3dp #000000;
}
.gauge-fill-horizontal {
	border-radius: token(radius-sm)dp;
}
.gauge-num {
	font-family: "token(font-title)";
}

/* EXP: the web's golden progress bar */
#exp_track {
	background-color: rgba(2, 4, 5, 220);
	border-color: rgba(155, 125, 66, 200);
}
#exp_fill {
	background-color: #d99a38;
	decorator: linear-gradient(90deg, #713810 0%, #d99a38 45%, #ffdc8c 65%, #b87523 100%);
	border-top-width: 0;
	box-shadow: 0 0 6dp rgba(237, 156, 59, 96);
}
#exp_digit {
	color: token(kryon-btn-text);
}

/* Hotkey letters and the hovered / selected slot */
.slot-hotkey-label,
.skill-hotkey-label {
	color: token(kryon-btn-text);
}
#item_slots .selected,
#skill_slots .selected,
.skill-cell.selected {
	border: 1dp token(kryon-well-focus);
	background-color: rgba(211, 174, 102, 30);
}
.skill-cell {
	border: 1dp rgba(141, 116, 75, 120);
	background-color: rgba(6, 9, 14, 200);
}
