/* Kryon MU Helper: the centred card of mu_helper_config.rml (Kryon's fork). Drawn on the panel
   stage, in its 640x480 reference px. The card, buttons and tabs repeat the web shell's Kryon
   kit (index.html's #game-controls and .hud-btn); skill icons are the client's own atlases.

   Sharp text: RmlUi rasterises glyphs at the computed font-size, so a #panel scaled by
   transform: scale(--root-scale) (base.rcss's #panel.slot-placed) stretched every glyph 1.5-2x
   and blurred it. This card is a flowing flex layout, where per-leaf counter-scaling would inflate
   the layout boxes, so instead the whole card drops the transform and lays out at the physical
   size: every length is its reference px times --root-scale (1 while unplaced). Hairline 1px
   borders and the 1px text shadows stay one screen pixel on purpose. */

body { pointer-events: none; }
.hidden, #panel .hidden { display: none; }

#panel {
	position: absolute;
	transform-origin: left top;
	width: calc(600px * var(--root-scale, 1));
	height: calc(440px * var(--root-scale, 1));
	display: flex;
	flex-direction: column;
	padding: calc(10px * var(--root-scale, 1)) calc(12px * var(--root-scale, 1)) calc(10px * var(--root-scale, 1)) calc(12px * var(--root-scale, 1));
	box-sizing: border-box;
	pointer-events: auto;
	font-family: "token(font-body)";
	font-size: calc(12px * var(--root-scale, 1));
	color: token(kryon-tab-text);
	background-color: token(kryon-card-bottom);
	decorator:
		radial-gradient(circle at 50% 0%, token(kryon-card-glow), transparent 55%),
		linear-gradient(110deg, token(kryon-card-top) 0%, token(kryon-card-mid) 50%, token(kryon-card-bottom) 100%);
	border-width: 1px;
	border-color: token(kryon-card-border);
	border-radius: calc(token(radius-md)px * var(--root-scale, 1));
	box-shadow:
		0 0 0 calc(3px * var(--root-scale, 1)) token(kryon-ring-outer),
		0 0 0 calc(4px * var(--root-scale, 1)) token(kryon-ring-gold),
		0 calc(16px * var(--root-scale, 1)) calc(40px * var(--root-scale, 1)) rgba(0, 0, 0, 187),
		inset 0 0 0 calc(3px * var(--root-scale, 1)) token(kryon-ring-inner-dark),
		inset 0 0 0 calc(4px * var(--root-scale, 1)) token(kryon-filete);
}

/* Placed: base.rcss scales the slot-placed panel; this card is already laid out at that size. */
#panel.slot-placed { transform: none; }

/* ---- Header: mark, title, status pill, close ------------------------------------------------- */
#mhk_header {
	display: flex;
	flex-direction: row;
	align-items: center;
	flex: 0 0 auto;
	height: calc(40px * var(--root-scale, 1));
	padding: 0 calc(4px * var(--root-scale, 1)) calc(6px * var(--root-scale, 1)) calc(4px * var(--root-scale, 1));
	border-bottom: 1px token(kryon-divider);
}
#mhk_mark {
	flex: 0 0 auto;
	width: calc(30px * var(--root-scale, 1));
	height: calc(30px * var(--root-scale, 1));
	margin-right: calc(10px * var(--root-scale, 1));
	border: 1px token(kryon-btn-border);
	border-radius: calc(15px * var(--root-scale, 1));
	background-color: token(kryon-btn-3);
	decorator: image(icons/chat_gens.tga contain);
	box-shadow: inset 0 0 0 calc(2px * var(--root-scale, 1)) token(kryon-btn-ring), 0 0 calc(8px * var(--root-scale, 1)) token(kryon-well-halo);
}
#mhk_heading { flex: 1 1 auto; display: flex; flex-direction: column; }
#title {
	font-family: "token(font-title)";
	font-size: calc(17px * var(--root-scale, 1));
	color: token(kryon-mint-title);
	letter-spacing: calc(1px * var(--root-scale, 1));
	font-effect: shadow(0px 1px #000000);
}
#mhk_subtitle { font-size: calc(11px * var(--root-scale, 1)); color: token(kryon-label); }

#mhk_status {
	flex: 0 0 auto;
	display: flex;
	flex-direction: row;
	align-items: center;
	height: calc(22px * var(--root-scale, 1));
	padding: 0 calc(10px * var(--root-scale, 1)) 0 calc(8px * var(--root-scale, 1));
	margin-right: calc(34px * var(--root-scale, 1));
	border: 1px token(kryon-tab-idle-border);
	border-radius: calc(11px * var(--root-scale, 1));
	background-color: rgba(0, 0, 0, 120);
	font-size: calc(11px * var(--root-scale, 1));
	text-transform: uppercase;
	letter-spacing: calc(1px * var(--root-scale, 1));
	color: token(kryon-tab-idle-text);
}
.mhk-status-dot {
	width: calc(8px * var(--root-scale, 1));
	height: calc(8px * var(--root-scale, 1));
	margin-right: calc(6px * var(--root-scale, 1));
	border-radius: calc(4px * var(--root-scale, 1));
	background-color: token(semantic-neutral);
}
#mhk_status.running { color: token(kryon-mint-accent); border-color: token(kryon-mint-border); }
#mhk_status.running .mhk-status-dot { background-color: token(kryon-mint-accent); box-shadow: 0 0 calc(6px * var(--root-scale, 1)) token(kryon-mint-accent); }
#mhk_status.safe { color: token(semantic-danger); }
#mhk_status.safe .mhk-status-dot { background-color: token(semantic-danger); }

#btn_exit { position: absolute; right: calc(10px * var(--root-scale, 1)); top: calc(12px * var(--root-scale, 1)); }
/* base.rcss's px close button, sized for a transformed panel: re-expressed at the physical size,
   and its glyph no longer counter-scales (there is no panel scale left to cancel). */
#btn_exit.modern-icon-btn-px {
	bottom: auto;
	width: calc(37px * var(--root-scale, 1));
	height: calc(26px * var(--root-scale, 1));
	line-height: calc(26px * var(--root-scale, 1));
	border-radius: calc(token(radius-sm)px * var(--root-scale, 1));
	box-shadow: 0 calc(2px * var(--root-scale, 1)) calc(5px * var(--root-scale, 1)) rgba(0, 0, 0, 133), inset 0 1px 0 rgba(232, 210, 168, 18), inset 0 -1px 0 #000000;
}
#btn_exit .modern-icon-btn-glyph-px {
	font-size: calc(12px * var(--root-scale, 1));
	transform: translateY(-50%);
}

/* ---- Tabs ------------------------------------------------------------------------------------ */
#mhk_tabs {
	display: flex;
	flex-direction: row;
	flex: 0 0 auto;
	margin: calc(8px * var(--root-scale, 1)) 0 calc(8px * var(--root-scale, 1)) 0;
	gap: calc(6px * var(--root-scale, 1));
}
.mhk-tab {
	flex: 1 1 0;
	height: calc(24px * var(--root-scale, 1));
	line-height: calc(22px * var(--root-scale, 1));
	text-align: center;
	font-family: "token(font-title)";
	font-size: calc(12px * var(--root-scale, 1));
	color: token(kryon-tab-idle-text);
	background-color: token(kryon-tab-idle);
	decorator: linear-gradient(180deg, token(kryon-card-top) 0%, token(kryon-tab-idle) 100%);
	border: 1px token(kryon-tab-idle-border);
	border-radius: calc(token(radius-sm)px * var(--root-scale, 1));
	cursor: pointer;
}
.mhk-tab:hover { color: token(kryon-btn-text-hover); border-color: token(kryon-btn-border-hover); }
.mhk-tab.active {
	color: token(kryon-tab-text);
	background-color: token(kryon-tab-bottom);
	decorator: linear-gradient(180deg, token(kryon-tab-top) 0%, token(kryon-tab-bottom) 100%);
	border-color: token(kryon-tab-border);
	box-shadow: inset 0 calc(-2px * var(--root-scale, 1)) 0 rgba(217, 154, 67, 217);
}

/* ---- Body and pages -------------------------------------------------------------------------- */
#mhk_body { position: relative; flex: 1 1 auto; min-height: 0; }
.mhk-page { position: absolute; left: 0; top: 0; right: 0; bottom: 0; display: flex; flex-direction: column; }
#mhk_other { display: block; overflow-y: auto; padding-right: calc(6px * var(--root-scale, 1)); }

.mhk-small { font-size: calc(10px * var(--root-scale, 1)); color: token(kryon-label); text-transform: uppercase; letter-spacing: calc(1px * var(--root-scale, 1)); }
.mhk-strong { font-family: "token(font-title)"; font-size: calc(14px * var(--root-scale, 1)); color: token(kryon-title); }

/* ---- Combat lanes ---------------------------------------------------------------------------- */
.mhk-lanes { flex: 1 1 auto; min-height: 0; display: flex; flex-direction: row; gap: calc(10px * var(--root-scale, 1)); }
.mhk-lane {
	flex: 1 1 0;
	min-width: 0;
	display: flex;
	flex-direction: column;
	border: 1px token(kryon-well-border);
	border-radius: calc(token(radius-md)px * var(--root-scale, 1));
	background-color: token(kryon-well-top);
	decorator: linear-gradient(180deg, token(kryon-well-top) 0%, token(kryon-well-bottom) 100%);
	box-shadow: inset 0 calc(2px * var(--root-scale, 1)) calc(7px * var(--root-scale, 1)) #000000;
}
.mhk-lane-title {
	display: flex;
	flex-direction: row;
	align-items: center;
	height: calc(26px * var(--root-scale, 1));
	padding: 0 calc(8px * var(--root-scale, 1));
	font-family: "token(font-title)";
	font-size: calc(13px * var(--root-scale, 1));
	color: token(kryon-title);
}
.mhk-lane-title span { margin-right: calc(8px * var(--root-scale, 1)); }
.mhk-lane-title .mhk-small { margin-left: auto; margin-right: 0; }
.mhk-lane-icon { width: calc(16px * var(--root-scale, 1)); height: calc(16px * var(--root-scale, 1)); margin-right: calc(6px * var(--root-scale, 1)); }
.mhk-icon-attack { decorator: image(icons/chat_gens.tga contain); }
.mhk-icon-buff { decorator: image(icons/chat_guild.tga contain); }

/* The chosen skills: fixed slots, each a framed icon with its remove badge. */
.mhk-selected {
	display: flex;
	flex-direction: row;
	align-items: center;
	height: calc(54px * var(--root-scale, 1));
	padding: 0 calc(8px * var(--root-scale, 1)) calc(6px * var(--root-scale, 1)) calc(8px * var(--root-scale, 1));
	gap: calc(8px * var(--root-scale, 1));
}
.mhk-chip {
	position: relative;
	flex: 0 0 auto;
	width: calc(34px * var(--root-scale, 1));
	height: calc(46px * var(--root-scale, 1));
	border: 1px token(kryon-btn-border);
	border-radius: calc(token(radius-md)px * var(--root-scale, 1));
	background-color: #000000;
	box-shadow: inset 0 0 0 calc(2px * var(--root-scale, 1)) rgba(0, 0, 0, 160), 0 0 calc(6px * var(--root-scale, 1)) token(kryon-well-halo);
	cursor: pointer;
}
.mhk-chip:hover { border-color: token(semantic-danger); }
.mhk-chip-icon { position: absolute; left: calc(2px * var(--root-scale, 1)); top: calc(2px * var(--root-scale, 1)); width: calc(30px * var(--root-scale, 1)); height: calc(42px * var(--root-scale, 1)); }
.mhk-chip-x {
	position: absolute;
	right: calc(-6px * var(--root-scale, 1));
	top: calc(-6px * var(--root-scale, 1));
	width: calc(14px * var(--root-scale, 1));
	height: calc(14px * var(--root-scale, 1));
	line-height: calc(13px * var(--root-scale, 1));
	text-align: center;
	font-size: calc(11px * var(--root-scale, 1));
	color: #fff0d2;
	background-color: #8f3828;
	border: 1px #e7a26e;
	border-radius: calc(7px * var(--root-scale, 1));
}
.mhk-chip-n {
	position: absolute;
	left: calc(2px * var(--root-scale, 1));
	bottom: calc(1px * var(--root-scale, 1));
	font-size: calc(10px * var(--root-scale, 1));
	color: token(kryon-btn-text);
	font-effect: shadow(0px 1px #000000);
}
.mhk-chip.empty {
	border-color: token(kryon-tab-idle-border);
	background-color: transparent;
	box-shadow: none;
	cursor: default;
}
.mhk-chip.empty .mhk-chip-x, .mhk-chip.empty .mhk-chip-icon { display: none; }
.mhk-chip.empty .mhk-chip-n { left: 0; right: 0; bottom: auto; top: calc(14px * var(--root-scale, 1)); text-align: center; font-size: calc(13px * var(--root-scale, 1)); color: token(kryon-tab-idle-text); }
.mhk-hint { flex: 1 1 auto; text-align: right; font-size: calc(10px * var(--root-scale, 1)); color: token(kryon-label); }

/* The learned skills to add. */
.mhk-catalog {
	flex: 1 1 auto;
	min-height: 0;
	display: flex;
	flex-direction: row;
	flex-wrap: wrap;
	align-content: flex-start;
	gap: calc(6px * var(--root-scale, 1));
	padding: calc(8px * var(--root-scale, 1));
	overflow-y: auto;
	border-top: 1px token(kryon-row-divider);
}
.mhk-skill {
	position: relative;
	flex: 0 0 auto;
	width: calc(32px * var(--root-scale, 1));
	height: calc(44px * var(--root-scale, 1));
	border: 1px token(kryon-tab-border);
	border-radius: calc(token(radius-md)px * var(--root-scale, 1));
	background-color: #000000;
	cursor: pointer;
}
.mhk-skill:hover { border-color: token(kryon-btn-border-hover); box-shadow: 0 0 calc(8px * var(--root-scale, 1)) token(kryon-well-halo); }
.mhk-skill-icon { position: absolute; left: calc(1px * var(--root-scale, 1)); top: calc(1px * var(--root-scale, 1)); width: calc(30px * var(--root-scale, 1)); height: calc(42px * var(--root-scale, 1)); }
.mhk-skill-plus {
	position: absolute;
	right: calc(-4px * var(--root-scale, 1));
	bottom: calc(-4px * var(--root-scale, 1));
	width: calc(13px * var(--root-scale, 1));
	height: calc(13px * var(--root-scale, 1));
	line-height: calc(12px * var(--root-scale, 1));
	text-align: center;
	font-size: calc(11px * var(--root-scale, 1));
	color: #0a160d;
	background-color: #8fe5a7;
	border: 1px #dffff0;
	border-radius: calc(7px * var(--root-scale, 1));
}
.mhk-skill.added { opacity: 0.35; cursor: default; }
.mhk-skill.added .mhk-skill-plus { display: none; }
.mhk-empty { font-size: calc(11px * var(--root-scale, 1)); color: token(kryon-label); }

/* ---- Checkboxes, rows, inputs ---------------------------------------------------------------- */
.mhk-options { flex: 0 0 auto; display: flex; flex-direction: row; flex-wrap: wrap; gap: calc(14px * var(--root-scale, 1)); padding: calc(8px * var(--root-scale, 1)) calc(2px * var(--root-scale, 1)) 0 calc(2px * var(--root-scale, 1)); }
.mhk-check {
	display: flex;
	flex-direction: row;
	align-items: center;
	cursor: pointer;
	color: token(kryon-tab-text);
}
.mhk-check .checkbox-box { flex: 0 0 auto; position: relative; margin-right: calc(6px * var(--root-scale, 1)); }
/* Unchecked boxes: the theme's well colour vanishes on this card, so a gilded edge and a darker
   fill keep them visible; the checked state keeps the theme's gold fill. */
.mhk-check .checkbox-box,
.mhk-card .checkbox-box {
	width: calc(12px * var(--root-scale, 1));
	height: calc(12px * var(--root-scale, 1));
	background-color: #07080a;
	border-width: 1px;
	border-color: token(kryon-ring-gold);
	border-radius: calc(token(radius-sm)px * var(--root-scale, 1));
	box-shadow: none;
}
.mhk-check .checkbox-box.checked,
.mhk-card .checkbox-box.checked {
	background-color: token(kryon-gold-fill-bottom);
	border-color: token(kryon-well-focus);
}
.mhk-check:hover { color: token(kryon-btn-text-hover); }
.mhk-radio { border-radius: calc(6px * var(--root-scale, 1)); }

.mhk-section {
	display: block;
	margin-bottom: calc(8px * var(--root-scale, 1));
	padding: calc(6px * var(--root-scale, 1)) calc(10px * var(--root-scale, 1)) calc(8px * var(--root-scale, 1)) calc(10px * var(--root-scale, 1));
	border: 1px token(kryon-row-divider);
	border-radius: calc(token(radius-md)px * var(--root-scale, 1));
	background-color: rgba(0, 0, 0, 90);
}
.mhk-section-title {
	display: block;
	margin-bottom: calc(6px * var(--root-scale, 1));
	font-family: "token(font-title)";
	font-size: calc(12px * var(--root-scale, 1));
	color: token(kryon-title);
}
.mhk-row { display: flex; flex-direction: row; flex-wrap: wrap; align-items: center; gap: calc(12px * var(--root-scale, 1)); margin-top: calc(4px * var(--root-scale, 1)); }
.mhk-field { height: calc(20px * var(--root-scale, 1)); padding: 0 calc(6px * var(--root-scale, 1)); box-sizing: border-box; }
.mhk-num { width: calc(36px * var(--root-scale, 1)); text-align: center; }
.mhk-unit { margin-left: calc(-8px * var(--root-scale, 1)); color: token(kryon-label); }

/* ---- Buttons (the web's .hud-btn and its forged primary) -------------------------------------- */
.mhk-btn {
	flex: 0 0 auto;
	height: calc(24px * var(--root-scale, 1));
	line-height: calc(22px * var(--root-scale, 1));
	padding: 0 calc(12px * var(--root-scale, 1));
	text-align: center;
	font-family: "token(font-title)";
	font-size: calc(12px * var(--root-scale, 1));
	color: token(kryon-tab-text);
	background-color: token(kryon-tab-idle);
	decorator: linear-gradient(180deg, token(kryon-card-top) 0%, token(kryon-tab-idle) 100%);
	border: 1px token(kryon-tab-border);
	border-radius: calc(token(radius-sm)px * var(--root-scale, 1));
	box-shadow: inset 0 0 0 calc(1px * var(--root-scale, 1)) #130e08, 0 calc(2px * var(--root-scale, 1)) calc(6px * var(--root-scale, 1)) rgba(0, 0, 0, 135);
	cursor: pointer;
	font-effect: shadow(0px 1px #000000);
}
.mhk-btn:hover {
	color: token(kryon-btn-text-hover);
	border-color: token(kryon-btn-border-hover);
	background-color: token(kryon-tab-bottom);
	decorator: linear-gradient(180deg, token(kryon-tab-top) 0%, token(kryon-tab-bottom) 100%);
}
/* Same box as the other footer buttons (height, padding, type size); only the forged fill and the
   capitals mark it as the primary action. */
.mhk-btn-primary {
	text-transform: uppercase;
	color: token(kryon-btn-text);
	background-color: token(kryon-btn-3);
	decorator: linear-gradient(180deg, token(kryon-btn-1) 0%, token(kryon-btn-2) 48%, token(kryon-btn-3) 52%, token(kryon-btn-4) 100%);
	border-color: token(kryon-btn-border);
	box-shadow: inset 0 0 0 calc(2px * var(--root-scale, 1)) token(kryon-btn-ring), inset 0 calc(3px * var(--root-scale, 1)) 0 token(kryon-btn-shine), 0 calc(4px * var(--root-scale, 1)) calc(12px * var(--root-scale, 1)) rgba(0, 0, 0, 135);
}
.mhk-btn-primary:hover {
	border-color: token(kryon-btn-border-hover);
	decorator: linear-gradient(180deg, token(kryon-btn-hover-1) 0%, token(kryon-btn-hover-2) 48%, token(kryon-btn-hover-3) 52%, token(kryon-btn-hover-4) 100%);
}
/* Running: the same forged button, tinted to stop. */
.mhk-btn-primary.running { color: #ffd9cc; border-color: #b0573f; decorator: linear-gradient(180deg, #6e2e22 0%, #45201a 48%, #2e1611 52%, #4d231b 100%); }

/* ---- Pick-up --------------------------------------------------------------------------------- */
.mhk-pickup-head { display: flex; flex-direction: row; align-items: center; flex: 0 0 auto; margin-bottom: calc(10px * var(--root-scale, 1)); }
.mhk-pickup-copy { flex: 1 1 auto; display: flex; flex-direction: column; }
.mhk-pickup-copy .mhk-small { text-transform: none; letter-spacing: 0; font-size: calc(11px * var(--root-scale, 1)); }
.mhk-segment { flex: 0 0 auto; display: flex; flex-direction: row; gap: calc(6px * var(--root-scale, 1)); }
.mhk-seg {
	display: flex;
	flex-direction: row;
	align-items: center;
	height: calc(26px * var(--root-scale, 1));
	padding: 0 calc(10px * var(--root-scale, 1));
	color: token(kryon-tab-idle-text);
	background-color: token(kryon-tab-idle);
	border: 1px token(kryon-tab-idle-border);
	border-radius: calc(13px * var(--root-scale, 1));
	cursor: pointer;
}
.mhk-seg:hover { color: token(kryon-btn-text-hover); }
.mhk-seg.active { color: token(kryon-btn-text); background-color: token(kryon-tab-bottom); border-color: token(kryon-btn-border); }
.mhk-seg-icon { width: calc(16px * var(--root-scale, 1)); height: calc(16px * var(--root-scale, 1)); margin-right: calc(6px * var(--root-scale, 1)); }

.mhk-cards { flex: 0 0 auto; display: flex; flex-direction: row; flex-wrap: wrap; gap: calc(8px * var(--root-scale, 1)); }
.mhk-card {
	position: relative;
	width: calc(182px * var(--root-scale, 1));
	height: calc(44px * var(--root-scale, 1));
	display: flex;
	flex-direction: row;
	align-items: center;
	padding: 0 calc(10px * var(--root-scale, 1)) 0 calc(8px * var(--root-scale, 1));
	box-sizing: border-box;
	border: 1px token(kryon-tab-idle-border);
	border-radius: calc(token(radius-md)px * var(--root-scale, 1));
	background-color: token(kryon-well-top);
	decorator: linear-gradient(180deg, token(kryon-well-bottom) 0%, token(kryon-well-top) 100%);
	cursor: pointer;
}
.mhk-card:hover { border-color: token(kryon-btn-border-hover); }
.mhk-card.on { border-color: token(kryon-btn-border); box-shadow: inset 0 0 calc(12px * var(--root-scale, 1)) token(kryon-row-hover), 0 0 calc(6px * var(--root-scale, 1)) token(kryon-well-halo); }
.mhk-card-icon { flex: 0 0 auto; width: calc(28px * var(--root-scale, 1)); height: calc(28px * var(--root-scale, 1)); margin-right: calc(10px * var(--root-scale, 1)); }
.mhk-card-name { flex: 1 1 auto; font-size: calc(12px * var(--root-scale, 1)); }
.mhk-card .checkbox-box { position: relative; flex: 0 0 auto; }
.mhk-cards.dim .mhk-card, .mhk-extra.dim { opacity: 0.45; }

.mhk-icon-zen { decorator: image(icons/coin.tga contain); }
.mhk-icon-gem { decorator: image(icons/gem.tga contain); }
.mhk-icon-sparkle { decorator: image(icons/sparkle.tga contain); }
.mhk-icon-helm { decorator: image(icons/helm.tga contain); }
.mhk-icon-tag { decorator: image(icons/tag.tga contain); }
.mhk-icon-bag { decorator: image(icons/bag.tga contain); }
.mhk-icon-repair { decorator: image(icons/repair.tga contain); }

.mhk-extra { flex: 1 1 auto; min-height: 0; display: flex; flex-direction: column; margin-top: calc(10px * var(--root-scale, 1)); }
.mhk-extra-entry { flex: 0 0 auto; display: flex; flex-direction: row; align-items: center; gap: calc(6px * var(--root-scale, 1)); margin-bottom: calc(6px * var(--root-scale, 1)); }
.mhk-extra-entry .mhk-field { flex: 1 1 auto; }
#extra_list {
	flex: 1 1 auto;
	min-height: 0;
	overflow-y: auto;
	border: 1px token(kryon-well-border);
	border-radius: calc(token(radius-md)px * var(--root-scale, 1));
	background-color: token(kryon-well-top);
}
.mhk-extra-row { display: block; padding: calc(3px * var(--root-scale, 1)) calc(8px * var(--root-scale, 1)); border-bottom: calc(1px * var(--root-scale, 1)) token(kryon-row-divider); cursor: pointer; }
.mhk-extra-row:hover { background-color: token(kryon-row-hover); }
.mhk-extra-row.selected { color: token(kryon-btn-text); background-color: token(kryon-tab-bottom); }

/* ---- Footer: ranges, potion, actions --------------------------------------------------------- */
#mhk_footer {
	flex: 0 0 auto;
	display: flex;
	flex-direction: row;
	flex-wrap: wrap;
	align-items: center;
	gap: calc(8px * var(--root-scale, 1));
	margin-top: calc(10px * var(--root-scale, 1));
	padding-top: calc(8px * var(--root-scale, 1));
	border-top: 1px token(kryon-divider);
}
.mhk-stepper {
	display: flex;
	flex-direction: row;
	align-items: center;
	height: calc(28px * var(--root-scale, 1));
	padding: 0 calc(6px * var(--root-scale, 1)) 0 calc(8px * var(--root-scale, 1));
	border: 1px token(kryon-tab-idle-border);
	border-radius: calc(token(radius-md)px * var(--root-scale, 1));
	background-color: rgba(0, 0, 0, 110);
}
.mhk-stepper-label { margin-right: calc(6px * var(--root-scale, 1)); font-size: calc(11px * var(--root-scale, 1)); color: token(kryon-label); }
.mhk-step {
	width: calc(18px * var(--root-scale, 1));
	height: calc(18px * var(--root-scale, 1));
	line-height: calc(16px * var(--root-scale, 1));
	text-align: center;
	color: token(kryon-tab-text);
	background-color: token(kryon-tab-idle);
	border: 1px token(kryon-tab-border);
	border-radius: calc(token(radius-sm)px * var(--root-scale, 1));
	cursor: pointer;
}
.mhk-step:hover { color: token(kryon-btn-text-hover); border-color: token(kryon-btn-border-hover); background-color: token(kryon-tab-bottom); }
.mhk-step-value { min-width: calc(20px * var(--root-scale, 1)); padding: 0 calc(4px * var(--root-scale, 1)); text-align: center; font-family: "token(font-title)"; font-size: calc(13px * var(--root-scale, 1)); color: token(kryon-btn-text); }
.mhk-step-pct { min-width: calc(36px * var(--root-scale, 1)); }

.mhk-potion.off .mhk-step, .mhk-potion.off .mhk-step-value, .mhk-potion.off .mhk-potion-icon { opacity: 0.4; }
.mhk-potion-icon { width: calc(18px * var(--root-scale, 1)); height: calc(18px * var(--root-scale, 1)); margin-right: calc(4px * var(--root-scale, 1)); decorator: image(icons/potion.tga contain); }
.mhk-switch {
	position: relative;
	width: calc(28px * var(--root-scale, 1));
	height: calc(14px * var(--root-scale, 1));
	margin-right: calc(6px * var(--root-scale, 1));
	border: 1px token(kryon-tab-idle-border);
	border-radius: calc(7px * var(--root-scale, 1));
	background-color: token(kryon-tab-idle);
	cursor: pointer;
}
.mhk-switch-knob { position: absolute; left: calc(1px * var(--root-scale, 1)); top: calc(1px * var(--root-scale, 1)); width: calc(10px * var(--root-scale, 1)); height: calc(10px * var(--root-scale, 1)); border-radius: calc(5px * var(--root-scale, 1)); background-color: token(kryon-tab-idle-text); }
.mhk-switch.on { border-color: token(kryon-mint-border); background-color: token(kryon-mint-wash); }
.mhk-switch.on .mhk-switch-knob { left: calc(15px * var(--root-scale, 1)); background-color: token(kryon-mint-accent); }

.mhk-actions { flex: 1 1 auto; display: flex; flex-direction: row; justify-content: flex-end; align-items: center; gap: calc(6px * var(--root-scale, 1)); }
