/* Modern theme for CJewelBankWindow: docked_panel_frame.rcss's forged panel (linked first), one row per
   jewel (name, stored amount, Deposit "+" and Withdraw "-"), and the wide Deposit all button. Geometry is
   reference px under the dock transform, in the 190 x 429 panel of the docked windows. The rows scroll
   when a server accepts more jewels than the ten that fit. */

#panel { pointer-events: auto; }

.sharp-text { display: block; position: absolute; white-space: nowrap; pointer-events: none; }

#jb_title { top: 13px; font-weight: bold; color: token(text-warm); }
#jb_hint { top: 36px; color: token(text-muted); }
#jb_unavailable { top: 180px; color: token(text-secondary); }

#jb_rows {
	position: absolute;
	left: 12px;
	top: 58px;
	width: 166px;
	height: 304px;
	overflow-y: auto;
	pointer-events: auto;
}

.jb-row {
	display: block;
	position: relative;
	width: 166px;
	height: 30px;
	border-bottom: 1px token(border-inner);
}
.jb-row:hover { background-color: token(surface-control); }

.jb-name { left: 6px; top: 3px; color: token(text-primary); }
.jb-amount { right: 56px; top: 15px; font-weight: bold; color: token(text-disabled); }
.jb-row.stored .jb-amount { color: token(accent-gold); }

.jb-btn {
	display: block;
	position: absolute;
	top: 4px;
	width: 22px;
	height: 22px;
	cursor: pointer;
	pointer-events: auto;
	background-color: token(surface-raised);
	border: 1px token(border-frame);
	border-radius: token(radius-sm)px;
}
.jb-btn:hover { border-color: token(border-hover); }
.jb-btn.locked { pointer-events: none; opacity: 0.4; }
.jb-deposit { left: 116px; }
.jb-withdraw { left: 141px; }
.jb-glyph { font-weight: bold; color: token(text-primary); }
.jb-btn:hover .jb-glyph { color: token(accent-gold-hover); }

.jb-wide-btn {
	display: block;
	position: absolute;
	left: 35px;
	top: 372px;
	width: 120px;
	height: 26px;
	cursor: pointer;
	pointer-events: auto;
	background-color: token(surface-raised);
	border: 1px token(border-frame);
	border-radius: token(radius-sm)px;
}
.jb-wide-btn:hover { border-color: token(border-hover); }
.jb-wide-btn.locked { pointer-events: none; opacity: 0.4; }
.jb-wide-label { font-weight: bold; color: token(text-primary); }
.jb-wide-btn:hover .jb-wide-label { color: token(accent-gold-hover); }

/* Lengths inside counter-scaled layers: reference px times the panel's --root-scale. */
.jb-name { width: calc(108px * var(--root-scale)); }
