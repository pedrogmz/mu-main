/* Generated by generate_theme.py: modern/event_timer.rcss retinted with tokens.json. */
/* Modern theme for the event time HUDs (CBloodCastle, CChaosCastleTime, CEmpireGuardianTimer):
   the modern panel surface instead of newui_Figure_blood, the legacy geometry and colours. */

body { pointer-events: none; }

.screen {
	position: absolute;
	left: 0;
	top: 0;
	width: 640px;
	height: 480px;
	transform-origin: left top;
	pointer-events: none;
}

#panel { position: absolute; width: 124px; height: 81px; font-family: "token(font-body)"; }
#back { position: absolute; left: 0; top: 0; width: 124px; height: 81px; background-color: token(surface-panel); border: 1px token(border-frame); }

.timer-text {
	display: block;
	position: absolute;
	left: 0;
	transform-origin: left top;
	white-space: nowrap;
	text-align: center;
}
#kills { top: 13px; }
#time_left { top: 38px; }
#time { top: 50px; font-weight: bold; }

.timer-text.plain { color: token(text-primary); }
.timer-text.standby { color: token(semantic-success); }
.timer-text.normal { color: token(accent-gold); }
.timer-text.closing { color: token(accent-gold-hover); }
.timer-text.imminent { color: token(semantic-danger); }
.timer-text.expiring { color: token(semantic-danger); }

/* Each line's box, in the panel's reference px, counter-scaled with the line: the frame's width,
   or the Imperial Guardian's 110 centred on it. */
.timer-text { --box-width: 124px; width: calc(var(--box-width) * var(--root-scale)); }
#panel.empire-guardian .timer-text { left: 7px; --box-width: 110px; }

/* The HUD takes no pointer events where it is placed (base.rcss gives a placed panel them). */
#panel.slot-placed { pointer-events: none; }

/* ---- handmade/shared/flat_card.rcss: the Kryon look, appended so it wins by source order. ---- */
/* Kryon card for the small windows modern draws as a flat box (surface-panel fill, one border-frame
   line): event entries and timers, Kanturu, Cursed Temple, duel, quick command, window menu, message
   boxes, the in-game shop's frames... The rule's selector is filled in per stylesheet from
   tokens.json's handmadeShared. Sizes are px: these panels scale themselves. */

#back {
	background-color: token(kryon-card-bottom);
	decorator:
		radial-gradient(circle at 50% 0%, token(kryon-card-glow), transparent 55%),
		linear-gradient(110deg, token(kryon-card-top) 0%, token(kryon-card-mid) 50%, token(kryon-card-bottom) 100%);
	border-width: 1px;
	border-color: token(kryon-card-border);
	border-radius: token(radius-md)px;
	box-shadow:
		0 0 0 2px token(kryon-ring-outer),
		0 0 0 3px token(kryon-ring-gold),
		0 10px 28px rgba(0, 0, 0, 170),
		inset 0 0 0 3px token(kryon-ring-inner-dark),
		inset 0 0 0 4px token(kryon-filete);
}
