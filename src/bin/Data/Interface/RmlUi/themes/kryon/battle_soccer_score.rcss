/* Generated by generate_theme.py: modern/battle_soccer_score.rcss retinted with tokens.json. */
/* Modern theme for CBattleSoccerScore: the same two lines at the original's place above the bottom
   HUD's right end, on the modern panel surface instead of the figure-ground art (geometry as the
   legacy theme, see battle_soccer_score.rml). */


body { pointer-events: none; }

.screen {
	position: absolute;
	left: 0;
	top: 0;
	width: 640px;
	height: 480px;
	transform-origin: left top;
	pointer-events: none;
}

#panel { position: absolute; width: 131px; height: 70px; font-family: "token(font-body)"; background-color: token(surface-panel); border: 1px token(border-frame); }
#back { display: none; }

.team { display: block; position: absolute; left: 30px; width: 100px; height: 8px; }
.team-text {
	display: block;
	position: absolute;
	top: 0;
	transform-origin: left top;
	white-space: nowrap;
	font-weight: bold;
	color: #0096ff;
	background-color: #00000080;
}
.team.red .team-text { color: #ff3c00; }
.team-score { left: 0; }
.team-name { left: 33px; }

.mark { position: absolute; left: 21px; top: 0; width: 8px; height: 8px; }
.mark-cell { display: block; float: left; width: 1px; height: 1px; }

/* RenderContents()'s own two rows. The container takes no space. */
.teams { position: static; }
.team:nth-child(1) { top: 33px; }
.team:nth-child(2) { top: 55px; }

/* The HUD takes no pointer events where it is placed (base.rcss gives a placed panel them). */
#panel.slot-placed { pointer-events: none; }

/* ---- handmade/shared/flat_card.rcss: the Kryon look, appended so it wins by source order. ---- */
/* Kryon card for the small windows modern draws as a flat box (surface-panel fill, one border-frame
   line): event entries and timers, Kanturu, Cursed Temple, duel, quick command, window menu, message
   boxes, the in-game shop's frames... The rule's selector is filled in per stylesheet from
   tokens.json's handmadeShared. Sizes are px: these panels scale themselves. */

#panel {
	background-color: token(kryon-card-bottom);
	decorator:
		radial-gradient(circle at 50% 0%, token(kryon-card-glow), transparent 55%),
		linear-gradient(110deg, token(kryon-card-top) 0%, token(kryon-card-mid) 50%, token(kryon-card-bottom) 100%);
	border-width: 1px;
	border-color: token(kryon-card-border);
	border-radius: token(radius-md)px;
	box-shadow:
		0 0 0 2px token(kryon-ring-outer),
		0 0 0 3px token(kryon-ring-gold),
		0 10px 28px rgba(0, 0, 0, 170),
		inset 0 0 0 3px token(kryon-ring-inner-dark),
		inset 0 0 0 4px token(kryon-filete);
}
