/* Generated by generate_theme.py: modern/base.rcss retinted with tokens.json. */
/* Shared, cross-window RCSS for the modern theme: generic (non-positional) rules reused by more
   than one migrated window, plus the anchor/center/stretch layout utility classes every window
   uses. Every migrated window's <head> links this file first, then its own per-window positional
   .rcss.

   Second generation: blackened iron / dark forged metal. Colors/borders below are named against
   this theme's design-token table -- keep the trailing token-name comment next to each value;
   that table is the source of truth.

   Depth primitives (.modern-frame/.modern-panel/.modern-inset, .btn/.checkbox-box below) simulate
   raised/recessed surfaces using per-side border-color bevels plus `decorator:
   linear-gradient(...)`. Light source is fixed upper-left: a RAISED surface gets a lighter
   top/left border/gradient corner, darker bottom/right; a RECESSED surface inverts both. Never
   mix the two directions on one element.

   Real `box-shadow` (inset/outset, blur, multiple shadows) is supported by this renderer and used
   directly for shadow/glow effects a border color can't express; the per-side bevel technique
   stays the right tool for a surface's own edge. Engine note: this engine's rgba() parses alpha
   as a 0-255 integer, not a 0-1 CSS float -- every box-shadow color below is pre-converted to the
   0-255 form. */

body {
	width: 100%;
	height: 100%;
	margin: 0;
	pointer-events: none;
	/* A panel's scale before anything places it; a placed panel sets its own. */
	--root-scale: 1;
}

/* Full-screen dim overlay for modal-style windows (SysMenuWin/OptionWin). */
#backdrop {
	position: absolute;
	left: 0;
	top: 0;
	width: 100%;
	height: 100%;
	background-color: token(surface-backdrop);
	pointer-events: auto;
}

/* Server-selection controls use the character choices' neutral iron and gold selection
   treatment. The consuming document owns dimensions, alignment and population gauges. */
.server-group-btn, .server-option-btn {
	cursor: pointer;
	pointer-events: auto;
	color: token(text-secondary);
	background-color: #0f1114;
	decorator: linear-gradient(to bottom, rgba(255, 255, 255, 8), transparent 40%),
		linear-gradient(to bottom, #161a1f, #0b0d10 58%, #070809);
	border: 1px token(border-frame);
	border-radius: token(radius-sm)px;
	font-family: "token(font-body)";
}
.server-group-btn:hover, .server-option-btn:hover {
	color: token(accent-gold-hover);
	border-color: token(border-hover);
}
.server-group-btn:active, .server-option-btn:active {
	box-shadow: inset 0 1px 3px rgba(0, 0, 0, 184);
}
.server-group-btn.checked {
	color: token(text-warm);
	border-color: token(accent-gold-hover);
	background-color: #241c0d;
	box-shadow: inset 2px 0 0 token(accent-gold-hover);
}
.server-option-btn {
	color: token(server-button);
}
.server-option-btn.gray {
	color: token(server-button-gray);
}
.server-option-btn.gray:hover {
	color: token(text-primary);
}
.server-option-btn.orange {
	color: token(server-button-orange);
}
.server-option-btn.orange:hover {
	color: token(accent-gold-hover);
}
/* A VIP type with the theme color "silver" (Data/Local/ServerList.json). */
.server-option-btn.silver {
	color: token(server-button-silver);
}
.server-option-btn.silver:hover {
	color: #e0d2b6;
}
.server-group-btn:active .button-label, .server-option-btn:active .button-label {
	transform: translateY(1px);
}

.checkbox-row {
	position: absolute;
	cursor: pointer;
	pointer-events: auto;
}
/* Small recessed control whose gold indicates checked state, not the theme's general-purpose
   accent-gold token (noticeably brighter/more saturated than this control's own tone). No
   decorator/bevel on the unchecked state -- flat by design. */
.checkbox-box {
	display: inline-block;
	width: 12dp;
	height: 12dp;
	background-color: #0b0c0e;
	border-width: 1dp;
	border-color: #6f5a34;
	border-radius: token(radius-sm)dp;
	box-shadow: inset 0 1dp 2dp rgba(0, 0, 0, 140);
}
.checkbox-box.checked {
	background-color: #8f6922;
	decorator: linear-gradient(to bottom, #d3a44e, #8f6922);
	border-color: #aa8032;
}
.checkbox-label {
	position: absolute;
	left: 18dp; /* 12dp box + reference's own 6px flex gap */
	top: 0;
	white-space: nowrap;
	font-family: "token(font-body)";
	font-size: 9dp;
	color: token(text-secondary);
}

/* Flat dark-iron fill with a visible metal-frame border -- steel is the general interactive
   accent (hover/focus), gold is reserved for selected-state/text emphasis, never general button
   chrome. Per-side border bevel (light top/left, dark bottom/right) is the same "raised surface"
   language .modern-frame uses -- a single uniform border-color would read as a web button, not a
   forged-metal one. Shared by every .btn consumer (sys_menu, msg_win, remember_password_prompt,
   char_make, char_sel_main, credit_win, mu_helper_bar, my_quest_info, server_select, login). */
.btn {
	position: absolute;
	width: 108dp;
	height: 30dp;
	text-align: center;
	vertical-align: middle;
	line-height: 30dp;
	cursor: pointer;
	font-family: "token(font-body)";
	font-size: 9dp;
	letter-spacing: 0.18dp;
	color: #d1bc93;
	background-color: #0f1114;
	decorator: linear-gradient(to bottom,
		rgba(255, 255, 255, 10),
		transparent 45%),
		linear-gradient(to bottom, #1c2127, #0f1114 58%, #080a0c);
	border-width: 1dp;
	border-color: #6c5733;
	border-radius: token(radius-sm)dp;
	pointer-events: auto;
	box-shadow:
		inset 0 1dp 0 rgba(232, 210, 168, 14),
		inset 0 -1dp 0 #000000,
		0 1dp 2dp rgba(0, 0, 0, 153);
}
.btn:hover {
	color: #e0bb76;
	border-color: #776646;
	decorator: linear-gradient(to bottom,
		rgba(255, 255, 255, 13),
		transparent 45%),
		linear-gradient(to bottom, #21272e, #101317 58%, #090a0c);
}
.btn:active {
	/* Real 1dp downward shift plus one inset shadow. Native :active pseudo-class -- unverified
	   against this branch's own mouse-input routing, but degrades gracefully if it never fires. */
	transform: translateY(1dp);
	box-shadow: inset 0 1dp 3dp rgba(0, 0, 0, 184);
}
.btn.disabled {
	pointer-events: none;
	background-color: #080a0c;
	color: token(semantic-neutral);
	border-color: rgba(107, 86, 50, 60); /* metal-mid's rgb @ 60 alpha, stays neutral when disabled, no gold */
	opacity: 0.55;
	cursor: default;
}

/* Opt-in primary/hero variant -- apply alongside .btn (class="btn btn-ok") for a window's one
   confirm-style action; plain .btn stays flat/neutral for a list of equal-weight actions (e.g.
   sys_menu.rcss's four stacked buttons). Overrides only color properties, not layout. Must stay
   textually after .btn/.btn:hover/.btn:active (equal specificity once combined on one element,
   so source order decides). */
.btn-ok {
	color: #e5b55c;
	background-color: #392a15;
	decorator: linear-gradient(to bottom,
		rgba(255, 219, 151, 18),
		transparent 38%),
		linear-gradient(to bottom, #6d5128, #392a15 58%, #1a1309);
	border-color: #886632;
	box-shadow:
		inset 0 1dp 0 rgba(255, 221, 159, 23),
		inset 0 -1dp 0 #090201,
		0 2dp 5dp rgba(0, 0, 0, 128);
}
.btn-ok:hover {
	decorator: linear-gradient(to bottom,
		rgba(255, 219, 151, 26),
		transparent 38%),
		linear-gradient(to bottom, #836231, #47351a 58%, #20180c);
	border-color: #b18441;
}
/* No :active override -- the reference gives .btn-primary no separate pressed state either; the
   generic .btn:active above applies uniformly to both variants, matching its actual cascade. */
.btn-ok.disabled {
	/* Resets decorator/box-shadow to neutral -- two classes here outrank .btn-ok's one-class
	   declarations on specificity, so without this the crimson gradient/shadow would paint over
	   the disabled neutral fill. */
	decorator: none;
	box-shadow: none;
}

/* Shared icon-only button -- carved-iron FAB look, same gradient/shadow recipe as .btn/.btn-ok
   above.

   position:absolute against #panel directly, not nested in a positioned wrapper -- nesting under
   a bottom/right-anchored wrapper made buttons vanish entirely on this engine. */
.btn-icon {
	position: absolute;
	width: 54dp;
	height: 30dp;
	cursor: pointer;
	pointer-events: auto;
	text-align: center;
	line-height: 30dp;
	color: token(text-secondary);
	background-color: #0f1114;
	decorator: linear-gradient(to bottom,
		rgba(255, 255, 255, 11),
		transparent 40%),
		linear-gradient(to bottom, #1c2127, #101215 56%, #08090a);
	border: 1dp token(border-frame);
	border-radius: token(radius-sm)dp;
	box-shadow:
		0 2dp 5dp rgba(0, 0, 0, 133),
		inset 0 1dp 0 rgba(232, 210, 168, 18),
		inset 0 -1dp 0 #000000;
}
.btn-icon:hover {
	color: token(accent-gold-hover);
	border-color: token(border-hover);
	decorator: linear-gradient(to bottom,
		rgba(255, 255, 255, 15),
		transparent 40%),
		linear-gradient(to bottom, #21272e, #101317 56%, #090a0c);
	box-shadow:
		0 3dp 6dp rgba(0, 0, 0, 143),
		inset 0 1dp 0 rgba(224, 187, 118, 28),
		inset 0 -1dp 0 #000000;
}
.btn-icon:active {
	transform: translateY(1dp);
	background-color: #080a0c;
	decorator: none;
	box-shadow: inset 0 2dp 5dp rgba(0, 0, 0, 199);
}
/* background-color is a solid dark neutral, not token(surface-control) -- that token is already
   near-transparent, and combined with opacity:0.5 the button read as completely gone rather than
   dimmed. A solid fill dimmed by opacity reads as "disabled," not "absent." */
.btn-icon.disabled {
	pointer-events: none;
	opacity: 0.55;
	cursor: default;
	color: token(text-secondary);
	decorator: none;
	background-color: #080a0c;
	border: 1dp token(border-frame);
	box-shadow: none;
}
/* Opt-in hero variant for a bar's one primary action (e.g. Menu) -- same .btn-ok convention as
   above: add alongside .btn-icon, overrides only color properties. */
.btn-icon-primary {
	color: token(text-warm);
	background-color: #302412;
	decorator: linear-gradient(to bottom,
		rgba(255, 219, 151, 18),
		transparent 36%),
		linear-gradient(to bottom, #523d1e, #302412 58%, #151008);
	border-color: #886632;
	box-shadow:
		0 2dp 5dp rgba(0, 0, 0, 133),
		inset 0 1dp 0 rgba(255, 221, 159, 20),
		inset 0 -1dp 0 #090201;
}
.btn-icon-primary:hover {
	color: token(accent-gold-hover);
	border-color: #b18441;
	decorator: linear-gradient(to bottom,
		rgba(255, 219, 151, 26),
		transparent 36%),
		linear-gradient(to bottom, #6d5128, #392a15 58%, #1a1309);
}
/* font-family/size often need redeclaring directly on the label span -- inheritance from a
   data-model-bound ancestor silently fails for text in this RmlUi build.
   DejaVu Sans, not token(font-body)/Liberation Sans -- these labels are Unicode glyphs and
   Liberation Sans's cmap only covers one of them. RmlUi has no per-glyph fallback across loaded
   faces (only a single whole-family fallback_face), so this can't be split per-character within
   one font-family. */
.btn-icon-label {
	color: token(text-primary);
	font-weight: bold;
	font-family: "DejaVu Sans";
}
.btn-icon-primary .btn-icon-label {
	color: token(text-warm);
}
.btn-icon.disabled .btn-icon-label {
	color: token(text-disabled);
}

/* .btn-icon-item (the wrapper markup in login_main.rml/char_sel_main.rml) is deliberately
   unstyled -- no CSS rule, position:static by default. .btn-icon/.btn-icon-caption both resolve
   position:absolute directly against #panel, one level only (see .btn-icon's own comment). */
.btn-icon-caption {
	position: absolute;
	width: 72dp;
	line-height: 12dp;
	text-align: center;
	font-size: 9dp;
	color: token(text-secondary);
	font-family: "token(font-body)";
	white-space: nowrap;
}

/* Reusable window-layering primitives. Usage: apply .modern-frame to the outer positioned panel
   element itself (keeps its position/size), then add ONE decorative child div with .modern-panel,
   inset a few px on all sides, as the FIRST child (so it paints behind real content) -- the small
   reveal between the frame's inner edge and the panel's border is deliberate, a third visual band
   of the frame's own material. Real content stays a direct child of .modern-frame at its original
   position -- do NOT nest content inside .modern-panel, its inset would shift every child.

   This engine has no CSS variable mechanism, so a shared class can only carry structural
   properties portably; a window's own palette comes from a *named palette variant* modifier class
   (e.g. .modern-frame-crimson below) applied alongside the base class
   (class="modern-frame modern-frame-crimson") -- the variant only overrides color/decorator,
   .modern-frame's own border-width/mechanism still applies underneath. Position/size stay the
   consuming window's own responsibility either way. */
.modern-frame {
	background-color: rgba(14, 17, 20, 196); /* surface-panel's rgb @ 196 alpha -- can't use token(surface-panel) directly, it has no alpha channel of its own */
	decorator: linear-gradient(to bottom, rgba(26, 31, 37, 196) 0%, rgba(14, 17, 20, 196) 45%, rgba(8, 9, 10, 196) 100%);
	border-width: 2dp;
	border-top-color: rgba(153, 123, 72, 160); /* metal-edge's rgb @ 160 alpha: bevel-light, brighter than the fill for a real edge-catch */
	border-left-color: rgba(153, 123, 72, 160);
	border-bottom-color: rgba(0, 0, 0, 190); /* bevel-dark */
	border-right-color: rgba(0, 0, 0, 190);
}
.modern-panel {
	position: absolute;
	left: 4dp;
	right: 4dp;
	top: 4dp;
	bottom: 4dp;
	pointer-events: none;
	background-color: token(surface-recessed);
	decorator: linear-gradient(to bottom, rgba(12, 14, 17, 180) 0%, rgba(6, 7, 9, 180) 100%);
	border-width: 1dp;
	border-color: token(border-inner); /* the recessed content-well border this token exists for */
	border-top-color: rgba(0, 0, 0, 160); /* bevel-dark-inset: recessed relative to the frame */
	border-left-color: rgba(0, 0, 0, 160);
	border-bottom-color: rgba(146, 118, 69, 20); /* metal-warm-edge's rgb @ 20 alpha: bevel-light-inset, a faint warm catch */
	border-right-color: rgba(146, 118, 69, 20);
	border-radius: token(radius-md)dp;
}

/* Palette variant for the "real dialog" family (login/msg_win/my_quest_info/sys_menu/
   remember_password_prompt). Apply alongside .modern-frame/.modern-panel
   (class="modern-frame modern-frame-crimson"), not instead of them. Despite the name this isn't
   crimson itself (that's accent-crimson) -- it's a marginally warmer, slightly darker iron than
   plain .modern-frame; only title/label text and the checkbox go warm/gold. */
.modern-frame-crimson {
	background-color: #0b0d10;
	decorator: linear-gradient(to bottom, #14171c, #0b0d10 30%, #070809);
	border-top-color: rgba(146, 118, 69, 90); /* metal-warm-edge's rgb @ 90 alpha: a warm iron highlight catching the top edge */
	border-left-color: rgba(0, 0, 0, 160);
	border-right-color: rgba(0, 0, 0, 160);
	border-bottom-color: rgba(0, 0, 0, 220);
}
.modern-panel-crimson {
	background-color: #080a0c;
	decorator: linear-gradient(to bottom, #0e1114, #080a0c 55%, #050608);
	border-top-color: rgba(146, 118, 69, 45); /* metal-warm-edge's rgb @ 45 alpha */
	border-bottom-color: rgba(0, 0, 0, 240);
	border-left-color: #050505;
	border-right-color: #050505;
}

/* Thin accent line just inside .modern-frame -- border only, no fill, so the frame's own gradient
   still shows through. Apply as a direct child of .modern-frame, inset a few px more than
   .modern-panel (a fourth visual band, not a replacement for the frame/panel pair).
   Position/size stay the consuming window's own responsibility. */
.modern-frame-accent {
	position: absolute;
	pointer-events: none;
	border-width: 1dp;
}
.modern-frame-accent-crimson {
	border-color: rgba(107, 86, 50, 166); /* metal-mid's rgb @ 166 alpha */
	border-top-color: token(accent-steel-hover);
	border-bottom-color: rgba(0, 0, 0, 200);
}

/* Raised header/footer bands -- overlay bands painted after .modern-panel (not a repositioning of
   it), so title text/labels/buttons stay exactly where they are while a raised band draws across
   the top/bottom of the surface. Apply as a direct child of .modern-frame, sized by the consuming
   window. left/right/top default to the same 4dp inset as .modern-panel/.modern-frame-accent, not
   flush with .modern-frame's own edge (0/0) -- flush would paint over the frame's 2dp bevel
   border. A window can widen it back to 0/0 locally if it wants the header to reach the edge. */
.modern-header {
	position: absolute;
	left: 4dp;
	right: 4dp;
	top: 4dp;
	pointer-events: none;
	background-color: #121519;
	decorator: linear-gradient(to bottom, #1b2026 0%, #121519 45%, #0b0d10 100%);
	border-bottom-width: 1dp;
	border-bottom-color: #000000;
}
/* Small round metal stud straddling the header's top edge, centered via width/height/margin-left
   (no transform needed). border-radius is a fixed dp value equal to half width/height, not 50% --
   this engine's border-radius only accepts a length (px/dp), not a percentage. */
.modern-header-rivet {
	position: absolute;
	left: 50%;
	top: -4dp;
	width: 8dp;
	height: 8dp;
	margin-left: -4dp;
	pointer-events: none;
	background-color: #0a0c0e;
	decorator: radial-gradient(circle, #927645 0%, #0a0c0e 75%);
	border: 1dp #6a5632;
	border-radius: 4dp;
}
.modern-footer {
	position: absolute;
	left: 0;
	right: 0;
	bottom: 0;
	pointer-events: none;
	border-top-width: 1dp;
	border-top-color: #1d2127;
}

/* Border-only recessed bevel, no fill -- for an element with legacy-drawn content underneath it
   (RmlUi always composites last, so any fill here would hide that content). */
.modern-inset {
	border-width: 1dp;
	border-top-color: rgba(0, 0, 0, 190); /* bevel-dark-inset */
	border-left-color: rgba(0, 0, 0, 190);
	border-bottom-color: rgba(255, 255, 255, 30); /* bevel-light-inset */
	border-right-color: rgba(255, 255, 255, 30);
}
.modern-inset.focused {
	border-top-color: token(accent-steel);
	border-left-color: rgba(185, 156, 106, 170); /* accent-steel's rgb @ 170 alpha */
}

/* Reusable "fading crimson banner" -- a soft ambient radial glow meant to sit behind a window's
   title text (warm-cream core cooling to a muted crimson ring, fading to transparent). Position/
   size stay the consuming window's own responsibility; place it as a sibling BEFORE the title
   text it sits behind (RmlUi paints earlier siblings first). */
.title-glow {
	position: absolute;
	pointer-events: none;
	decorator: radial-gradient(ellipse, rgba(230, 199, 140, 110), rgba(128, 96, 47, 130) 55%, transparent 88%);
}

/* Shared item-slot primitives -- generalized from main_frame.rcss's .slot-frame/.slot-fill/
   .selected so any future slot-based UI has a ready-made look. main_frame.rcss keeps its own
   class names (bound from C++/RML) but is retinted to match these exactly. */
.slot {
	border: 1dp token(border-frame);
	border-radius: token(radius-sm)dp;
}
.slot--filled {
	background-color: rgba(8, 10, 12, 150); /* dark backing, matches main_frame.rcss's existing .slot-fill convention -- not surface-control, that token is for a resting icon-button's light wash, the opposite direction */
}
.slot--selected {
	border-color: token(border-selected);
	background-color: rgba(180, 134, 50, 25); /* border-selected's rgb @ 25 alpha wash */
}

/* Shared editable-text primitive for stock RmlUi <input type="text"/"password"> -- the same tier as
   .btn/.checkbox-* above. Owns appearance only (typography, fill, border, states); every consumer
   supplies its own position/size through a local class, since no two fields share a box. Length
   limits and value validation stay in C++ (the owning window sets maxlength and decides what a
   valid value is) -- this layer only reflects the outcome, via .error below. */
.text-field {
	box-sizing: border-box;
	cursor: text;
	pointer-events: auto;
	text-align: left;
	color: token(text-primary);
	background-color: token(metal-dark);
	decorator: linear-gradient(to bottom, rgba(0, 0, 0, 140), rgba(0, 0, 0, 60));
	border: 1px token(border-frame);
	border-radius: token(radius-sm)px;
	box-shadow: inset 0 1px 3px rgba(0, 0, 0, 200);
}
/* No :focus rule on purpose -- the native fields these replaced drew no focus outline, so the blinking
   caret stays the only focus cue. Add one per consumer if a screen ever wants it. */
/* Semantic state pushed from the model (data-class-error), never a colour set from C++. */
.text-field.error {
	border-color: token(semantic-danger);
	color: token(semantic-danger);
}
.text-field:disabled {
	pointer-events: none;
	color: token(text-disabled);
	background-color: token(surface-recessed);
	decorator: none;
}
/* RmlUi styles the selection range through the widget's own <selection> child element, which reads
   exactly these two properties (ElementTextSelection::OnPropertyChange). */
.text-field selection {
	color: token(metal-dark);
	background-color: token(accent-gold);
}

/* A label kept to one line in a constricted box -- see legacy/base.rcss's copy. */
.marquee { display: block; white-space: nowrap; overflow: hidden; }
.marquee.marquee-overflow { text-align: left; }

/* Scrolling content pane -- see legacy/base.rcss's copy for the two engine requirements baked in
   here (the `hidden auto` shorthand order, and why pointer-events must be opted back in). The
   container half is identical in both themes by design; only the scrollbar chrome below differs.

   The pane needs a bounded height to scroll within (explicit height, max-height, or a stretched
   flex child) -- the consumer's own layout, deliberately not set here. */
.scroll-pane {
	overflow: hidden auto;
	pointer-events: auto;
}

/* Flat rail in the metal-rail palette rather than the gold accent, tying the scrollbar to the
   header hardware -- where legacy uses native's real sprite art, this theme states the same
   affordance in its own language. */
.scroll-pane scrollbarvertical {
	width: 8dp;
	margin: 0;
}
.scroll-pane scrollbarvertical slidertrack {
	background-color: token(metal-rail-dark);
}
.scroll-pane scrollbarvertical sliderbar {
	background-color: token(metal-edge);
	border-radius: token(radius-sm)px;
}
.scroll-pane scrollbarvertical sliderbar:hover,
.scroll-pane scrollbarvertical sliderbar:active {
	background-color: token(metal-highlight);
}
/* Drag-only, matching legacy -- native has no arrow buttons on this scrollbar. */
.scroll-pane scrollbarvertical sliderarrowdec,
.scroll-pane scrollbarvertical sliderarrowinc {
	width: 0;
	height: 0;
}
.scroll-pane scrollbarhorizontal {
	height: 0;
}

.hidden {
	display: none;
}

/* Layout primitives -- identical to
   themes/legacy/base.rcss's copy; pure layout, nothing theme-specific to vary. */

/* Text drawn sharp inside a panel scaled by transform: scale(root_scale) -- see legacy base.rcss's
   copy for the full explanation. */
.sharp-text, .counter-scaled { transform: scale(calc(1 / var(--root-scale, 1))); }
/* Under a per-axis stretch (a Hud layout's #screen): it cancels --root-scale-y vertically. */
.counter-scaled-xy { transform: scale(calc(1 / var(--root-scale, 1)), calc(1 / var(--root-scale-y, 1))); }
.sharp-text { transform-origin: left top; }
.sharp-text.sharp-right { transform-origin: right top; }
/* A one-line layer centred on its box's height (a button's label): its middle sits on top: 50% at
   any panel scale. */
.sharp-text.sharp-middle { top: 50%; transform-origin: left center; transform: translateY(-50%) scale(calc(1 / var(--root-scale, 1))); }
.sharp-text.sharp-right.sharp-middle { transform-origin: right center; }
/* A layer centred on its parent's width (the parent is the box the theme sizes and places): wide
   enough that its text never overflows, which would start-align it, and scaled back around its
   centre, so the text stays centred on the box at any panel scale. */
.sharp-text.sharp-centre { left: 50%; width: 2000px; margin-left: -1000px; text-align: center; transform-origin: center top; }
.sharp-text.sharp-centre.sharp-middle { transform-origin: center center; }
/* Text that stacks: one counter-scaled layer whose lines flow inside it at the native size, so
   C++ hands out no tops. The theme sizes it in reference px through --flow-w (and --flow-h for
   .centred); everything inside is physical px. .centred centres the lines on the box's height,
   however many there are. */
.sharp-text.sharp-flow { width: calc(var(--flow-w, 0px) * var(--root-scale, 1)); }
.sharp-text.sharp-flow.centred {
	height: calc(var(--flow-h, 0px) * var(--root-scale, 1));
	display: flex;
	flex-direction: column;
	justify-content: center;
}

.anchor-top-left {
	position: absolute;
	left: 0;
	top: 0;
}
.anchor-top-right {
	position: absolute;
	right: 0;
	top: 0;
}
.anchor-bottom-left {
	position: absolute;
	left: 0;
	bottom: 0;
}
.anchor-bottom-right {
	position: absolute;
	right: 0;
	bottom: 0;
}

.center-x {
	position: absolute;
	left: 50%;
	transform: translateX(-50%);
}
.center-y {
	position: absolute;
	top: 50%;
	transform: translateY(-50%);
}
/* A press on a control never drags the window around it: RmlUi starts a drag from the nearest
   ancestor with `drag` set, and the control's click would still fire on release. */
input, select, textarea, .btn, [data-event-click] { drag: block; }
/* The original 640x480 screen, at a scale composed from the scale inputs (RmlScaleInputs.h): a
   .stage is centred on the window at the UI scale, as the original centred its NPC panels and
   dialogs; a .hud-board stands on the window's bottom, centred like the HUD, at the HUD's scale.
   Children lay out in its reference px, and --root-scale is its scale. */
.stage, .hud-board { position: absolute; left: 50%; width: 640px; height: 480px; margin-left: -320px; }
.stage { top: 50%; margin-top: -240px; transform-origin: center; transform: scale(var(--ui-scale));
         --root-scale: var(--ui-scale); }
.hud-board { bottom: 0; transform-origin: center bottom; transform: scale(var(--hud-scale));
             --root-scale: var(--hud-scale); }
/* A panel a workspace slot places (CObject::GetPlacedDocument()): the slot's top-left and its
   region's scale arrive as variables; the theme decides how they apply. It takes the pointer, so
   clicks on it never reach the world or the windows below. */
#panel.slot-placed, #content_root.slot-placed {
	pointer-events: auto;
	transform-origin: left top;
	left: var(--slot-left);
	top: var(--slot-top);
	transform: scale(var(--root-scale));
}
/* A centred panel the player dragged: left/top place it (UI::RmlBridge::MakeDraggable()). */
.center-both.dragged { transform: none; }

.center-both {
	position: absolute;
	left: 50%;
	top: 50%;
	transform: translate(-50%, -50%);
}

.stretch-x {
	position: absolute;
	left: 0;
	right: 0;
}
.stretch-y {
	position: absolute;
	top: 0;
	bottom: 0;
}
.stretch-both {
	position: absolute;
	left: 0;
	right: 0;
	top: 0;
	bottom: 0;
}

/* Invisible marker read by C++ via Element::GetAbsoluteOffset() -- see themes/legacy/base.rcss's
   identical comment for the full mechanism. */
.layout-anchor {
	position: absolute;
	visibility: hidden;
	width: 0;
	height: 0;
	pointer-events: none;
}

/* ============================================================================
   Forged-dialog construction
   ----------------------------------------------------------------------------
   Structural counterpart to the palette tokens above. Explicit RML layers +
   per-side bevel borders rather than box-shadow. The login dialog is the
   first consumer.
   ============================================================================ */

/* Exterior silhouette / asymmetric perimeter. Put this as the first child of a positioned
   .modern-frame; it creates the dark outer edge a browser would express with an outside
   pseudo-element/shadow. Transparent fill -- a solid fill here would read as a second opaque
   rectangle behind the window surface instead of a thin edge. Highlight alphas are boosted well
   past a literal browser conversion, which reads as invisible over a real 3D game scene. */
.modern-shell-edge {
	position: absolute;
	left: -3dp;
	right: -3dp;
	top: -3dp;
	bottom: -3dp;
	pointer-events: none;
	background-color: transparent;
	border-radius: token(radius-sm)dp;
	border-width: 1dp;
	border-color: rgba(24, 28, 33, 242);
	box-shadow:
		inset 1dp 0 0 rgba(178, 146, 92, 110),
		inset -1dp 0 0 rgba(0, 0, 0, 204),
		inset 0 1dp 0 rgba(190, 163, 117, 90),
		inset 0 -1dp 0 rgba(0, 0, 0, 230);
}

/* Inner groove, ~4dp inward -- counterpart to .modern-shell-edge above: a thin warm hairline
   catch plus a broad inward darkness, which is what sells the recessed/carved look. */
.modern-groove {
	position: absolute;
	left: 4dp;
	right: 4dp;
	top: 4dp;
	bottom: 4dp;
	pointer-events: none;
	border-width: 1dp;
	border-color: #1d2228;
	box-shadow:
		inset 0 0 0 1dp rgba(169, 136, 80, 40),
		inset 0 0 12dp rgba(0, 0, 0, 153);
}

/* Visible-width blackened-iron rail -- metal header with ONE center rivet (.modern-joint below),
   the alternative to .modern-title-plate's crimson hero-banner (never both on the same window).
   box-shadow's inset pair is the header's top catch-light/bottom seat; the outset pair is the
   cast shadow proving this rail sits above whatever's below it. */
.modern-header-rail {
	position: absolute;
	left: 8dp;
	right: 8dp;
	top: 7dp;
	height: 38dp;
	pointer-events: none;
	background-color: token(metal-dark);
	decorator:
		linear-gradient(to bottom, rgba(205, 178, 129, 13), transparent 31%),
		linear-gradient(to bottom, token(metal-rail), #121519 45%, token(metal-rail-dark));
	border-width: 1dp;
	border-color: token(border-rail);
	border-bottom-color: #121518;
	box-shadow:
		inset 0 1dp 0 rgba(235, 212, 169, 18),
		inset 0 -1dp 0 #000000,
		0 2dp 4dp rgba(0, 0, 0, 133);
}

/* Subtle horizontal warm accent line near the rail's bottom edge -- purely decorative, painted as
   the rail's last child so it sits on top of the rail's fill. */
.modern-header-accent {
	position: absolute;
	left: 7dp;
	right: 7dp;
	bottom: 2dp;
	height: 1dp;
	pointer-events: none;
	opacity: 0.35;
	decorator: linear-gradient(to right,
		transparent,
		token(metal-warm-edge) 30%,
		#84714e 50%,
		token(metal-warm-edge) 70%,
		transparent);
}

/* Title text for .modern-header-rail. Vertically centered in the rail's 38dp height via
   top:50%/margin-top. Not used by Login (its header is the crimson hero-banner/
   .modern-title-plate, with the server name centered directly on the plate). */
.modern-header-text {
	position: absolute;
	left: 11dp;
	top: 50%;
	margin-top: -7dp;
	pointer-events: none;
}
/* Available for a future window that wants a small uppercase category label above the title --
   not consumed today. */
.modern-header-eyebrow {
	font-size: 7dp;
	color: #a4844d;
	font-family: "token(font-body)";
}
.modern-header-title {
	color: token(text-warm);
	font-family: "token(font-title)";
	font-size: 13dp;
	font-weight: 500;
	letter-spacing: 0.2dp;
	font-effect: shadow(0dp 1dp #000000);
}

/* Recessed body plane. Content belongs inside this element in RML. The broad inset box-shadow is
   what sells "physically recessed behind the frame" -- a border-color bevel alone is too thin an
   effect for a cavity this size. */
.modern-content-well {
	position: absolute;
	pointer-events: none;
	background-color: token(surface-recessed);
	decorator: linear-gradient(to bottom, #0a0c0e, #070809);
	border-width: 1dp;
	border-color: token(border-inner);
	box-shadow:
		inset 0 0 16dp rgba(0, 0, 0, 166),
		inset 0 1dp 0 rgba(255, 255, 255, 5);
}

/* A structural container for the action row, not a second boxed panel -- no fill, no border, no
   visual identity of its own; still a real element since it needs to hold the buttons. */
.modern-footer-band {
	position: absolute;
	pointer-events: none;
}

/* Physical crimson title plate -- this IS the hero-banner header for whichever window uses it
   (Login among them); a window uses this OR the metal .modern-header-rail/.modern-joint pair,
   never both. box-shadow's inset pair is the plate's top highlight/bottom seat; outset is the
   cast shadow proving it sits on/in whatever's behind it. */
.modern-title-plate {
	position: absolute;
	pointer-events: none;
	background-color: token(metal-title-face);
	decorator:
		linear-gradient(to bottom, rgba(255, 221, 158, 18), transparent 34%),
		linear-gradient(to bottom, #5b4422 0%, token(metal-title-face) 56%, token(metal-title-face-dark) 100%);
	border-width: 1dp;
	border-color: token(border-title);
	box-shadow:
		inset 0 1dp 0 rgba(255, 216, 145, 23),
		inset 0 -1dp 0 #080201,
		0 2dp 5dp rgba(0, 0, 0, 140);
}

/* Center-rivet stud for the METAL rail (.modern-header-rail, not .modern-title-plate) -- a real
   13x13 square rotated 45deg. Centered via left:50%/negative margin-left rather than
   `translateX(-50%) rotate(45deg)`, since combining calc()/translate with rotate in one
   declaration isn't verified on this engine. top:-8dp straddles the rail's top edge. */
.modern-joint {
	position: absolute;
	left: 50%;
	top: -8dp;
	width: 13dp;
	height: 13dp;
	margin-left: -6.5dp;
	pointer-events: none;
	background-color: token(metal-groove);
	border-width: 1dp;
	border-color: #6a5632;
	transform: rotate(45deg);
	box-shadow: inset 0 0 0 2dp #0a0c0e;
}

/* ============================================================================
   Header-rail family -- px companions for root_scale-driven windows
   ----------------------------------------------------------------------------
   RmlUi's `dp` unit is multiplied by the CONTEXT's density-independent-pixel
   ratio (Source/Core/ComputeProperty.cpp: `case Unit::DP: return value.number *
   dp_ratio;`), which RmlUiRuntime.cpp's ApplyUIScale() sets once per context
   from UIScalePercent x ViewportFitScale(). `px` is never touched by that
   ratio. That's the right (and only) scaling mechanism for a STATIC dialog
   like Login/SysMenu, whose entire panel is authored in `dp` with no other
   scaling involved.

   A MOVABLE window synced to a native/legacy-positioned counterpart (e.g.
   MyInventory, tracking the native paperdoll) instead scales its whole #panel
   via a CSS `transform: scale(root_scale)`, where root_scale comes from
   UI::Scaling::GetActiveTransform() -- a completely different number from the
   context's dp_ratio. Since `transform: scale()` scales its entire subtree
   regardless of each descendant's own units, a `dp` length in such a panel
   gets BOTH factors compounded (dp_ratio at layout, then root_scale again via
   the transform) while a `px` length only gets root_scale -- so the two units
   drift apart and a borrowed `dp` primitive renders at the wrong size
   relative to that window's own `px`-based geometry.

   These are the same primitives as their `dp` counterparts above --
   same property values, same token() color/gradient references (still fully
   shared: a tokens.ini palette edit repaints both variants) -- with every
   length re-expressed in `px` instead. Use these (never the `dp` originals)
   inside any window whose #panel carries a `transform: scale(root_scale)`;
   use the `dp` originals everywhere else. Keep both variants' property lists
   identical when editing one. */
/* Box only -- NOT painted here. This context renders dead last in the frame, after native
   Render3D(), so a painted rail would cover any 3D item that overflows its cell upward; the real
   fill/border/shadow/accent live in each window's own `*_bg.rcss` as `.rail-fill`/`.rail-accent`
   instead. This box just gives `.modern-header-text-px`'s `top:50%` a rect to resolve against. */
.modern-header-rail-px {
	position: absolute;
	left: 8px;
	right: 8px;
	top: 7px;
	height: 38px;
	pointer-events: none;
}
.modern-header-text-px {
	position: absolute;
	left: 11px;
	top: 50%;
	margin-top: -7px;
	pointer-events: none;
}
.modern-header-eyebrow-px {
	font-size: 7px;
	color: #a4844d;
	font-family: "token(font-body)";
}
.modern-header-title-px {
	color: token(text-warm);
	font-family: "token(font-title)";
	font-size: 13px;
	font-weight: 500;
	letter-spacing: 0.2px;
	font-effect: shadow(0px 1px #000000);
}
.modern-joint-px {
	position: absolute;
	left: 50%;
	top: -8px;
	width: 13px;
	height: 13px;
	margin-left: -6.5px;
	pointer-events: none;
	background-color: token(metal-groove);
	border-width: 1px;
	border-color: #6a5632;
	transform: rotate(45deg);
	box-shadow: inset 0 0 0 2px #0a0c0e;
}

/* ============================================================================
   Inventory-family window chrome -- px companions
   ----------------------------------------------------------------------------
   Generalized from my_inventory.rcss's .inv-btn/.inv-wallet family (first
   consumer: CMyInventory) for reuse by every other CInventoryCtrl-owning
   window (Trade, Storage, Storage Ext, Mix, NPC Shop, My/Purchase Shop,
   Inventory Extension, Lucky Item) -- they all show the same 37x26
   corner-button chrome and, except Storage Ext, the same gold-amount strip.
   `px` for the same reason as the header-rail family above: every one of
   these windows scales via its own `transform: scale(root_scale)`, not the
   RmlUi context's dp ratio.

   Position (left/top/width where given) is this family's own established
   default (CMyInventory's already-tuned values) -- override per-window only
   when that window's own layout genuinely differs, same convention as
   .modern-header-rail-px's top/height override in my_inventory.rcss. */
/* 9 above the panel's bottom: the original row's top 392 in a 429-tall panel, for the 28-tall box. */
.modern-icon-btn-px {
	position: absolute;
	bottom: 9px;
	width: 37px;
	height: 26px;
	cursor: pointer;
	pointer-events: auto;
	text-align: center;
	line-height: 26px;
	color: token(text-secondary);
	background-color: #0f1114;
	decorator:
		linear-gradient(to bottom, rgba(255, 255, 255, 11), transparent 40%),
		linear-gradient(to bottom, #1c2127, #101215 56%, #08090a);
	border: 1px token(border-frame);
	border-radius: token(radius-sm)px;
	box-shadow:
		0 2px 5px rgba(0, 0, 0, 133),
		inset 0 1px 0 rgba(232, 210, 168, 18),
		inset 0 -1px 0 #000000;
}
.modern-icon-btn-px:hover {
	color: token(accent-gold-hover);
	border-color: token(border-hover);
	decorator:
		linear-gradient(to bottom, rgba(255, 255, 255, 15), transparent 40%),
		linear-gradient(to bottom, #21272e, #101317 56%, #090a0c);
}
.modern-icon-btn-px.hidden { display: none; }
.modern-icon-btn-px.locked { pointer-events: none; filter: brightness(0.6); }
.modern-icon-btn-glyph-px {
	/* No explicit color -- RmlUi inherits it from .modern-icon-btn-px by default already; this
	   build's CSS parser doesn't recognize the literal `inherit` keyword (logs a syntax-error
	   warning and drops the declaration, same net effect but noisy). */
	font-weight: bold;
	font-family: "DejaVu Sans";
	pointer-events: none;
}

/* px companions of .btn and .checkbox-box, for panels scaled by transform: scale(root_scale),
   where their dp sizes would be scaled twice. Same recipe and values, reference px; no size of
   their own -- each consumer boxes them. */
.modern-btn-px {
	position: absolute;
	text-align: center;
	cursor: pointer;
	color: #d1bc93;
	background-color: #0f1114;
	decorator: linear-gradient(to bottom, rgba(255, 255, 255, 10), transparent 45%),
		linear-gradient(to bottom, #1c2127, #0f1114 58%, #080a0c);
	border-width: 1px;
	border-color: #6c5733;
	border-radius: token(radius-sm)px;
	box-sizing: border-box;
	pointer-events: auto;
	box-shadow:
		inset 0 1px 0 rgba(232, 210, 168, 14),
		inset 0 -1px 0 #000000,
		0 1px 2px rgba(0, 0, 0, 153);
}
.modern-btn-px:hover {
	color: #e0bb76;
	border-color: #776646;
	decorator: linear-gradient(to bottom, rgba(255, 255, 255, 13), transparent 45%),
		linear-gradient(to bottom, #21272e, #101317 58%, #090a0c);
}
.modern-btn-px:active {
	box-shadow: inset 0 1px 3px rgba(0, 0, 0, 184);
}

.modern-checkbox-px {
	position: absolute;
	background-color: #0b0c0e;
	border-width: 1px;
	border-color: #6f5a34;
	border-radius: token(radius-sm)px;
	box-sizing: border-box;
	box-shadow: inset 0 1px 2px rgba(0, 0, 0, 140);
}
.modern-checkbox-px.checked {
	background-color: #8f6922;
	decorator: linear-gradient(to bottom, #d3a44e, #8f6922);
	border-color: #aa8032;
}

/* Vector wallet bar (forged-metal strip + coin glyph + label), replacing every legacy money-bar
   sprite in this family. Default geometry matches CMyInventory's own 15/366/160/20 -- override
   left/top/width per-window if that window's layout doesn't share Inventory's 15-175px column. */
.modern-wallet-px {
	position: absolute;
	left: 15px;
	top: 366px;
	width: 160px;
	height: 20px;
	pointer-events: none;
	background-color: token(metal-dark);
	decorator:
		linear-gradient(to bottom, rgba(205, 178, 129, 9), transparent 34%),
		linear-gradient(to bottom, #101215, #08090a);
	border: 1px token(border-rail);
	border-radius: token(radius-sm)px;
	box-shadow:
		inset 0 1px 0 rgba(235, 212, 169, 12),
		inset 0 -1px 0 #000000;
}
.modern-wallet-coin-px {
	position: absolute;
	left: 8px;
	top: 50%;
	width: 12px;
	height: 8px;
	margin-top: -4px;
	border: 1px #8f6922;
	border-radius: 4px;
	background-color: #8f6922;
	decorator: linear-gradient(to bottom, #d3a44e, #8f6922);
}
.modern-wallet-label-px {
	position: absolute;
	left: 26px;
	top: 50%;
	margin-top: -4px;
	font-size: 7px;
	letter-spacing: 0.06em;
	text-transform: uppercase;
	color: #b69763;
	font-family: "token(font-body)";
}
/* Sibling of .modern-wallet-px, not nested in it -- same reasoning as my_inventory.rcss's
   original #gold_text (an independent absolutely-positioned element reads its own right-aligned
   value more simply than a child squeezed into the wallet bar's own box). */
.modern-wallet-value-px {
	position: absolute;
	right: 18px;
	top: 371px;
	width: 110px;
	text-align: right;
	color: token(text-warm);
	font-weight: 500;
	font-size: 10px;
	white-space: nowrap;
	pointer-events: none;
	font-effect: shadow(0px 1px #000000);
}

/* Recessed control cavity. background is flat (no decorator); depth comes primarily from the
   inset box-shadow. */
.modern-control-well {
	background-color: #08090a;
	border-width: 1dp;
	border-color: #2a313b;
	box-shadow:
		inset 0 2dp 7dp rgba(0, 0, 0, 191),
		inset 0 0 0 1dp rgba(155, 125, 73, 13);
}

/* Zen amounts by wealth tier (GameLogic::Items::GoldAmountTier; the model binds its key, the RML
   toggles .gold-<key>). The original client's colors. */
.gold-amount.gold-base             { color: #ffda96; }
.gold-amount.gold-hundred-thousand { color: #00c918; }
.gold-amount.gold-million          { color: #ffa600; }
.gold-amount.gold-ten-million      { color: #ff0000; }

/* Level gauge: a recessed rail and a gold fill by level. .level-gauge-hit takes the pointer;
   consumers size and place all three. C++: UI::RmlBridge::ApplyLevelGaugeEvent(). */
.level-gauge {
	background-color: token(metal-rail-dark);
	border-width: 1px;
	border-color: token(border-inner);
	border-radius: token(radius-sm)px;
	box-sizing: border-box;
	pointer-events: none;
}
.level-gauge-fill {
	position: absolute;
	background-color: token(accent-gold);
	decorator: linear-gradient(to bottom, token(accent-gold-hover), token(accent-gold));
	border-radius: token(radius-sm)px;
	pointer-events: none;
}
.level-gauge-hit { position: absolute; top: 0; bottom: 0; pointer-events: auto; drag: drag; cursor: pointer; }

/* A fill's level as a class (level-<n>); 10 steps, or 5 on an effect gauge. A consumer binding its
   own width (the MU Helper detail window) does not use these. */
.level-gauge-fill.level-1 { width: 10%; }
.level-gauge-fill.level-2 { width: 20%; }
.level-gauge-fill.level-3 { width: 30%; }
.level-gauge-fill.level-4 { width: 40%; }
.level-gauge-fill.level-5 { width: 50%; }
.level-gauge-fill.level-6 { width: 60%; }
.level-gauge-fill.level-7 { width: 70%; }
.level-gauge-fill.level-8 { width: 80%; }
.level-gauge-fill.level-9 { width: 90%; }
.level-gauge-fill.level-10 { width: 100%; }
.effect-gauge .level-gauge-fill.level-1 { width: 20%; }
.effect-gauge .level-gauge-fill.level-2 { width: 40%; }
.effect-gauge .level-gauge-fill.level-3 { width: 60%; }
.effect-gauge .level-gauge-fill.level-4 { width: 80%; }
.effect-gauge .level-gauge-fill.level-5 { width: 100%; }

/* The frame's corner close: an unstyled hit box over the close "X" the frame art draws at the
   panel's top-right (its circle spans about 166-182 x 4-20 of the original 190-wide panel), a
   little larger than the circle so it is easy to hit, and above the panel's other parts (a title
   bar that is also a drag handle). Each window's markup adds it with its own close event. */
#frame_corner_close {
	position: absolute;
	top: 1px;
	right: 3px;
	width: 24px;
	height: 22px;
	cursor: pointer;
	pointer-events: auto;
	z-index: 1;
}

/* ============================================================================
   Sharp text in panels scaled by transform: scale(root_scale)
   ----------------------------------------------------------------------------
   RmlUi rasterises glyphs at the computed font-size and ignores transforms, so
   text inside a placed panel was drawn at reference size and stretched by the
   panel's scale (blurry at 1.5-2x). These shared text leaves now lay out at
   the physical size -- font-size and their own lengths are reference px times
   --root-scale -- and cancel the panel's scale around the edge or centre their
   text is aligned to. On screen the size and position are unchanged; body sets
   --root-scale: 1, so an unscaled document is unaffected.
   ============================================================================ */
.modern-header-title-px {
	font-size: calc(13px * var(--root-scale, 1));
	white-space: nowrap;
	transform-origin: left top;
	transform: scale(calc(1 / var(--root-scale, 1)));
}
.modern-wallet-label-px {
	font-size: calc(7px * var(--root-scale, 1));
	white-space: nowrap;
	transform-origin: left top;
	transform: scale(calc(1 / var(--root-scale, 1)));
}
.modern-wallet-value-px {
	width: calc(110px * var(--root-scale, 1));
	font-size: calc(10px * var(--root-scale, 1));
	transform-origin: right top;
	transform: scale(calc(1 / var(--root-scale, 1)));
}
/* The glyph is centred on its button: a wide layer whose centre sits on the
   button's centre, scaled back around that centre (base's .sharp-centre and
   .sharp-middle, written out). */
.modern-icon-btn-glyph-px {
	position: absolute;
	left: 50%;
	top: 50%;
	width: 2000px;
	margin-left: -1000px;
	text-align: center;
	white-space: nowrap;
	line-height: 1.2;
	font-size: calc(12px * var(--root-scale, 1));
	transform-origin: center center;
	transform: translateY(-50%) scale(calc(1 / var(--root-scale, 1)));
}


/* =====================================================================================
   KRYON COMPONENTS -- generated from tokens.json (components / effects / variants).
   Appended after the retinted base rules so these recipes win by source order.
   ===================================================================================== */

/* Window: gold border, dark outer ring + aged-gold ring, deep drop shadow, warm top glow. */
.modern-frame,
.modern-frame-crimson {
	background-color: #080a0d;
	decorator: radial-gradient(circle at 50% 0%, rgba(136, 112, 69, 36), transparent 55%), repeating-linear-gradient(135deg, rgba(255, 255, 255, 2) 0dp 1dp, transparent 1dp 4dp), linear-gradient(110deg, #14171b 0%, #080a0d 100%);
	border-width: 1dp;
	border-color: #af8b4c;
	border-radius: 1dp;
	box-shadow: 0dp 0dp 0dp 3dp #101115, 0dp 0dp 0dp 4dp #5b4c31, 0dp 16dp 48dp 0dp rgba(0, 0, 0, 187);
}
/* The content plate keeps the frame visible: no own fill, only the inner gold line. */
.modern-panel,
.modern-panel-crimson {
	background-color: transparent;
	decorator: none;
	border-width: 1dp;
	border-color: rgba(127, 105, 59, 85);
	border-radius: 0dp;
}
.modern-frame-accent-crimson {
	border-color: rgba(141, 116, 75, 102);
}
.modern-header,
.modern-header-rail {
	background-color: #111318;
	decorator: radial-gradient(circle at 50% 0%, rgba(166, 123, 52, 48), transparent 70%), linear-gradient(180deg, #212024 0%, #111318 100%);
	border-width: 0dp;
	border-bottom-width: 1dp;
	border-bottom-color: rgba(156, 124, 69, 79);
}
.modern-header-accent {
	opacity: 0.6;
}
.modern-title-plate {
	background-color: #111318;
	decorator: radial-gradient(circle at 50% 0%, rgba(166, 123, 52, 48), transparent 70%), linear-gradient(180deg, #212024 0%, #111318 100%);
	border-color: #b38a47;
	box-shadow: inset 0dp 1dp 0dp rgba(219, 184, 118, 48), inset 0dp -1dp 0dp #000000, 0dp 2dp 5dp rgba(0, 0, 0, 140);
}
.modern-header-title {
	color: #efd398;
	font-family: "token(font-title)";
	letter-spacing: 1.6dp;
	text-transform: uppercase;
	font-effect: shadow(0dp 1dp #000000);
}
.title-glow {
	decorator: radial-gradient(ellipse, rgba(239, 211, 152, 96), rgba(141, 105, 55, 64) 55%, transparent 88%);
}

/* Primary forged-bronze button (web: SIGN IN). Plain .btn gets the same metal; .btn-ok is brighter. */
.btn,
.btn-ok {
	color: #ffe4a8;
	background-color: #281e12;
	decorator: linear-gradient(180deg, #69502b 0%, #3d2e19 48%, #281e12 52%, #48351d 100%);
	border-width: 1dp;
	border-color: #79613e;
	border-radius: 1dp;
	letter-spacing: 0.4dp;
	font-family: "token(font-title)";
	font-effect: shadow(0dp 1dp #000000);
	box-shadow: inset 0dp 0dp 0dp 2dp rgba(29, 24, 14, 204), inset 0dp 3dp 0dp 0dp rgba(219, 184, 118, 85), 0dp 2dp 6dp 0dp rgba(0, 0, 0, 136);
}
/* The window's one primary action keeps the web's uppercase, spaced lettering. */
.btn-ok {
	border-color: #b38a47;
	text-transform: uppercase;
	letter-spacing: 1.2dp;
}
.btn:hover,
.btn-ok:hover {
	color: #fff0cc;
	border-color: #e5c582;
	decorator: linear-gradient(180deg, #7e6034 0%, #4a381e 48%, #322515 52%, #5a4224 100%);
}
.btn:active,
.btn-ok:active {
	transform: translateY(1dp);
	decorator: linear-gradient(0deg, #69502b 0%, #3d2e19 48%, #281e12 52%, #48351d 100%);
	box-shadow: inset 0dp 1dp 3dp rgba(0, 0, 0, 184);
}
.btn.disabled,
.btn-ok.disabled {
	decorator: none;
	box-shadow: none;
	background-color: #0a0d11;
	border-color: #625338;
	color: #5c5648;
	opacity: 0.5;
}

/* Icon buttons: secondary metal; the primary one uses the forged bronze. */
.btn-icon {
	color: #c8b99a;
	decorator: linear-gradient(180deg, #302b24 0%, #161719 100%);
	border-color: #78613c;
	box-shadow: inset 0dp 0dp 0dp 2dp rgba(7, 9, 11, 128), 0dp 2dp 5dp rgba(0, 0, 0, 133);
}
.btn-icon:hover {
	color: #fff0cc;
	border-color: #e5c582;
	decorator: linear-gradient(180deg, #69502b 0%, #3d2e19 48%, #281e12 52%, #48351d 100%);
}
.btn-icon-primary {
	color: #ffe4a8;
	decorator: linear-gradient(180deg, #69502b 0%, #3d2e19 48%, #281e12 52%, #48351d 100%);
	border-color: #b38a47;
}
.btn-icon-primary:hover {
	border-color: #e5c582;
	decorator: linear-gradient(180deg, #7e6034 0%, #4a381e 48%, #322515 52%, #5a4224 100%);
}
.btn-icon-label,
.btn-icon-primary .btn-icon-label {
	color: #ffe4a8;
}

/* Inputs: near-black well, bronze edge; gold edge while focused. */
.text-field {
	color: #f5e5c4;
	background-color: #04060a;
	decorator: linear-gradient(180deg, #04060a 0%, #13171c 100%);
	border-color: #625338;
	box-shadow: inset 0dp 1dp 4dp #000000;
}
.text-field:focus {
	border-color: #d3ae66;
	box-shadow: inset 0dp 1dp 4dp #000000, 0dp 0dp 0dp 2dp rgba(196, 154, 77, 34);
}
.text-field selection {
	color: #1b0e08;
	background-color: #f5cf8a;
}

/* Checkbox and slots. */
.checkbox-box {
	background-color: #06090e;
	border-color: #625338;
}
.checkbox-box.checked {
	decorator: linear-gradient(180deg, #d3aa4e 0%, #8f6922 100%);
	border-color: #d3ae66;
}
.slot {
	border-color: #5b4c31;
}
.slot--selected {
	border-color: #d3ae66;
	background-color: rgba(211, 174, 102, 25);
}

/* Scrollbar: gold thumb on a steel rail. */
.scroll-pane scrollbarvertical slidertrack {
	background-color: #101317;
}
.scroll-pane scrollbarvertical sliderbar {
	background-color: #725937;
}
.scroll-pane scrollbarvertical sliderbar:hover,
.scroll-pane scrollbarvertical sliderbar:active {
	background-color: #a08349;
}

/* ---- Opt-in helpers for forked .rml files (not used by the shared markup) ---- */

/* Tabs / segmented selectors (web: ES/EN/PT, shop tabs, ranking periods). */
.kryon-tab {
	pointer-events: auto;
	cursor: pointer;
	text-align: center;
	font-family: "token(font-body)";
	font-size: 7dp;
	text-transform: uppercase;
	letter-spacing: 0.2dp;
	color: #a9a08e;
	background-color: #06090e;
	border: 1dp rgba(118, 97, 60, 102);
	border-radius: 1dp;
}
.kryon-tab:hover {
	border-color: #e5c582;
	color: #dbcfb4;
}
.kryon-tab.active {
	color: #ffe0a1;
	decorator: linear-gradient(180deg, #4b3b21 0%, #221d14 100%);
	border-color: #bc9351;
	box-shadow: inset 0dp 0dp 0dp 2dp #171511;
}
/* Golden progress bar (web: loaders). Put .kryon-progress-fill inside with width = percent. */
.kryon-progress {
	background-color: #020405;
	border: 1dp #9b7d42;
	box-shadow: 0dp 0dp 0dp 1dp #080a0d, inset 0dp 1dp 4dp #000000;
}
.kryon-progress-fill {
	height: 100%;
	decorator: linear-gradient(0deg, #713810 0%, #d99a38 45%, #ffdc8c 65%, #b87523 100%);
	box-shadow: 0dp 0dp 10dp rgba(237, 156, 59, 96);
}
/* Gold "L" corner ornaments (web: login card). Two empty divs as the frame's last children. */
.kryon-corner-tl, .kryon-corner-tr {
	position: absolute;
	top: 10dp;
	width: 18dp;
	height: 18dp;
	pointer-events: none;
	border-top: 2dp #d0ad67;
}
.kryon-corner-tl { left: 10dp; border-left: 2dp #d0ad67; }
.kryon-corner-tr { right: 10dp; border-right: 2dp #d0ad67; }
/* Bright gold call-to-action (web: welcome "claim"). */
.kryon-cta {
	color: #1a1206;
	decorator: linear-gradient(180deg, #ffe6a2 0%, #c9a24a 100%);
	border: 1dp rgba(255, 235, 180, 153);
	box-shadow: 0dp 3dp 10dp 0dp rgba(214, 180, 90, 115);
	text-transform: uppercase;
	font-weight: bold;
}
/* Ranking / list rows. */
.kryon-row {
	color: #c2baa7;
	border-bottom: 1dp rgba(180, 153, 100, 32);
}
.kryon-row:hover {
	background-color: rgba(196, 156, 61, 12);
}

/* Variant "ember": Warm war/hunt windows (web: player command, character, clan war, hunting); suggested for PvP, duel, castle siege. Use as class="modern-frame kryon-frame-ember". */
.kryon-frame-ember {
	decorator: radial-gradient(circle at 50% 0%, rgba(217, 150, 62, 56), transparent 45%), linear-gradient(160deg, #1b1009 0%, #060506 100%);
	border-color: #ca9446;
}
.kryon-frame-ember .modern-header-title { color: #ffe9b8; }
.kryon-frame-ember .slot--selected { border-color: #d9963e; }

/* Variant "mint": Shop / economy (web: shop); suggested for in-game shop, NPC shops, trade. Use as class="modern-frame kryon-frame-mint". */
.kryon-frame-mint {
	decorator: linear-gradient(155deg, #0e1514 0%, #060807 100%);
	border-color: rgba(217, 170, 85, 184);
}
.kryon-frame-mint .modern-header-title { color: #fff2d2; }
.kryon-frame-mint .slot--selected { border-color: #62d6b5; }

/* Variant "sky": Packs / rewards (web: packs); suggested for event rewards, lucky coin, gift windows. Use as class="modern-frame kryon-frame-sky". */
.kryon-frame-sky {
	decorator: linear-gradient(180deg, #0d1626 0%, #050810 100%);
	border-color: rgba(96, 170, 235, 128);
}
.kryon-frame-sky .modern-header-title { color: #bfe4ff; }
.kryon-frame-sky .slot--selected { border-color: #60c4ff; }

/* Variant "arcane": Special / magic (web: welcome, chaos reset, soul machine); suggested for chaos machine, master level, socket. Use as class="modern-frame kryon-frame-arcane". */
.kryon-frame-arcane {
	decorator: radial-gradient(circle at 50% 0%, rgba(255, 197, 74, 41), transparent 45%), linear-gradient(180deg, #1a1028 0%, #09050f 100%);
	border-color: rgba(240, 190, 74, 148);
}
.kryon-frame-arcane .modern-header-title { color: #f0d18a; }
.kryon-frame-arcane .slot--selected { border-color: #9d4edd; }

/* Variant "steel": Vault / storage (web: jewel bank, card recharge, retention); suggested for warehouse, guild storage. Use as class="modern-frame kryon-frame-steel". */
.kryon-frame-steel {
	decorator: linear-gradient(180deg, #27303a 0%, #0b1017 100%);
	border-color: #b99448;
	box-shadow: 0dp 0dp 0dp 4dp #090c11, 0dp 0dp 0dp 5dp #534326, 0dp 16dp 48dp 0dp rgba(0, 0, 0, 187);
}
.kryon-frame-steel .modern-header-title { color: #f5d78c; }
.kryon-frame-steel .slot--selected { border-color: #ecad4b; }
