/* Generated by generate_theme.py: modern/kanturu_info.rcss retinted with tokens.json. */
/* Modern theme for CKanturuInfoWindow: the modern panel surface instead of newui_Figure_kantru; the
   texts and digits keep the legacy geometry and colours (see the legacy theme). */

body { pointer-events: none; }

.screen {
	position: absolute;
	left: 0;
	top: 0;
	width: 640px;
	height: 480px;
	transform-origin: left top;
	pointer-events: none;
}

#panel { position: absolute; width: 99px; height: 78px; font-family: "token(font-body)"; }
#back { position: absolute; left: 0; top: 0; width: 99px; height: 78px; background-color: token(surface-panel); border: 1px token(border-frame); }

.info-text {
	display: block;
	position: absolute;
	transform-origin: left top;
	white-space: nowrap;
	font-weight: bold;
	color: #8686c7;
}
#users { left: 10px; top: 15px; }
#monsters { left: 10px; top: 35px; }
#colon { left: 48px; top: 57px; }

.digit { position: absolute; top: 55px; width: 8.4px; height: 11.2px; }
.digit.blank { visibility: hidden; }
/* RenderNumber(): 8.4-unit digits 6.72 apart, the run starting half its digit count's width left
   of its x. */
#minutes .digit { left: calc(35px - var(--n) * 4.2px + var(--i) * 6.72px); }
#seconds .digit { left: calc(65px - var(--n) * 4.2px + var(--i) * 6.72px); }

/* The HUD takes no pointer events where it is placed (base.rcss gives a placed panel them). */
#panel.slot-placed { pointer-events: none; }

/* The data-for template row has no index of its own; it inherits this one. */
.run { --i: 0; }

/* ---- handmade/shared/flat_card.rcss: the Kryon look, appended so it wins by source order. ---- */
/* Kryon card for the small windows modern draws as a flat box (surface-panel fill, one border-frame
   line): event entries and timers, Kanturu, Cursed Temple, duel, quick command, window menu, message
   boxes, the in-game shop's frames... The rule's selector is filled in per stylesheet from
   tokens.json's handmadeShared. Sizes are px: these panels scale themselves. */

#back {
	background-color: token(kryon-card-bottom);
	decorator:
		radial-gradient(circle at 50% 0%, token(kryon-card-glow), transparent 55%),
		linear-gradient(110deg, token(kryon-card-top) 0%, token(kryon-card-mid) 50%, token(kryon-card-bottom) 100%);
	border-width: 1px;
	border-color: token(kryon-card-border);
	border-radius: token(radius-md)px;
	box-shadow:
		0 0 0 2px token(kryon-ring-outer),
		0 0 0 3px token(kryon-ring-gold),
		0 10px 28px rgba(0, 0, 0, 170),
		inset 0 0 0 3px token(kryon-ring-inner-dark),
		inset 0 0 0 4px token(kryon-filete);
}
