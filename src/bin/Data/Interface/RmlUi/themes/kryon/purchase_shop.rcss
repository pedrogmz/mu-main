/* Generated by generate_theme.py: modern/purchase_shop.rcss retinted with tokens.json. */
/* Modern theme for CPurchaseShopInventory's chrome -- header/nameplate-strip/warning-text/exit
   button are vector forged-metal chrome (matching Login/SysMenu/MyInventory/StorageExt's forged-
   dialog language). Inventory grid stays fully native (sprite art + live 3D icons), same as
   legacy -- no RmlUi involvement there. No gold wallet strip -- this window shows no Zen total
   (same as StorageExt, the other gold-less window in this family). */

#panel {
	position: absolute;
	transform-origin: left top;
	width: 190px;
	height: 429px;
	font-family: "token(font-body)";
}

/* top:7/height:29 -- rail ends at 36px. The nameplate strip below (.pshop-title-strip) runs
   44-70px, and the native grid starts at `m_Pos.y + 90` (PurchaseShopInventory.cpp's
   CInventoryCtrl::Create() call) -- 20px clear after the strip. top:7 (same as MyInventory's own
   rail top) keeps .modern-joint-px's rivet at -1px, inside the frame's
   .inv-shell-edge at -3px -- same contained relationship as StorageExt/MyInventory. */
.pshop-header-rail {
	top: 7px;
	height: 29px;
}

/* Nameplate strip for the dynamic shop-owner name -- native's separate text row (RenderTextInfo(),
   PurchaseShopInventory.cpp) painted over IMAGE_MYSHOPINVENTORY_EDIT's sprite; here a plain vector
   strip using the same metal-rail gradient as the header above. Sits between the header rail
   (ends 36px) and the native grid (starts 90px). */
.pshop-title-strip {
	position: absolute;
	left: 12px;
	top: 44px;
	width: 166px;
	height: 26px;
	pointer-events: none;
	background-color: token(metal-dark);
	decorator:
		linear-gradient(to bottom, rgba(205, 178, 129, 10), transparent 30%),
		linear-gradient(to bottom, token(metal-rail), #121519 45%, token(metal-rail-dark));
	border-width: 1px;
	border-color: token(border-rail);
	border-radius: token(radius-sm)px;
	box-shadow:
		inset 0 1px 0 rgba(235, 212, 169, 15),
		inset 0 -1px 0 #000000;
}
.pshop-title-strip-text {
	position: absolute;
	left: 0;
	top: 6px;
	width: 166px;
	text-align: center;
	color: token(text-warm);
	font-family: "token(font-title)";
	font-weight: 500;
	font-size: 12px;
	font-effect: shadow(0px 1px #000000);
	pointer-events: none;
}

/* Static warning notice -- semantic red/gold match legacy exactly (meaning, not theme palette),
   same convention as my_inventory.rcss's tt-line colors. shop_notice.rcss lays it out. */
.warning-label { color: #ff2d2f; }
.warning-line { color: #f7bc4d; }

/* Single exit button, centered: (190-37)/2. */
.pshop-btn-exit {
	left: 77px;
	color: #d5b579;
	border-color: #735a36;
}

/* Native item grid: the first cell's top-left, in #panel's units. */
.native-anchor { position: absolute; pointer-events: none; }
#item_grid, #item_grid_counts { left: 16px; top: 90px; width: calc(8 * var(--item-cell)); height: calc(4 * var(--item-cell)); }

/* The frame. */
.bg-panel {
	position: absolute;
	left: 0;
	top: 0;
	width: 190px;
	height: 429px;
	pointer-events: none;
	border-radius: token(radius-sm)px;
	background-color: #08090a;
	decorator: linear-gradient(to bottom, #0e1114 0%, #08090a 100%);
	border-width: 1px;
	border-color: token(border-frame);
	box-shadow:
		0 11px 30px rgba(0, 0, 0, 158),
		0 2px 5px rgba(0, 0, 0, 217),
		inset 0 0 0 1px #08090a,
		inset 0 0 0 3px rgba(174, 140, 82, 190);
}

.inv-shell-edge {
	position: absolute;
	left: -3px;
	right: -3px;
	top: -3px;
	bottom: -3px;
	pointer-events: none;
	background-color: transparent;
	border-radius: token(radius-sm)px;
	border-width: 1px;
	border-color: rgba(24, 28, 33, 242);
	box-shadow:
		inset 1px 0 0 rgba(178, 146, 92, 110),
		inset -1px 0 0 rgba(0, 0, 0, 204),
		inset 0 1px 0 rgba(190, 163, 117, 90),
		inset 0 -1px 0 rgba(0, 0, 0, 230);
}

.inv-groove {
	position: absolute;
	left: 4px;
	right: 4px;
	top: 4px;
	bottom: 4px;
	pointer-events: none;
	border-width: 1px;
	border-color: #1d2228;
	box-shadow:
		inset 0 0 0 1px rgba(169, 136, 80, 40),
		inset 0 0 12px rgba(0, 0, 0, 153);
}

/* Rail fill/accent relocated from the fg's now paint-less .modern-header-rail-px -- see
   base.rcss's comment on that class. top/height match .pshop-header-rail (purchase_shop.rcss). */
.rail-fill {
	position: absolute;
	left: 8px;
	right: 8px;
	top: 7px;
	height: 29px;
	pointer-events: none;
	background-color: token(metal-dark);
	decorator:
		linear-gradient(to bottom, rgba(205, 178, 129, 13), transparent 31%),
		linear-gradient(to bottom, token(metal-rail), #121519 45%, token(metal-rail-dark));
	border-width: 1px;
	border-color: token(border-rail);
	border-bottom-color: #121518;
	box-shadow:
		inset 0 1px 0 rgba(235, 212, 169, 18),
		inset 0 -1px 0 #000000,
		0 2px 4px rgba(0, 0, 0, 133);
}
/* Nested inside .rail-fill -- its left/right/bottom resolve against that box. */
.rail-accent {
	position: absolute;
	left: 7px;
	right: 7px;
	bottom: 2px;
	height: 1px;
	pointer-events: none;
	opacity: 0.35;
	decorator: linear-gradient(to right,
		transparent,
		token(metal-warm-edge) 30%,
		#84714e 50%,
		token(metal-warm-edge) 70%,
		transparent);
}

/* The grid's clicks are native (CInventoryCtrl), so the placed panel takes no pointer events; its
   controls take their own. */
#panel.slot-placed { pointer-events: none; }

/* ---- handmade/shared/inventory_frame.rcss: the Kryon look, appended so it wins by source order. ---- */
/* Kryon frame for the item windows (inventory, storage, trade, shops, Chaos Machine, ...): they
   share modern's .bg-panel / .inv-shell-edge / .inv-groove / .rail-fill structure, each in its own
   stylesheet, so this overlay is appended to every one of them (tokens.json's handmadeShared).
   Every position stays modern's -- slots and grids are native anchors the client reads back for
   its hit tests -- so only the look changes: card and rings, the title over a divider, recessed
   slots and cells. */

.bg-panel {
	background-color: token(kryon-card-bottom);
	decorator:
		radial-gradient(circle at 50% 0%, token(kryon-card-glow), transparent 55%),
		linear-gradient(110deg, token(kryon-card-top) 0%, token(kryon-card-mid) 50%, token(kryon-card-bottom) 100%);
	border-width: 1px;
	border-color: token(kryon-card-border);
	border-radius: token(radius-md)px;
	box-shadow:
		0 0 0 3px token(kryon-ring-outer),
		0 0 0 4px token(kryon-ring-gold),
		0 16px 40px rgba(0, 0, 0, 187),
		inset 0 0 0 5px token(kryon-ring-inner-dark),
		inset 0 0 0 6px token(kryon-filete);
}
.inv-shell-edge {
	display: none;
}
.inv-groove {
	border-color: transparent;
	box-shadow: none;
}
.rail-fill {
	background-color: transparent;
	decorator: none;
	border-width: 0;
	border-bottom-width: 1px;
	border-bottom-color: token(kryon-divider);
	box-shadow: none;
}
.rail-accent {
	display: none;
}

/* Equipment slots and bag cells: dark wells with a faint bronze edge. */
.equip-slot {
	border-color: rgba(141, 116, 75, 90);
	background-color: rgba(4, 6, 9, 150);
}
#item_grid .item-cell-art,
.item-grid .item-cell-art {
	border-color: rgba(141, 116, 75, 46);
}


/* ---- handmade/purchase_shop.rcss: the Kryon look, appended so it wins by source order. ---- */
/* Sharp text in the personal shop window. #panel is scaled by transform: scale(--root-scale); RmlUi
   rasterises glyphs at the computed font-size, so its text was stretched 1.5-2x (blurry). As in
   base.rcss's .modern-header-title-px, the text lays out at the physical size (reference px times
   --root-scale) and scales back by 1 / --root-scale around its top-left corner, so its size and
   place on screen are unchanged. */
.pshop-title-strip-text {
	width: calc(166px * var(--root-scale, 1));
	font-size: calc(12px * var(--root-scale, 1));
	transform-origin: left top;
	transform: scale(calc(1 / var(--root-scale, 1)));
}
