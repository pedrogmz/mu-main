/* Generated by generate_theme.py: modern/mu_helper_bar.rcss retinted with tokens.json. */
/* Modern theme for the MU Helper mini control bar + hero position readout -- flat programmatic
   chrome, no legacy sprite art. Same layout as themes/legacy/mu_helper_bar.rcss. */

#panel.workspace-placed { transform-origin: left top; }
#panel {
	position: absolute;
	width: 207dp;
	height: 25dp;
	font-family: "token(font-body)";
	font-size: 11dp;
	background-color: rgba(12, 14, 17, 190);
	border: 1dp token(border-frame);
	border-radius: token(radius-sm)dp;
}

/* No legacy seam art -- the three segments collapse into #panel's own flat fill; elements stay in
   the document (data bindings target them by id) but render nothing of their own. */
#seg_a, #seg_b, #seg_c {
	display: none;
}

#text {
	position: absolute;
	left: 10dp;
	top: 5dp;
	width: 132dp;
	height: 9dp;
	text-align: center;
	color: token(text-primary);
	font-family: "token(font-body)";
	white-space: nowrap;
	pointer-events: none;
}

.mu-btn {
	position: absolute;
	top: 2dp;
	width: 18dp;
	height: 13dp;
	cursor: pointer;
	pointer-events: auto;
	background-color: token(surface-control);
	border: 1dp token(border-frame);
	border-radius: 2dp;
}
.mu-btn:hover {
	background-color: token(accent-steel);
	border: 1dp token(accent-steel);
}
#btn_config { left: 153dp; }
#btn_start  { left: 171dp; }
#btn_stop   { left: 171dp; }

/* Plain colored dot per button (no icon art) -- config: neutral, start: success, stop: danger. */
.dot {
	position: absolute;
	left: 50%;
	top: 50%;
	width: 6dp;
	height: 6dp;
	transform: translate(-50%, -50%);
	border-radius: 3dp;
	pointer-events: none;
}
#btn_config .dot { background-color: token(semantic-neutral); }
#btn_start .dot  { background-color: token(semantic-success); }
#btn_stop .dot   { background-color: token(semantic-danger); }

/* ---- handmade/mu_helper_bar.rcss: the Kryon look, appended so it wins by source order. ---- */
/* Kryon MU Helper bar: a small Kryon card with framed buttons. The dots keep their meaning colors
   (gray settings, green start, red stop). */

#panel {
	background-color: token(kryon-card-bottom);
	decorator: linear-gradient(110deg, token(kryon-card-top) 0%, token(kryon-card-bottom) 100%);
	border: 1dp token(kryon-card-border);
	border-radius: token(radius-md)dp;
	box-shadow: 0 0 0 2dp token(kryon-ring-outer), 0 0 0 3dp token(kryon-ring-gold), 0 6dp 16dp rgba(0, 0, 0, 160);
}
#text {
	color: token(kryon-title);
	font-family: "token(font-title)";
}
.mu-btn {
	background-color: token(kryon-tab-idle);
	decorator: linear-gradient(180deg, token(kryon-card-top) 0%, token(kryon-tab-idle) 100%);
	border: 1dp token(kryon-tab-border);
	border-radius: token(radius-sm)dp;
}
.mu-btn:hover {
	background-color: token(kryon-tab-bottom);
	decorator: linear-gradient(180deg, token(kryon-tab-top) 0%, token(kryon-tab-bottom) 100%);
	border: 1dp token(kryon-btn-border-hover);
}
