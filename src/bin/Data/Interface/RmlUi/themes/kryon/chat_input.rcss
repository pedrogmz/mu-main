/* Generated by generate_theme.py: modern/chat_input.rcss retinted with tokens.json. */
/* Modern theme for CChatInputBox. Geometry is identical to legacy's and traced to native's own
   constants there -- see legacy/chat_input.rcss rather than repeating the derivation. What differs
   is that this theme draws no sprite art at all: legacy's background bitmap carries every button's
   OFF state, so an unlit button is invisible-but-present there, whereas here each button needs a
   visible resting state of its own. */

#panel.workspace-placed { bottom: auto; transform-origin: left top; }
#panel {
	position: absolute;
	left: 0;
	bottom: 51dp;
	width: 281dp;
	height: 47dp;
	background-color: token(surface-panel);
	border: 1dp token(metal-edge);
	border-radius: token(radius-sm)px;
	font-family: "token(font-body)";
	font-size: 1rem;
	/* The bar takes the pointer, so a click on it never walks the character. */
	pointer-events: auto;
}

/* Unlike legacy, the resting state is drawn here -- there is no background art underneath to
   supply it. `.on` is the lit state, not the only state. */
.cib-btn {
	position: absolute;
	top: 3dp;
	width: 24dp;
	height: 20dp;
	background-color: token(metal-rail-dark);
	border-radius: token(radius-sm)px;
	pointer-events: auto;
	cursor: pointer;
}
.cib-btn:hover { background-color: token(metal-edge); }
.cib-btn.on { background-color: token(accent-gold); }
.cib-btn:active { filter: brightness(0.75); }

.cib-btn-normal  { left: 2dp; }
.cib-btn-party   { left: 29dp; }
.cib-btn-guild   { left: 56dp; }
.cib-btn-gens    { left: 83dp; }
.cib-btn-whisper { left: 116dp; }
.cib-btn-system  { left: 143dp; }
.cib-btn-chatlog { left: 170dp; }
.cib-btn-frame   { left: 203dp; }
.cib-btn-size    { left: 230dp; }
.cib-btn-alpha   { left: 257dp; }

.cib-whisper-field {
	position: absolute;
	left: 5dp;
	top: 30dp;
	width: 50dp;
	height: 14dp;
	font-size: 11dp;
}
.cib-chat-field {
	position: absolute;
	left: 72dp;
	top: 30dp;
	width: 176dp;
	height: 14dp;
	font-size: 11dp;
}

.cib-whisper-field:disabled { color: token(text-disabled); }
#whisper_block {
	position: absolute;
	left: 2dp;
	top: 28dp;
	width: 61dp;
	height: 17dp;
	background-color: rgba(160, 122, 64, 51);
	border-radius: token(radius-sm)px;
	pointer-events: none;
}

/* ---- handmade/chat_input.rcss: the Kryon look, appended so it wins by source order. ---- */
/* Kryon chat input: the channel and toggle buttons get icons (handmade/icons) -- in modern they
   are plain colored squares -- on framed dark buttons; a lit button is the web's active tab. */

.cib-btn {
	background-color: token(kryon-tab-idle);
	border: 1dp token(kryon-tab-idle-border);
	border-radius: token(radius-sm)dp;
}
.cib-btn:hover {
	background-color: token(kryon-row-hover);
	border-color: token(kryon-btn-border-hover);
}
.cib-btn.on {
	background-color: token(kryon-tab-bottom);
	border-color: token(kryon-tab-border);
	box-shadow: inset 0 -2dp 0 rgba(217, 154, 67, 217);
}
#btn_type_0 { decorator: image(icons/chat_normal.tga contain); }
#btn_type_1 { decorator: image(icons/chat_party.tga contain); }
#btn_type_2 { decorator: image(icons/chat_guild.tga contain); }
#btn_type_3 { decorator: image(icons/chat_gens.tga contain); }
#btn_whisper { decorator: image(icons/chat_whisper.tga contain); }
#btn_system { decorator: image(icons/chat_system.tga contain); }
#btn_chatlog { decorator: image(icons/chat_log.tga contain); }
#btn_frame { decorator: image(icons/chat_frame.tga contain); }
#btn_size { decorator: image(icons/chat_size.tga contain); }
#btn_transparency { decorator: image(icons/chat_alpha.tga contain); }
