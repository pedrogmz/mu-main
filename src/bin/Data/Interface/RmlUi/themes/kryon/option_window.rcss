/* Generated by generate_theme.py: modern/option_window.rcss retinted with tokens.json. */
/* Modern theme's settings screen (themes/modern/option_window.rml): a full-screen glass overlay.
   The world shows through a softly blurred, darkened scrim; the pane of rows sits on frosted glass,
   blurred harder and lit from the top. Every gradient and blur has a plain translucent
   background-color under it, so the screen still reads as glass on a renderer without them. */

#panel {
	position: absolute;
	left: 0;
	top: 0;
	width: 100%;
	height: 100%;
	pointer-events: auto;
	font-family: "token(font-body)";
	color: token(text-primary);
	background-color: rgba(4, 6, 9, 150);
	backdrop-filter: blur(3dp);
	decorator: radial-gradient(ellipse, rgba(4, 6, 9, 0) 35%, rgba(2, 3, 5, 140) 100%);
}

.opt-shell {
	position: absolute;
	left: 5%;
	right: 5%;
	top: 6%;
	bottom: 6%;
	display: flex;
	flex-direction: column;
}

/* Header: the screen title on a gold rule, the close button at the far right. */
.opt-header {
	flex: 0 0 auto;
	display: flex;
	align-items: center;
	height: 52dp;
	border-bottom: 1dp rgba(255, 255, 255, 40);
}
.opt-title {
	flex: 1 1 auto;
	padding-left: 14dp;
	border-left: 3dp token(accent-gold);
	font-size: 24dp;
	font-weight: bold;
	letter-spacing: 4dp;
	text-transform: uppercase;
	color: token(text-primary);
}
.opt-close {
	position: relative;
	flex: 0 0 auto;
	width: 34dp;
	height: 34dp;
	cursor: pointer;
	border-radius: 4dp;
}
.opt-close:hover {
	background-color: rgba(255, 255, 255, 22);
}
.opt-close-bar {
	position: absolute;
	left: 7dp;
	top: 16dp;
	width: 20dp;
	height: 2dp;
	background-color: token(text-secondary);
}
.opt-close-bar-a { transform: rotate(45deg); }
.opt-close-bar-b { transform: rotate(-45deg); }
.opt-close:hover .opt-close-bar {
	background-color: token(accent-gold-hover);
}

.opt-body {
	flex: 1 1 0;
	display: flex;
	margin-top: 20dp;
	min-height: 0;
}

/* Category rail. The active category carries a gold edge and a wash that fades to the right. */
.opt-nav {
	flex: 0 0 auto;
	width: 200dp;
	margin-right: 20dp;
}
.opt-nav-item {
	display: block;
	height: 42dp;
	line-height: 42dp;
	margin-bottom: 4dp;
	padding-left: 16dp;
	border-left: 3dp rgba(255, 255, 255, 0);
	border-radius: 0 4dp 4dp 0;
	cursor: pointer;
	white-space: nowrap;
	font-size: 13dp;
	letter-spacing: 1.5dp;
	text-transform: uppercase;
	color: token(text-secondary);
}
.opt-nav-item:hover {
	color: token(text-primary);
	background-color: rgba(255, 255, 255, 16);
}
.opt-nav-item.active-tab {
	color: token(accent-gold-hover);
	border-left-color: token(accent-gold);
	background-color: rgba(196, 148, 60, 30);
	decorator: linear-gradient(to right, rgba(196, 148, 60, 70), rgba(196, 148, 60, 0));
}

/* The glass pane: a cool translucent fill, a sheen across the top, a brighter top edge. */
.opt-pane {
	position: relative;
	flex: 1 1 0;
	background-color: rgba(23, 26, 31, 140);
	backdrop-filter: blur(12dp);
	decorator: linear-gradient(to bottom, rgba(255, 255, 255, 20), rgba(255, 255, 255, 0) 30%);
	border: 1dp rgba(255, 255, 255, 46);
	border-top-color: rgba(255, 255, 255, 80);
	border-radius: 6dp;
	box-shadow:
		inset 0 1dp 0 rgba(255, 255, 255, 30),
		0 12dp 32dp rgba(0, 0, 0, 140);
}

/* A part of the row above it: indented under its label. */
.opt-sub-row .opt-label {
	box-sizing: border-box;
	padding-left: 16dp;
}

/* A heading over a group of rows. */
.opt-section {
	display: block;
	margin: 18dp 0 4dp;
	font-size: 12dp;
	font-weight: bold;
	letter-spacing: 2dp;
	color: token(text-secondary);
}

.opt-page-title + .opt-section {
	margin-top: 8dp;
}

/* The active page, scrolling (base.rcss's .scroll-pane) when its rows don't fit. Absolute, so the
   pane's width never depends on its content: a flex item that scrolls shrinks its rows to nothing. */
.opt-scroll {
	position: absolute;
	left: 0;
	right: 0;
	top: 0;
	bottom: 0;
	padding: 22dp 28dp;
}

/* .hidden ties with this rule's display at equal specificity, so it is restated. */
.opt-page {
	display: block;
	max-width: 760dp;
}
.opt-page.hidden {
	display: none;
}
.opt-page-title {
	padding-bottom: 10dp;
	margin-bottom: 6dp;
	border-bottom: 1dp rgba(255, 255, 255, 30);
	font-size: 17dp;
	font-weight: bold;
	letter-spacing: 2dp;
	text-transform: uppercase;
	color: token(text-primary);
}

/* A setting: label on the left, its control in a fixed column on the right. pointer-events on the
   row gives every row a hover, not only the clickable ones. */
.opt-row {
	position: relative;
	display: flex;
	align-items: center;
	height: 44dp;
	padding: 0 12dp;
	border-bottom: 1dp rgba(255, 255, 255, 14);
	pointer-events: auto;
}
.opt-row:hover {
	background-color: rgba(255, 255, 255, 12);
}
.opt-toggle-row {
	cursor: pointer;
}
/* A toggle needs only its own width; the label keeps the rest. */
.opt-toggle-row .opt-control {
	width: auto;
}
.opt-label {
	flex: 1 1 0;
	margin-right: 16dp;
	overflow: hidden;
	white-space: nowrap;
	font-size: 12dp;
	color: token(text-primary);
}
/* The control column takes a share of the row, so long labels keep their room on a narrow screen. */
.opt-control {
	position: relative;
	flex: 0 0 auto;
	width: 46%;
	max-width: 280dp;
	display: flex;
	align-items: center;
	justify-content: flex-end;
}

/* Toggle switch, driven by the same checked flags the legacy checkboxes use. */
.opt-toggle {
	position: relative;
	width: 40dp;
	height: 20dp;
	border: 1dp rgba(255, 255, 255, 60);
	border-radius: 11dp;
	background-color: rgba(255, 255, 255, 26);
	box-shadow: inset 0 1dp 3dp rgba(0, 0, 0, 120);
	transition: background-color 0.12s quadratic-out;
}
.opt-toggle-knob {
	position: absolute;
	left: 2dp;
	top: 2dp;
	width: 16dp;
	height: 16dp;
	border-radius: 8dp;
	background-color: token(text-primary);
	box-shadow: 0 1dp 2dp rgba(0, 0, 0, 150);
	transition: left 0.12s quadratic-out;
}
.opt-toggle.checked {
	background-color: rgba(196, 148, 60, 210);
	border-color: token(accent-gold-hover);
}
.opt-toggle.checked .opt-toggle-knob {
	left: 22dp;
	background-color: #fff6e6;
}
.opt-toggle-row:hover .opt-toggle {
	border-color: rgba(255, 255, 255, 110);
}
.opt-toggle-row:hover .opt-toggle.checked {
	border-color: #f0d29a;
}

/* Sliders: base.rcss's level gauge as a thin rounded track with a glowing gold fill and a thumb
   at the fill's end. The hit area reaches past the track so a thin bar is still easy to grab. */
.opt-slider {
	position: relative;
	flex: 1 1 0;
	height: 6dp;
	border-width: 0;
	border-radius: 3dp;
	background-color: rgba(255, 255, 255, 34);
}
.opt-slider .level-gauge-fill {
	left: 0;
	top: 0;
	bottom: 0;
	border-radius: 3dp;
	background-color: token(accent-gold);
	decorator: linear-gradient(to right, #8f6922, token(accent-gold-hover));
	box-shadow: 0 0 6dp rgba(226, 185, 109, 110);
}
.opt-slider-thumb {
	position: absolute;
	right: -7dp;
	top: -4dp;
	width: 14dp;
	height: 14dp;
	border-radius: 7dp;
	background-color: #fff6e6;
	box-shadow: 0 0 0 3dp rgba(196, 148, 60, 90), 0 1dp 3dp rgba(0, 0, 0, 160);
}
.opt-slider-step {
	position: absolute;
	top: -2dp;
	bottom: -2dp;
	width: 2dp;
	margin-left: -1dp;
	background-color: rgba(15, 18, 21, 220);
}
.opt-slider-step-1 { left: 20%; }
.opt-slider-step-2 { left: 40%; }
.opt-slider-step-3 { left: 60%; }
.opt-slider-step-4 { left: 80%; }
.opt-slider-hit {
	left: -8dp;
	right: -8dp;
	top: -10dp;
	bottom: -10dp;
}
.opt-value {
	flex: 0 0 auto;
	width: 48dp;
	margin-left: 14dp;
	text-align: right;
	white-space: nowrap;
	font-size: 12dp;
	color: token(accent-gold-hover);
}

/* Dropdowns. The list is near-opaque so its entries stay legible over the scene. z-index 1 keeps
   an open list above the rows after it. */
.option-dropdown {
	position: relative;
	width: 100%;
	height: 30dp;
}
.option-dropdown-value {
	display: block;
	position: relative;
	box-sizing: border-box;
	width: 100%;
	height: 30dp;
	line-height: 28dp;
	padding: 0 32dp 0 12dp;
	white-space: nowrap;
	overflow: hidden;
	cursor: pointer;
	pointer-events: auto;
	font-size: 12dp;
	color: token(text-primary);
	background-color: rgba(255, 255, 255, 18);
	border: 1dp rgba(255, 255, 255, 56);
	border-radius: 4dp;
}
.option-dropdown-value:hover {
	background-color: rgba(255, 255, 255, 28);
	border-color: rgba(255, 255, 255, 110);
}
.option-dropdown-value.open {
	border-color: token(accent-gold);
}
.opt-caret {
	position: absolute;
	right: 13dp;
	top: 9dp;
	width: 6dp;
	height: 6dp;
	border-right: 2dp token(text-secondary);
	border-bottom: 2dp token(text-secondary);
	transform: rotate(45deg);
}
.option-dropdown-value.open .opt-caret {
	top: 13dp;
	transform: rotate(-135deg);
	border-color: token(accent-gold-hover);
}
.option-dropdown-list {
	display: block;
	position: absolute;
	box-sizing: border-box;
	left: 0;
	top: 100%;
	width: 100%;
	max-height: 220dp;
	margin-top: 4dp;
	padding: 4dp 0;
	overflow-y: auto;
	z-index: 1;
	pointer-events: auto;
	background-color: rgba(17, 20, 23, 242);
	border: 1dp rgba(255, 255, 255, 60);
	border-radius: 4dp;
	box-shadow: 0 10dp 24dp rgba(0, 0, 0, 170);
}
.option-dropdown-list.hidden {
	display: none;
}
/* A sized scrollbar; unstyled, its hit area can cover the entries and swallow their clicks. */
.option-dropdown-list scrollbarvertical {
	width: 6dp;
	margin: 0 2dp 0 0;
}
.option-dropdown-list scrollbarvertical slidertrack {
	background-color: rgba(255, 255, 255, 0);
}
.option-dropdown-list scrollbarvertical sliderbar {
	background-color: rgba(255, 255, 255, 60);
	border-radius: 3dp;
}
.option-dropdown-list scrollbarvertical sliderbar:hover,
.option-dropdown-list scrollbarvertical sliderbar:active {
	background-color: rgba(255, 255, 255, 120);
}
.option-dropdown-list scrollbarvertical sliderarrowdec,
.option-dropdown-list scrollbarvertical sliderarrowinc {
	width: 0;
	height: 0;
}
.option-dropdown-option {
	display: block;
	height: 28dp;
	line-height: 28dp;
	padding: 0 12dp;
	white-space: nowrap;
	cursor: pointer;
	pointer-events: auto;
	font-size: 12dp;
	color: token(text-secondary);
}
.option-dropdown-option:hover {
	color: token(text-primary);
	background-color: rgba(255, 255, 255, 20);
}
.option-dropdown-option.selected {
	color: token(accent-gold-hover);
	background-color: rgba(196, 148, 60, 44);
}

/* The UI Scale row explains itself in a tip under the row on hover; its list opens upwards so the
   two do not collide. */
.opt-row-tip {
	display: none;
	position: absolute;
	left: 12dp;
	top: 100%;
	width: 360dp;
	margin-top: 4dp;
	padding: 8dp 10dp;
	z-index: 2;
	pointer-events: none;
	font-size: 11dp;
	color: token(text-secondary);
	background-color: rgba(17, 20, 23, 242);
	border: 1dp rgba(255, 255, 255, 60);
	border-radius: 4dp;
}
.opt-row-tipped:hover .opt-row-tip {
	display: block;
}
.option-opens-up .option-dropdown-list {
	top: auto;
	bottom: 100%;
	margin-top: 0;
	margin-bottom: 4dp;
}

/* Footer: a keycap hint for the close action. */
.opt-footer {
	flex: 0 0 auto;
	display: flex;
	align-items: center;
	justify-content: flex-end;
	height: 48dp;
	margin-top: 16dp;
	border-top: 1dp rgba(255, 255, 255, 30);
}
.opt-footer-action {
	display: flex;
	align-items: center;
	padding: 6dp 10dp;
	cursor: pointer;
	border-radius: 4dp;
}
.opt-footer-action:hover {
	background-color: rgba(255, 255, 255, 18);
}
.opt-keycap {
	height: 21dp;
	line-height: 21dp;
	padding: 0 8dp;
	margin-right: 10dp;
	font-size: 11dp;
	font-weight: bold;
	color: token(text-primary);
	background-color: rgba(255, 255, 255, 22);
	border: 1dp rgba(255, 255, 255, 90);
	border-bottom-width: 2dp;
	border-radius: 3dp;
}
.opt-footer-label {
	height: 24dp;
	line-height: 25dp;
	font-size: 13dp;
	letter-spacing: 1.5dp;
	text-transform: uppercase;
	color: token(text-primary);
}
.opt-footer-action:hover .opt-footer-label {
	color: token(accent-gold-hover);
}

/* A short screen (a small window or a large UI scale): tighter margins, header, rail and rows, so
   the longest page still fits under the header and above the footer. */
@media (max-height: 560dp) {
	.opt-shell { left: 4%; right: 4%; top: 3%; bottom: 3%; }
	.opt-header { height: 40dp; }
	.opt-title { font-size: 18dp; letter-spacing: 3dp; }
	.opt-close { width: 30dp; height: 30dp; }
	.opt-close-bar { left: 5dp; top: 14dp; }
	.opt-body { margin-top: 10dp; }
	.opt-nav-item { height: 32dp; line-height: 32dp; margin-bottom: 2dp; }
	.opt-scroll { padding: 12dp 16dp; }
	.opt-page-title { padding-bottom: 6dp; margin-bottom: 4dp; font-size: 14dp; }
	.opt-row { height: 34dp; }
	.opt-footer { height: 36dp; margin-top: 8dp; }
}
/* A narrow screen gives the rail less width and the rows more. */
@media (max-width: 760dp) {
	.opt-nav { width: 140dp; margin-right: 12dp; }
	.opt-nav-item { padding-left: 10dp; letter-spacing: 1dp; }
	.opt-control { width: 44%; }
	.opt-toggle-row .opt-control { width: auto; }
	.opt-label { white-space: normal; line-height: 14dp; }
}

/* A setting another one already covers (OptionWindow.h's OptionRmlModel): shown ticked, dimmed, and
   not clickable. */
.opt-toggle-row.locked {
	opacity: 0.45;
	cursor: default;
}
/* A locked row with a tip dims its label and switch, not itself: the tip would inherit the dimming. */
.opt-toggle-row.opt-row-tipped.locked {
	opacity: 1;
}
.opt-toggle-row.opt-row-tipped.locked .opt-label,
.opt-toggle-row.opt-row-tipped.locked .opt-control {
	opacity: 0.45;
}

/* The player's tuning of each Enhanced feature (OptionWindow.h's tuning rows), under the feature's
   row. The feature's label and chevron expand its sliders; only the switch switches the feature.
   A locked feature dims its switch, not its label, which still expands the tuning. */
.opt-tuning-group-row {
	cursor: default;
}
.opt-tuning-group-row.locked {
	opacity: 1;
}
.opt-tuning-group-row.locked .opt-toggle {
	opacity: 0.45;
}
.opt-tuning-group-row .opt-toggle {
	cursor: pointer;
}
.opt-tuning-group-label {
	cursor: pointer;
}
.opt-tuning-group-label:hover {
	color: token(accent-gold-hover);
}
/* An arrow before the label: pointing right while collapsed, down while expanded. */
.opt-tuning-chevron {
	display: inline-block;
	width: 6dp;
	height: 6dp;
	margin: 0 8dp 1dp 0;
	border-right: 2dp token(text-secondary);
	border-bottom: 2dp token(text-secondary);
	transform: rotate(-45deg);
}
.opt-tuning-chevron.expanded {
	transform: rotate(45deg);
	border-color: token(accent-gold-hover);
}
/* .hidden ties with these rules' display at equal specificity, so it is restated. */
.opt-tuning-group,
.opt-tuning-more,
.opt-tuning-rows {
	display: block;
}
.opt-tuning-group {
	padding: 4dp 12dp 8dp 28dp;
	border-bottom: 1dp rgba(255, 255, 255, 14);
	background-color: rgba(255, 255, 255, 6);
}
.opt-tuning-group.hidden,
.opt-tuning-more.hidden,
.opt-tuning-reason.hidden,
.opt-tuning-error.hidden {
	display: none;
}
.opt-tuning-reason {
	display: block;
	padding: 6dp 0;
	font-size: 11dp;
	color: token(semantic-warning);
}
.opt-tuning-row {
	position: relative;
	display: block;
	padding: 6dp 0 8dp;
	border-bottom: 1dp rgba(255, 255, 255, 10);
	pointer-events: auto;
}
.opt-tuning-head {
	display: flex;
	align-items: center;
	height: 20dp;
}
.opt-tuning-label {
	flex: 1 1 0;
	overflow: hidden;
	white-space: nowrap;
	font-size: 12dp;
	color: token(text-primary);
}
.opt-tuning-state {
	flex: 0 0 auto;
	margin-left: 10dp;
	font-size: 11dp;
	color: token(text-muted);
}
.opt-tuning-state.custom {
	color: token(accent-gold-hover);
}
.opt-tuning-state.unsaved {
	color: token(semantic-warning);
}
.opt-tuning-value {
	flex: 0 0 auto;
	margin-left: 10dp;
	white-space: nowrap;
	font-size: 12dp;
	color: token(accent-gold-hover);
}
.opt-tuning-reset {
	flex: 0 0 auto;
	margin-left: 10dp;
	padding: 2dp 8dp;
	cursor: pointer;
	pointer-events: auto;
	font-size: 11dp;
	color: token(text-secondary);
	border: 1dp rgba(255, 255, 255, 60);
	border-radius: 3dp;
	background-color: rgba(255, 255, 255, 14);
}
.opt-tuning-reset:hover {
	color: token(accent-gold-hover);
	border-color: token(accent-gold);
}
.opt-tuning-track {
	display: flex;
	align-items: center;
	height: 20dp;
}
.opt-tuning-bound {
	flex: 0 0 auto;
	width: 64dp;
	white-space: nowrap;
	font-size: 11dp;
	color: token(text-muted);
}
.opt-tuning-track .opt-tuning-bound:last-child {
	text-align: right;
}
/* The volume slider's rail and fill (.opt-slider), with room for the bounds beside it. */
.opt-tuning-slider {
	margin: 0 12dp;
}
.opt-tuning-hit {
	left: -8dp;
	right: -8dp;
	top: -8dp;
	bottom: -8dp;
	border-radius: 4dp;
}
.opt-tuning-hit:focus {
	border: 1dp token(accent-gold);
}
.opt-tuning-group.locked .opt-tuning-track {
	opacity: 0.45;
}
.opt-tuning-group.locked .opt-tuning-hit {
	cursor: default;
}
.opt-tuning-more-head {
	display: block;
	padding: 8dp 0 4dp;
	cursor: pointer;
	pointer-events: auto;
	font-size: 12dp;
	color: token(text-secondary);
}
.opt-tuning-more-head:hover {
	color: token(accent-gold-hover);
}
.opt-tuning-actions {
	display: flex;
	justify-content: flex-end;
	padding-top: 6dp;
}
.opt-tuning-all {
	padding: 8dp 12dp;
	border-bottom: 1dp rgba(255, 255, 255, 14);
}
.opt-tuning-error {
	display: block;
	padding: 8dp 12dp;
	font-size: 12dp;
	color: token(semantic-warning);
}

/* ---- handmade/option_window.rcss: the Kryon look, appended so it wins by source order. ---- */
/* Kryon settings screen: modern's full-screen layout with the web's settings look instead of
   frosted glass -- a dark steel scrim, the title in spaced capitals over a gold rule, the
   categories as framed tabs, the page on a Kryon card, bronze switches and sliders, dark input
   wells for the dropdowns and framed keycaps. */

#panel {
	background-color: rgba(2, 4, 6, 214);
	decorator: radial-gradient(ellipse, rgba(20, 23, 27, 120) 0%, rgba(2, 4, 6, 230) 100%);
}

/* Header */
.opt-header {
	border-bottom: 1dp token(kryon-divider);
}
.opt-title {
	padding-left: 0;
	border-left-width: 0;
	font-family: "token(font-title)";
	font-size: 18dp;
	font-weight: normal;
	letter-spacing: 4dp;
	color: token(text-warm);
	font-effect: shadow(0dp 1dp #000000);
}
.opt-close {
	border: 1dp token(kryon-tab-idle-border);
	border-radius: token(radius-sm)dp;
	background-color: token(kryon-tab-idle);
}
.opt-close:hover {
	border-color: token(kryon-btn-border-hover);
	background-color: token(kryon-row-hover);
}
.opt-close-bar {
	background-color: token(kryon-title);
}

/* Category tabs */
.opt-nav-item {
	margin-bottom: 6dp;
	padding-left: 14dp;
	border: 1dp token(kryon-tab-idle-border);
	border-radius: token(radius-sm)dp;
	background-color: token(kryon-tab-idle);
	font-family: "token(font-title)";
	font-size: 11dp;
	letter-spacing: 2dp;
	color: token(kryon-tab-idle-text);
}
.opt-nav-item:hover {
	color: token(kryon-btn-text-hover);
	border-color: token(kryon-btn-border-hover);
	background-color: token(kryon-row-hover);
}
.opt-nav-item.active-tab {
	color: token(kryon-tab-text);
	background-color: token(kryon-tab-bottom);
	decorator: linear-gradient(180deg, token(kryon-tab-top) 0%, token(kryon-tab-bottom) 100%);
	border-color: token(kryon-tab-border);
	box-shadow: inset 0 0 0 1dp #130e08, inset 3dp 0 0 rgba(217, 154, 67, 217);
}

/* The page: a Kryon card */
.opt-pane {
	background-color: token(kryon-card-bottom);
	backdrop-filter: none;
	decorator:
		radial-gradient(circle at 50% 0%, token(kryon-card-glow), transparent 55%),
		linear-gradient(110deg, token(kryon-card-top) 0%, token(kryon-card-mid) 50%, token(kryon-card-bottom) 100%);
	border: 1dp token(kryon-card-border);
	border-radius: token(radius-md)dp;
	box-shadow:
		0 0 0 3dp token(kryon-ring-outer),
		0 0 0 4dp token(kryon-ring-gold),
		0 16dp 40dp rgba(0, 0, 0, 187),
		inset 0 0 0 5dp token(kryon-ring-inner-dark),
		inset 0 0 0 6dp token(kryon-filete);
}
.opt-page-title {
	border-bottom: 1dp token(kryon-divider);
	font-family: "token(font-title)";
	font-size: 12dp;
	font-weight: normal;
	letter-spacing: 2.5dp;
	color: token(kryon-title);
}
.opt-section {
	color: token(kryon-title);
	letter-spacing: 1.6dp;
}
.opt-row {
	border-bottom: 1dp token(kryon-row-divider);
}
.opt-row:hover {
	background-color: token(kryon-row-hover);
}
.opt-label {
	color: token(text-primary);
}

/* Switches and sliders */
.opt-toggle {
	border: 1dp token(kryon-well-border);
	border-radius: 11dp;
	background-color: token(kryon-well-top);
	box-shadow: inset 0 1dp 4dp #000000;
}
.opt-toggle-knob {
	background-color: token(kryon-label);
}
.opt-toggle.checked {
	background-color: token(kryon-gold-fill-bottom);
	border-color: token(kryon-well-focus);
}
.opt-toggle.checked .opt-toggle-knob {
	background-color: token(kryon-btn-text);
}
.opt-toggle-row:hover .opt-toggle {
	border-color: token(kryon-btn-border-hover);
}
.opt-toggle-row:hover .opt-toggle.checked {
	border-color: token(kryon-btn-text-hover);
}
.opt-slider {
	background-color: token(kryon-well-top);
	box-shadow: inset 0 1dp 3dp #000000;
}
.opt-slider .level-gauge-fill {
	decorator: linear-gradient(90deg, #713810 0%, #d99a38 60%, #ffdc8c 100%);
}
.opt-slider-thumb {
	background-color: token(kryon-btn-text);
}
.opt-value {
	color: token(kryon-btn-text);
}

/* Dropdowns: input wells */
.option-dropdown-value {
	background-color: token(kryon-well-top);
	decorator: linear-gradient(180deg, token(kryon-well-top) 0%, token(kryon-well-bottom) 100%);
	border: 1dp token(kryon-well-border);
	border-radius: token(radius-sm)dp;
	box-shadow: inset 0 2dp 7dp #000000;
	color: token(kryon-field-text);
}
.option-dropdown-value:hover {
	background-color: token(kryon-well-bottom);
	border-color: token(kryon-btn-border-hover);
}
.option-dropdown-value.open {
	border-color: token(kryon-well-focus);
}
.opt-caret {
	border-color: token(kryon-title);
}
.option-dropdown-list,
.opt-row-tip {
	background-color: rgba(8, 10, 13, 245);
	border: 1dp token(kryon-card-border);
	border-radius: token(radius-sm)dp;
}
.option-dropdown-list scrollbarvertical sliderbar {
	background-color: token(kryon-scroll-thumb);
}
.option-dropdown-list scrollbarvertical sliderbar:active {
	background-color: token(kryon-scroll-thumb-hover);
}
.option-dropdown-option:hover {
	background-color: token(kryon-row-hover);
}
.option-dropdown-option.selected {
	color: token(kryon-btn-text);
	background-color: rgba(211, 174, 102, 40);
}

/* Footer keycaps */
.opt-footer-action:hover {
	background-color: token(kryon-row-hover);
}
.opt-keycap {
	color: token(kryon-tab-text);
	background-color: token(kryon-tab-idle);
	decorator: linear-gradient(180deg, token(kryon-card-top) 0%, token(kryon-tab-idle) 100%);
	border: 1dp token(kryon-tab-border);
	border-radius: token(radius-sm)dp;
	font-family: "token(font-title)";
}
.opt-footer-label {
	letter-spacing: 1.4dp;
	text-transform: uppercase;
}
