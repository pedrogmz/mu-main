/* Generated by generate_theme.py: modern/quick_command.rcss retinted with tokens.json. */
/* Modern theme for CQuickCommandWindow: the same menu at the same place, on the modern panel
   surface instead of the command frame art; the player's name in the warm title colour, the
   hovered row in the gold accent. Geometry is the legacy one (reference px under the UI
   scale, see quick_command.rml). */

#panel {
	position: absolute;
	transform-origin: left top;
	width: 112px;
	height: 140px;
	font-family: "token(font-body)";
	background-color: token(surface-panel);
	border: 1px token(border-frame);
	border-radius: token(radius-sm)px;
}

#back, #frame_up, .frame-middle, #frame_down, .arrow { display: none; }
.line { position: absolute; left: 15px; width: 82px; height: 1px; background-color: token(metal-mid); }

#name {
	display: block;
	position: absolute;
	left: 0;
	top: 14px;
	text-align: center;
	white-space: nowrap;
	color: token(text-warm);
	font-weight: bold;
}

#rows { position: absolute; left: 0; top: 43px; width: 112px; }
.quick-row { display: block; position: relative; width: 112px; height: 19px; }
.quick-row:hover { background-color: token(surface-raised); }
.quick-label {
	display: block;
	position: absolute;
	left: 0;
	top: 1px;
	text-align: center;
	white-space: nowrap;
	color: token(text-primary);
}
.quick-row:hover .quick-label { color: token(accent-gold-hover); }

/* The frame's own middle bands and its separator lines, so a theme can move them -- they were
   style attributes, which are inline properties no theme can override. */
.frame-middle-1 { top: 45px; }
.frame-middle-2 { top: 60px; }
.frame-middle-3 { top: 75px; }
.frame-middle-4 { top: 90px; }
.line-1 { top: 55px; }
.line-2 { top: 74px; }
.line-3 { top: 93px; }
.line-4 { top: 112px; }

/* Lengths inside counter-scaled layers: reference px times the panel's --root-scale. */
#name { width: calc(112px * var(--root-scale)); }
.quick-label { width: calc(112px * var(--root-scale)); }

/* ---- handmade/shared/flat_card.rcss: the Kryon look, appended so it wins by source order. ---- */
/* Kryon card for the small windows modern draws as a flat box (surface-panel fill, one border-frame
   line): event entries and timers, Kanturu, Cursed Temple, duel, quick command, window menu, message
   boxes, the in-game shop's frames... The rule's selector is filled in per stylesheet from
   tokens.json's handmadeShared. Sizes are px: these panels scale themselves. */

#panel {
	background-color: token(kryon-card-bottom);
	decorator:
		radial-gradient(circle at 50% 0%, token(kryon-card-glow), transparent 55%),
		linear-gradient(110deg, token(kryon-card-top) 0%, token(kryon-card-mid) 50%, token(kryon-card-bottom) 100%);
	border-width: 1px;
	border-color: token(kryon-card-border);
	border-radius: token(radius-md)px;
	box-shadow:
		0 0 0 2px token(kryon-ring-outer),
		0 0 0 3px token(kryon-ring-gold),
		0 10px 28px rgba(0, 0, 0, 170),
		inset 0 0 0 3px token(kryon-ring-inner-dark),
		inset 0 0 0 4px token(kryon-filete);
}
