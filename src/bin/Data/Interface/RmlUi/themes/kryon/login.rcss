/* Generated by generate_theme.py: modern/login.rcss retinted with tokens.json. */
/* Modern theme for the login dialog -- fully programmatic, flat colors/vector shapes instead of
   legacy art. Built from explicit RML layers (base.rcss's forged-dialog primitives) plus real
   box-shadow (inset/outset, blur, multiple shadows are all supported by this renderer) directly
   on the element it belongs to, so the shell reads as outer iron edge -> window surface -> inner
   groove.

   Engine notes: this engine's rgba() parses alpha as a 0-255 integer, not a 0-1 CSS float, so
   every color below is pre-converted (e.g. .62 -> 158). No ::before/::after, `content:`, or
   percentage border-radius. `transform: rotate()` is confirmed working and used for the
   hero-plate ornaments and the checkbox checkmark. */

body {
	width: 100%;
	height: 100%;
	margin: 0;
	pointer-events: none;
}

/* Window surface -- crimson belongs to the hero banner only, so #panel uses plain .modern-frame
   with background-color/decorator overridden to a neutral forged fill. Border is a single flat
   tone; real box-shadow carries the surface's depth (soft drop shadow, contact shadow, inner
   hairline, warm inner band).

   The frame strip between the shell-edge and inner groove needs to read lighter than the
   recessed well without leaking light inward -- brightening the decorator's top stop doesn't
   work since decorator paints #panel's entire box, not just this ring. The contrast instead comes
   from the inset box-shadow band, which is confined to a fixed 3dp spread (alpha 190/255). */
#panel {
    position: absolute;
    width: 329dp;
    height: 245dp;

    font-family: "token(font-body)";
    font-size: 12dp;
    color: token(text-primary);

    border-radius: token(radius-sm)dp;

    background-color: #08090a;
    decorator:
        linear-gradient(to bottom, #0e1114 0%, #08090a 100%);

    border-width: 1dp;
    border-color: token(border-frame);

    box-shadow:
        0 11dp 30dp rgba(0, 0, 0, 158),
        0 2dp 5dp rgba(0, 0, 0, 217),
        inset 0 0 0 1dp #08090a,
        inset 0 0 0 3dp rgba(132, 106, 62, 46);
}

/* Outer iron edge, -3dp. Transparent fill -- a solid fill here would read as a second opaque
   rectangle behind the window surface instead of a thin edge. Per-edge lighting is 4 separate
   inset box-shadows rather than border-*-color. */
.login-shell-edge {
    background-color: transparent;
    border-radius: token(radius-sm)dp;
    border-color: rgba(24, 28, 33, 242);

    box-shadow:
        inset 1dp 0 0 rgba(178, 146, 92, 28),
        inset -1dp 0 0 rgba(0, 0, 0, 204),
        inset 0 1dp 0 rgba(190, 163, 117, 20),
        inset 0 -1dp 0 rgba(0, 0, 0, 230);
}

/* Inner groove, ~4dp inward -- flat border plus a thin warm hairline and a broad 12dp inward
   darkness; the darkness is what sells the recessed/carved look, the border alone reads too
   thin. */
.login-groove {
    position: absolute;

    left: 4dp;
    right: 4dp;
    top: 4dp;
    bottom: 4dp;

    pointer-events: none;

    border-width: 1dp;
    border-color: #1d2228;

    box-shadow:
        inset 0 0 0 1dp rgba(169, 136, 80, 15),
        inset 0 0 12dp rgba(0, 0, 0, 153);
}

/* The hero-banner IS Login's header, not nested inside a metal rail -- metal rail and crimson
   hero-banner are alternative header styles, never combined. Depth comes from base.rcss's
   .modern-title-plate box-shadow. */
.login-hero-banner {
	left: 8dp;
	right: 8dp;
	top: 8dp;
	height: 37dp;
}

/* Ornaments are diamonds inside the plate (8dp from its edges) -- an 11x11 square rotated 45deg,
   not external end-caps. */
.login-hero-cap {
	position: absolute;
	top: 50%;
	width: 11dp;
	height: 11dp;
	margin-top: -5.5dp;
	background-color: #2a1f10;
	border-width: 1dp;
	border-color: #78592c;
	transform: rotate(45deg);
	pointer-events: none;
	box-shadow:
		inset 1dp 1dp 0 rgba(255, 216, 145, 9),
		inset -1dp -1dp 0 rgba(0, 0, 0, 173);
}
.login-hero-cap-left { left: 8dp; }
.login-hero-cap-right { right: 8dp; }

.label {
	position: absolute;
	font-family: "token(font-body)";
}

/* Positioned via absolute + text-align rather than flex centering -- this engine's flex layout
   doesn't treat a bare mustache-bound text node as a real flex item, so it didn't render at all
   inside a flex container. top:11dp eyeballed to vertical-center the line in the 37dp banner. */
.label-server {
	position: absolute;
	left: 0;
	right: 0;
	top: 11dp;
	text-align: center;
	color: #e1ae4e;
	font-family: "token(font-title)";
	font-size: 13dp;
	font-weight: 500;
	letter-spacing: 0.26dp;
	font-effect: shadow(0dp 1dp #000000);
}

/* Username/password fields. Placement/size only -- appearance comes from base.rcss's shared
   .text-field, minus the fill/border, since .login-input's recessed well already draws each field's visual. Box sits
   where the native CUITextInputBox overlay did (the old anchor position at its Init()'d 140x14),
   and the text colour matches its SetTextColor(255, 230, 210). */
.login-field {
	position: absolute;
	width: 140dp;
	height: 16dp;
	padding: 0;
	font-family: "token(font-body)";
	color: token(text-primary);
	background-color: transparent;
	border-width: 0;
	box-shadow: none;
	decorator: none;
}
/* Relative to .login-content, this field's parent -- each .login-input's own left/top (100/16, 49)
   plus the 6dp inset that puts the caret at the frame's inner edge. NOT the #panel-relative 115/72
   the old anchors used: those were #panel children, these are not. */
.login-field-account  { left: 106dp; top: 22dp; }
.login-field-password { left: 106dp; top: 55dp; }

/* Body is a real recessed cavity; broad inset shadow comes from base.rcss's .modern-content-well. */
.login-content {
	left: 9dp;
	right: 9dp;
	top: 50dp;
	height: 139dp;
	pointer-events: none;
}

/* Coordinates are local to .login-content. color #8d835f is a muted brass tone, distinct from
   the general-purpose token(text-secondary) gray. */
.label-account {
	left: 21dp;
	top: 25dp;
	font-size: 8dp;
	font-weight: 600;
	letter-spacing: 0.64dp;
	color: #b89b68;
}
.label-password {
	left: 21dp;
	top: 58dp;
	font-size: 8dp;
	font-weight: 600;
	letter-spacing: 0.64dp;
	color: #b89b68;
}

.login-input {
	position: absolute;
	width: 156dp;
	height: 23dp;
	pointer-events: none;
	border-radius: token(radius-sm)dp;
}
.login-input-account  { left: 100dp; top: 16dp; }
.login-input-password { left: 100dp; top: 49dp; }

.checkbox-row {
	position: absolute;
	cursor: pointer;
	pointer-events: auto;
}
.checkbox-remember-me   { left: 100dp; top: 84dp; }
.checkbox-save-password { left: 100dp; top: 108dp; }

/* Checkbox look is uniform everywhere (base.rcss's .checkbox-box/.checkbox-box.checked), no
   per-instance override. Checkmark is a single 6x3 box with a left+bottom border rotated -45deg,
   forming a check stroke. */
.checkbox-tick {
	display: none;
	position: absolute;
	left: 2dp;
	top: 1dp;
	width: 6dp;
	height: 3dp;
	border-left: 2dp #171106;
	border-bottom: 2dp #171106;
	transform: rotate(-45deg);
}
.checkbox-box.checked .checkbox-tick {
	display: block;
}

/* Footer is a structural container only (base.rcss's .modern-footer-band) -- one plain border-top
   carries the entire body-to-footer separation. */
.login-footer {
	left: 9dp;
	right: 9dp;
	top: 190dp;
	height: 46dp;
	bottom: auto;
	pointer-events: none;
	border-top-width: 1dp;
	border-top-color: #1d2127;
}

/* Position/size only -- color/box-shadow/font are inherited from base.rcss's shared .btn/.btn-ok,
   so all consumers stay in sync. */
.login-btn {
	top: 8dp;
	width: 76dp;
	height: 26dp;
	line-height: 26dp;
}

.login-btn-ok {
	left: 145dp;
}

.login-btn-cancel {
	left: 226dp;
}

.login-btn-label {
	position: relative;
	font-family: "token(font-body)";
}

/* Intentionally external to the forged dialog shell. top:257dp = 245dp window height + 12dp
   below it. */
.trust-warning {
	position: absolute;
	left: 30dp;
	top: 257dp;
	width: 280dp;
	font-size: 10dp;
	font-effect: shadow(0dp 1dp #000000);
	color: token(semantic-warning);
	font-family: "token(font-body)";
}

/* The buttons' click kinds (click-sound, UI/RmlBridge/RmlClickSounds.h): the Sound
   Editor's Events tab gives each kind its sound (interfaceClick). */
.btn-ok { click-sound: confirm; }
.btn-cancel { click-sound: cancel; }

/* ---- handmade/login.rcss: the Kryon look, appended so it wins by source order. ---- */
/* Kryon login, after the web's sign-in card: gold brackets in the top corners, the server name as
   a small spaced title over a divider, full-width field rows with their label inside, the two
   options on one line, a full-width bronze OK and a framed Cancel under it.

   Everything stays inside modern's 329 x 245 #panel: CLoginWin's hit-test rect is that size
   (LoginWin.cpp, RefreshLayout()), so nothing clickable may leave it. Coordinates are local to
   each element's parent, as in modern's login.rcss. */

#panel {
	background-color: token(kryon-card-bottom);
	decorator:
		radial-gradient(circle at 50% 0%, token(kryon-card-glow), transparent 55%),
		linear-gradient(110deg, token(kryon-card-top) 0%, token(kryon-card-mid) 50%, token(kryon-card-bottom) 100%);
	border-color: token(kryon-card-border);
	border-radius: token(radius-md)dp;
	box-shadow:
		0 0 0 3dp token(kryon-ring-outer),
		0 0 0 4dp token(kryon-ring-gold),
		0 16dp 40dp rgba(0, 0, 0, 187),
		inset 0 0 0 5dp token(kryon-ring-inner-dark),
		inset 0 0 0 6dp token(kryon-filete);
}
.login-shell-edge,
.login-groove {
	display: none;
}

/* Title: the plate becomes a divider line; its two diamonds become the corner brackets. */
.login-hero-banner {
	left: 22dp;
	right: 22dp;
	top: 14dp;
	height: 26dp;
}
.login-hero-cap {
	top: -4dp;
	width: 12dp;
	height: 12dp;
	margin-top: 0;
	background-color: transparent;
	border-width: 0;
	border-color: token(kryon-corner);
	transform: none;
	box-shadow: none;
}
.login-hero-cap-left {
	left: -12dp;
	border-top-width: 2dp;
	border-left-width: 2dp;
}
.login-hero-cap-right {
	right: -12dp;
	border-top-width: 2dp;
	border-right-width: 2dp;
}
.label-server {
	top: 6dp;
	color: token(kryon-title);
	font-size: 10dp;
	font-weight: normal;
	letter-spacing: 2.4dp;
	text-transform: uppercase;
}

/* Body: two full-width field rows, then the options. */
.login-content {
	left: 22dp;
	right: 22dp;
	top: 50dp;
	height: 100dp;
}
.login-input {
	left: 0;
	width: 285dp;
	height: 26dp;
}
.login-input-account  { top: 2dp; }
.login-input-password { top: 36dp; }

/* The labels come before the field wells in the markup, so they need z-index to sit inside them. */
.label-account,
.label-password {
	z-index: 1;
	left: 10dp;
	font-size: 7.5dp;
	font-weight: normal;
	letter-spacing: 1.4dp;
	text-transform: uppercase;
	color: token(kryon-label);
}
.label-account  { top: 11dp; }
.label-password { top: 45dp; }

.login-field {
	width: 190dp;
	height: 16dp;
	color: token(kryon-field-text);
	font-size: 10dp;
}
/* The row (.login-input) is the visible field; the input inside it draws nothing, focused or not. */
.login-field:focus {
	border-width: 0;
	box-shadow: none;
}
.login-field-account  { left: 86dp; top: 7dp; }
.login-field-password { left: 86dp; top: 41dp; }

.checkbox-remember-me   { left: 1dp; top: 74dp; }
.checkbox-save-password { left: 146dp; top: 74dp; }
.checkbox-label {
	font-size: 8.5dp;
}
.checkbox-tick {
	border-left-color: #1a1206;
	border-bottom-color: #1a1206;
}

/* Footer: the primary action on its own full-width row, Cancel under it. */
.login-footer {
	left: 22dp;
	right: 22dp;
	top: 150dp;
	height: 82dp;
	border-top-width: 0;
}
.login-btn {
	left: 0;
	width: 285dp;
	letter-spacing: 1.2dp;
	text-transform: uppercase;
}
.login-btn-ok {
	top: 4dp;
	height: 30dp;
	line-height: 30dp;
	font-size: 10dp;
}
.login-btn-cancel {
	left: 0;
	top: 42dp;
	height: 24dp;
	line-height: 24dp;
	font-size: 8.5dp;
}
.login-btn-label {
	font-family: "token(font-title)";
}

.trust-warning {
	font-family: "token(font-body)";
}
