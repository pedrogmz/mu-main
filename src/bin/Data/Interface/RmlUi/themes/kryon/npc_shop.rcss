/* Generated by generate_theme.py: modern/npc_shop.rcss retinted with tokens.json. */
/* Modern theme for CNPCShop's chrome -- header/repair-buttons/repair-money strip are vector
   forged-metal chrome (matching Login/SysMenu/MyInventory/Storage Ext's forged-dialog language).
   The grid's items stay live 3D, drawn by C++. No exit button -- the frame's corner "X" closes
   it. */

#panel {
	position: absolute;
	transform-origin: left top;
	width: 190px;
	height: 429px;
	font-family: "token(font-body)";
}

/* top:7 matches MyInventory/SysMenu's own rail top (keeps .modern-joint-px's rivet at the same
   -1px relative to the frame's shell edge at -3px -- contained, identical relationship to
   those windows). height:42 (not MyInventory's 36, or Storage Ext's 29) budgets for this window's
   own TWO-line title (title + tax-rate) rather than either reference's single line -- this grid
   starts at `m_Pos.y + 50` (NPCShop.cpp), a full 50px budget: ends at 49px, 1px clear. */
.shop-header-rail {
	top: 7px;
	height: 42px;
}

/* Overrides modern-header-text-px's left-aligned single-line layout with a full-width centered
   two-line block, matching this window's own native RT3_SORT_CENTER title/tax-rate lines (unlike
   MyInventory/Storage Ext's left-aligned single title). margin-top approximates vertical centering
   of the ~24px-tall two-line block within the 42px rail. */
.shop-header-text-px {
	left: 0;
	width: 190px;
	text-align: center;
	margin-top: -13px;
}
.shop-tax-rate-px {
	display: block;
	margin-top: 2px;
}

/* Repair/Repair-All buttons: same 37x26 chrome as every other CInventoryCtrl-owning window's
   corner buttons (base.rcss's .modern-icon-btn-px). Both use the same repair glyph -- the native
   buttons shared one identical sprite (newui_repair_00.tga) too, differing only by tooltip. */
.shop-btn-repair     { left: 54px; }
.shop-btn-repair-all { left: 98px; }

/* Repair-money strip: this window's own 10/355/170/24 native geometry (RenderRepairMoney()), not
   MyInventory's 15/366/160 gold-strip column -- overridden per .modern-wallet-px's own base.rcss
   comment inviting exactly this for a window whose layout doesn't share Inventory's column. */
.shop-repair-wallet {
	left: 10px;
	top: 355px;
	width: 170px;
	height: 24px;
}
.shop-repair-value {
	top: 360px;
}
.shop-repair-wallet.hidden,
.shop-repair-value.hidden {
	display: none;
}

/* Native item grid: the first cell's top-left, in #panel's units. */
.native-anchor { position: absolute; pointer-events: none; }
#item_grid, #item_grid_counts { left: 15px; top: 50px; width: calc(8 * var(--item-cell)); height: calc(15 * var(--item-cell)); }

/* The frame. */
.bg-panel {
	position: absolute;
	left: 0;
	top: 0;
	width: 190px;
	height: 429px;
	pointer-events: none;
	border-radius: token(radius-sm)px;
	background-color: #08090a;
	decorator: linear-gradient(to bottom, #0e1114 0%, #08090a 100%);
	border-width: 1px;
	border-color: token(border-frame);
	box-shadow:
		0 11px 30px rgba(0, 0, 0, 158),
		0 2px 5px rgba(0, 0, 0, 217),
		inset 0 0 0 1px #08090a,
		inset 0 0 0 3px rgba(174, 140, 82, 190);
}

.inv-shell-edge {
	position: absolute;
	left: -3px;
	right: -3px;
	top: -3px;
	bottom: -3px;
	pointer-events: none;
	background-color: transparent;
	border-radius: token(radius-sm)px;
	border-width: 1px;
	border-color: rgba(24, 28, 33, 242);
	box-shadow:
		inset 1px 0 0 rgba(178, 146, 92, 110),
		inset -1px 0 0 rgba(0, 0, 0, 204),
		inset 0 1px 0 rgba(190, 163, 117, 90),
		inset 0 -1px 0 rgba(0, 0, 0, 230);
}

.inv-groove {
	position: absolute;
	left: 4px;
	right: 4px;
	top: 4px;
	bottom: 4px;
	pointer-events: none;
	border-width: 1px;
	border-color: #1d2228;
	box-shadow:
		inset 0 0 0 1px rgba(169, 136, 80, 40),
		inset 0 0 12px rgba(0, 0, 0, 153);
}

/* Rail fill/accent relocated from the fg's now paint-less .modern-header-rail-px -- see
   base.rcss's comment on that class. top/height match .shop-header-rail (npc_shop.rcss). */
.rail-fill {
	position: absolute;
	left: 8px;
	right: 8px;
	top: 7px;
	height: 42px;
	pointer-events: none;
	background-color: token(metal-dark);
	decorator:
		linear-gradient(to bottom, rgba(205, 178, 129, 13), transparent 31%),
		linear-gradient(to bottom, token(metal-rail), #121519 45%, token(metal-rail-dark));
	border-width: 1px;
	border-color: token(border-rail);
	border-bottom-color: #121518;
	box-shadow:
		inset 0 1px 0 rgba(235, 212, 169, 18),
		inset 0 -1px 0 #000000,
		0 2px 4px rgba(0, 0, 0, 133);
}
/* Nested inside .rail-fill -- its left/right/bottom resolve against that box. */
.rail-accent {
	position: absolute;
	left: 7px;
	right: 7px;
	bottom: 2px;
	height: 1px;
	pointer-events: none;
	opacity: 0.35;
	decorator: linear-gradient(to right,
		transparent,
		token(metal-warm-edge) 30%,
		#84714e 50%,
		token(metal-warm-edge) 70%,
		transparent);
}

/* The grid's clicks are native (CInventoryCtrl), so the placed panel takes no pointer events; its
   controls take their own. */
#panel.slot-placed { pointer-events: none; }

/* ---- handmade/shared/inventory_frame.rcss: the Kryon look, appended so it wins by source order. ---- */
/* Kryon frame for the item windows (inventory, storage, trade, shops, Chaos Machine, ...): they
   share modern's .bg-panel / .inv-shell-edge / .inv-groove / .rail-fill structure, each in its own
   stylesheet, so this overlay is appended to every one of them (tokens.json's handmadeShared).
   Every position stays modern's -- slots and grids are native anchors the client reads back for
   its hit tests -- so only the look changes: card and rings, the title over a divider, recessed
   slots and cells. */

.bg-panel {
	background-color: token(kryon-card-bottom);
	decorator:
		radial-gradient(circle at 50% 0%, token(kryon-card-glow), transparent 55%),
		linear-gradient(110deg, token(kryon-card-top) 0%, token(kryon-card-mid) 50%, token(kryon-card-bottom) 100%);
	border-width: 1px;
	border-color: token(kryon-card-border);
	border-radius: token(radius-md)px;
	box-shadow:
		0 0 0 3px token(kryon-ring-outer),
		0 0 0 4px token(kryon-ring-gold),
		0 16px 40px rgba(0, 0, 0, 187),
		inset 0 0 0 5px token(kryon-ring-inner-dark),
		inset 0 0 0 6px token(kryon-filete);
}
.inv-shell-edge {
	display: none;
}
.inv-groove {
	border-color: transparent;
	box-shadow: none;
}
.rail-fill {
	background-color: transparent;
	decorator: none;
	border-width: 0;
	border-bottom-width: 1px;
	border-bottom-color: token(kryon-divider);
	box-shadow: none;
}
.rail-accent {
	display: none;
}

/* Equipment slots and bag cells: dark wells with a faint bronze edge. */
.equip-slot {
	border-color: rgba(141, 116, 75, 90);
	background-color: rgba(4, 6, 9, 150);
}
#item_grid .item-cell-art,
.item-grid .item-cell-art {
	border-color: rgba(141, 116, 75, 46);
}


/* ---- handmade/npc_shop.rcss: the Kryon look, appended so it wins by source order. ---- */
/* Kryon NPC shop (merchant): its own details on top of shared/inventory_frame.rcss. */

/* Header: title and tax-rate line left-aligned with the item grid (x = 15px in #panel), each placed
   on its own line in the 42px rail. They used to stack in the flow, but the sharp-text title lays
   out at the physical size (13px * --root-scale) and only shrinks visually, so its layout height
   pushed the tax-rate line down onto the grid, where the cells covered it. Absolute tops keep both
   lines inside the rail at any scale. */
.shop-header-text-px {
	left: 7px;
	right: auto;
	top: 0;
	width: 168px;
	height: 42px;
	margin-top: 0;
	text-align: left;
}
.shop-header-text-px #title {
	position: absolute;
	left: 0;
	top: 9px;
	width: calc(168px * var(--root-scale, 1));
	text-align: left;
}

/* Tax-rate line: sharp like the title (laid out at the physical size and scaled back around its
   top-left corner); at 7px stretched by the panel's scale it was blurry and hard to read. */
.shop-header-text-px #tax_rate {
	position: absolute;
	left: 0;
	top: 27px;
	margin-top: 0;
	width: calc(168px * var(--root-scale, 1));
	font-size: calc(8px * var(--root-scale, 1));
	white-space: nowrap;
	text-align: left;
	color: token(kryon-label);
	transform-origin: left top;
	transform: scale(calc(1 / var(--root-scale, 1)));
}

/* Repair / Repair-all buttons show the Kryon repair icon (handmade/icons, make_icons.py); the
   repair glyph modern uses is missing from the theme's fonts, so it showed an empty box. Both use
   the same icon, as the native buttons shared one sprite. */
#btn_repair .modern-icon-btn-glyph-px,
#btn_repair_all .modern-icon-btn-glyph-px {
	width: 16px;
	height: 16px;
	margin-left: -8px;
	margin-top: -8px;
	font-size: 0;
	color: transparent;
	transform: none;
	decorator: image(icons/repair.tga contain);
}
