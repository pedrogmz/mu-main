<rml>
<head>
	<title>Character Info</title>
	<link type="text/rcss" href="base.rcss"/>
	<link type="text/rcss" href="docked_panel_frame.rcss"/>
	<link type="text/rcss" href="character_info.rcss"/>
</head>
<body>
	<!-- Kryon's own copy of CCharacterInfoWindow's frame, on the ornate window kit (base.rcss,
	     "Kryon ornate window kit"): the claw frame and title band carry the name, the round close
	     button replaces the exit square. Keep ids/data-model/event-callback names in sync with
	     ../../character_info.rml. -->
	<div id="panel" class="kryon-ornate" data-model="character_info" data-class-vitality-two-lines="vit_lines.size > 1">
		<div class="kryon-ornate-frame"></div>
		<div class="kryon-ornate-gem"></div>
		<div class="kryon-ornate-gem-small"></div>
		<div class="kryon-ornate-gem-bottom"></div>

		<span id="name" data-class-pk-0="pk_level == 0" data-class-pk-1="pk_level == 1" data-class-pk-2="pk_level == 2" data-class-pk-3="pk_level == 3" data-class-pk-4="pk_level == 4" data-class-pk-5="pk_level == 5" data-class-pk-6="pk_level >= 6">{{name_text}}</span>
		<span id="classname" data-style-opacity="classname_opacity">{{classname_text}}</span>
		<span id="servername" data-style-opacity="servername_opacity">{{servername_text}}</span>

		<div class="summary-fill"></div>
		<span class="level-text">{{level_text}}</span>
		<span class="levelup-point-text" data-class-hidden="!can_level_up">{{levelup_point_text}}</span>
		<span class="exp-text">{{exp_text}}</span>
		<span class="point-probability-text">{{point_probability_text}}</span>
		<span class="point-text">{{point_text}}</span>

		<!-- STR row -->
		<div class="attr-textbox attr-textbox-str"></div>
		<span class="attr-label attr-label-str">{{str_label}}</span>
		<span class="attr-value attr-value-str" data-class-attr-potion="str_value_source == 'potion'" data-class-attr-boosted="str_value_source == 'boosted'">{{str_value_text}}</span>
		<div class="attr-lines attr-lines-str">
			<span data-for="line : str_lines" data-class-boosted="line.source == 'boosted'" data-class-buffed="line.source == 'buffed'" data-class-hinted="line.hint >= 0" data-event-mouseover="chainfo_line_hover(line.hint)" data-event-mouseout="chainfo_line_leave">{{line.text}}</span>
			<span class="hinted" data-class-boosted="critical_damage_rate_line.source == 'boosted'" data-class-buffed="critical_damage_rate_line.source == 'buffed'" data-event-mouseover="chainfo_line_hover(critical_damage_rate_line.hint)" data-event-mouseout="chainfo_line_leave">{{critical_damage_rate_line.text}}</span>
		</div>
		<div id="btn_stat_str" class="stat-btn stat-btn-str" data-class-hidden="!can_level_up"
		     data-event-click="chainfo_increase_stat(0)">+</div>

		<!-- AGI row -->
		<div class="attr-textbox attr-textbox-agi"></div>
		<span class="attr-label attr-label-agi">{{agi_label}}</span>
		<span class="attr-value attr-value-agi" data-class-attr-potion="agi_value_source == 'potion'" data-class-attr-boosted="agi_value_source == 'boosted'">{{agi_value_text}}</span>
		<div class="attr-lines attr-lines-agi">
			<span data-for="line : agi_lines" data-class-boosted="line.source == 'boosted'" data-class-buffed="line.source == 'buffed'">{{line.text}}</span>
		</div>
		<div id="btn_stat_agi" class="stat-btn stat-btn-agi" data-class-hidden="!can_level_up"
		     data-event-click="chainfo_increase_stat(1)">+</div>

		<!-- VIT row -->
		<div class="attr-textbox attr-textbox-vit"></div>
		<span class="attr-label attr-label-vit">{{vit_label}}</span>
		<span class="attr-value attr-value-vit" data-class-attr-potion="vit_value_source == 'potion'" data-class-attr-boosted="vit_value_source == 'boosted'">{{vit_value_text}}</span>
		<div class="attr-lines attr-lines-vit">
			<span data-for="line : vit_lines" data-class-boosted="line.source == 'boosted'" data-class-buffed="line.source == 'buffed'">{{line.text}}</span>
		</div>
		<div id="btn_stat_vit" class="stat-btn stat-btn-vit" data-class-hidden="!can_level_up"
		     data-event-click="chainfo_increase_stat(2)">+</div>

		<!-- ENE row -->
		<div class="attr-textbox attr-textbox-ene"></div>
		<span class="attr-label attr-label-ene">{{ene_label}}</span>
		<span class="attr-value attr-value-ene" data-class-attr-potion="ene_value_source == 'potion'" data-class-attr-boosted="ene_value_source == 'boosted'">{{ene_value_text}}</span>
		<div class="attr-lines attr-lines-ene">
			<span data-for="line : ene_lines" data-class-boosted="line.source == 'boosted'" data-class-buffed="line.source == 'buffed'">{{line.text}}</span>
		</div>
		<div id="btn_stat_ene" class="stat-btn stat-btn-ene" data-class-hidden="!can_level_up"
		     data-event-click="chainfo_increase_stat(3)">+</div>

		<!-- CMD row -- Dark Lord only. -->
		<div class="attr-textbox attr-textbox-cmd" data-class-hidden="!show_charisma"></div>
		<span class="attr-label attr-label-cmd" data-class-hidden="!show_charisma">{{cmd_label}}</span>
		<span class="attr-value attr-value-cmd" data-class-hidden="!show_charisma" data-class-attr-potion="cmd_value_source == 'potion'" data-class-attr-boosted="cmd_value_source == 'boosted'">{{cmd_value_text}}</span>
		<div id="btn_stat_cmd" class="stat-btn stat-btn-cmd" data-class-hidden="!can_level_up || !show_charisma"
		     data-event-click="chainfo_increase_stat(4)">+</div>

		<!-- Bottom action row: the quest/pet/master-level squares; the exit is the kit's round
		     close button at the top right. -->
		<div id="btn_exit" class="kryon-ornate-close" data-event-click="window_close" data-attr-data-hint="exit_tooltip"></div>
		<div id="btn_quest" class="modern-icon-btn-px chainfo-btn-quest" data-event-click="chainfo_click_quest" data-attr-data-hint="quest_tooltip">
			<span class="modern-icon-btn-glyph-px">Q</span>
		</div>
		<div id="btn_pet" class="modern-icon-btn-px chainfo-btn-pet" data-event-click="chainfo_click_pet" data-attr-data-hint="pet_tooltip">
			<span class="modern-icon-btn-glyph-px">P</span>
		</div>
		<div id="btn_masterlevel" class="modern-icon-btn-px chainfo-btn-masterlevel" data-class-locked="!master_level_enabled"
		     data-event-click="chainfo_click_masterlevel" data-attr-data-hint="masterlevel_tooltip">
			<span class="modern-icon-btn-glyph-px">M</span>
		</div>
		<div id="frame_corner_close" data-event-click="window_close"></div>
	</div>
</body>
</rml>
